// Generated by python -I Tools/contact_response/table.py --emit. Do not edit by hand (ADR-0037 §3.2, 일지 275).
// How a layer of flesh answers a press, tabulated over volume preservation v (9 steps, 0 … 1) and skin tension
// τ = tension length ÷ flesh thickness (9 steps: 0, 1/16 … 8, doubling).
// Short part (solved in the dent window): Ĉ_f(k) = A₁/(1 + (ℓ₁k)²) + γA₁, the two short terms of a 3-term Lorentzian fit
// (worst relative rms 0.093 over 0.3 < kh < 30).
// Long part (the rise around a press): ĝ_long(ρ) = true transfer function − short part, low-passed (s = 0.08h) and
// taken to real space (ρ = r/h ≤ 8, 128 samples, 10 % cosine taper at the end).
// Dimensionless (thickness h = 1, μ = 1): deflection per force = ĝ(r/h)/h, dent window width = (ℓ₁/h)·h.

#pragma once

#define SB_RESPONSE_V_COUNT 9
#define SB_RESPONSE_TAU_COUNT 9
#define SB_RESPONSE_RHO_COUNT 128
#define SB_RESPONSE_RHO_MAX 8.0
#define SB_RESPONSE_CRUSH_STRAIN 0.08       // v = 0에서 셀이 접히기 시작하는 변형률(v 사이는 SB_ResponseCrushInv 곡선)
#define SB_RESPONSE_WINDOW_MAX 2.049379       // 표 전체의 가장 넓은 ℓ₁/h(C++ SoftbodyContactResponse::WindowMax와 같다)

/** 부피 보존 v(0 폼 … 1 살) → 표 v 축 위치. */
float SB_ResponseVIndex(float V)
{
	return saturate(V) * (SB_RESPONSE_V_COUNT - 1);
}

/** τ(겉껍질 장력 길이 ÷ 살 두께) → 표 τ 축 위치(0, 1/16, 1/8, … 8 → 0 … 8, 1/16 밑은 곧게). */
float SB_ResponseTauIndex(float Tau)
{
	float T = clamp(Tau, 0.0, 8.0);
	return T < 0.0625 ? T * 16.0 : 1.0 + log2(T * 16.0);
}

