#. Key:	ESoftbodyCarrierCharts
#. SourceLocation:	/Script/Softbody.ESoftbodyCarrierCharts [Enum ToolTip meta-data]
#: /Script/Softbody.ESoftbodyCarrierCharts [Enum ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyCarrierCharts"
msgid "How the contact map is cut into flat pieces. Dents are slightly less accurate along the seams between pieces."
msgstr "How the contact map is cut into flat pieces. Dents are slightly less accurate along the seams between pieces."

#. Key:	ESoftbodyCarrierCharts.Automatic
#. SourceLocation:	/Script/Softbody.ESoftbodyCarrierCharts:Automatic [EnumEntry ToolTip meta-data]
#: /Script/Softbody.ESoftbodyCarrierCharts:Automatic [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyCarrierCharts.Automatic"
msgid "Cuts the surface automatically by curvature (XAtlas). You cannot choose where the seams go."
msgstr "Cuts the surface automatically by curvature (XAtlas). You cannot choose where the seams go."

#. Key:	ESoftbodyCarrierCharts.MeshUV0
#. SourceLocation:	/Script/Softbody.ESoftbodyCarrierCharts:MeshUV0 [EnumEntry ToolTip meta-data]
#: /Script/Softbody.ESoftbodyCarrierCharts:MeshUV0 [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyCarrierCharts.MeshUV0"
msgid "Cuts the contact map along the mesh's UV0 islands, so seams fall on the UV0 seams. Each island is re-flattened with even cell sizes.\nFalls back to Automatic when UV0 cannot be used (zero area or folded UVs)."
msgstr "Cuts the contact map along the mesh's UV0 islands, so seams fall on the UV0 seams. Each island is re-flattened with even cell sizes.\nFalls back to Automatic when UV0 cannot be used (zero area or folded UVs)."

#. Key:	ESoftbodyCarrierCharts.MeshUV0AsIs
#. SourceLocation:	/Script/Softbody.ESoftbodyCarrierCharts:MeshUV0AsIs [EnumEntry ToolTip meta-data]
#: /Script/Softbody.ESoftbodyCarrierCharts:MeshUV0AsIs [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyCarrierCharts.MeshUV0AsIs"
msgid "Uses the UV0 islands exactly as laid out (only scaled per island), for comparison with Mesh UV0 Islands. Where UV0 is stretched\nor squeezed, cell size and dent rim width change with it."
msgstr "Uses the UV0 islands exactly as laid out (only scaled per island), for comparison with Mesh UV0 Islands. Where UV0 is stretched\nor squeezed, cell size and dent rim width change with it."

#. Key:	ESoftbodyContactDetail
#. SourceLocation:	/Script/Softbody.ESoftbodyContactDetail [Enum ToolTip meta-data]
#: /Script/Softbody.ESoftbodyContactDetail [Enum ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyContactDetail"
msgid "Which contact effects run. Basic drops the effects you only notice up close, to save GPU time on meshes seen from farther away."
msgstr "Which contact effects run. Basic drops the effects you only notice up close, to save GPU time on meshes seen from farther away."

#. Key:	ESoftbodyContactDetail.Basic
#. SourceLocation:	/Script/Softbody.ESoftbodyContactDetail:Basic [EnumEntry ToolTip meta-data]
#: /Script/Softbody.ESoftbodyContactDetail:Basic [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyContactDetail.Basic"
msgid "Dents and lumps pushed aside only. No bulge, no skin drag, no Edge Smoothing and no Flex paint."
msgstr "Dents and lumps pushed aside only. No bulge, no skin drag, no Edge Smoothing and no Flex paint."

#. Key:	ESoftbodyContactDetail.Full
#. SourceLocation:	/Script/Softbody.ESoftbodyContactDetail:Full [EnumEntry ToolTip meta-data]
#: /Script/Softbody.ESoftbodyContactDetail:Full [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyContactDetail.Full"
msgid "Every contact effect: dents, lumps pushed aside and bulges around a press, plus skin dragged by a moving hand and smoothed dent\nedges (Edge Smoothing). On Nanite meshes the dent wall along a moving hand's edge also jitters less."
msgstr "Every contact effect: dents, lumps pushed aside and bulges around a press, plus skin dragged by a moving hand and smoothed dent\nedges (Edge Smoothing). On Nanite meshes the dent wall along a moving hand's edge also jitters less."

#. Key:	ESoftbodyGrabEndReason
#. SourceLocation:	/Script/Softbody.ESoftbodyGrabEndReason [Enum ToolTip meta-data]
#: /Script/Softbody.ESoftbodyGrabEndReason [Enum ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyGrabEndReason"
msgid "Why a Softbody Grabber stopped holding the skin."
msgstr "Why a Softbody Grabber stopped holding the skin."

#. Key:	ESoftbodyGrabEndReason.Missed
#. SourceLocation:	/Script/Softbody.ESoftbodyGrabEndReason:Missed [EnumEntry ToolTip meta-data]
#: /Script/Softbody.ESoftbodyGrabEndReason:Missed [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyGrabEndReason.Missed"
msgid "No skin to hold near the grab point: nothing within 5 cm, flesh painted black in Depth, or a rigid plate."
msgstr "No skin to hold near the grab point: nothing within 5 cm, flesh painted black in Depth, or a rigid plate."

#. Key:	ESoftbodyGrabEndReason.Released
#. SourceLocation:	/Script/Softbody.ESoftbodyGrabEndReason:Released [EnumEntry ToolTip meta-data]
#: /Script/Softbody.ESoftbodyGrabEndReason:Released [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyGrabEndReason.Released"
msgid "Release was called, or the Grabber was destroyed."
msgstr "Release was called, or the Grabber was destroyed."

#. Key:	ESoftbodyGrabEndReason.TargetLost
#. SourceLocation:	/Script/Softbody.ESoftbodyGrabEndReason:TargetLost [EnumEntry ToolTip meta-data]
#: /Script/Softbody.ESoftbodyGrabEndReason:TargetLost [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyGrabEndReason.TargetLost"
msgid "The grabbed Softbody was turned off, lost its contact, or was destroyed."
msgstr "The grabbed Softbody was turned off, lost its contact, or was destroyed."

#. Key:	SoftbodyColliderField
#. SourceLocation:	/Script/Softbody.SoftbodyColliderField [Class ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderField [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderField"
msgid "Shape field: a baked copy of a presser's real shape, stored on the mesh asset (Bake Shape Field).\nA mesh with one presses Softbody surfaces with its real shape, and on a Softbody character it also gives self contact."
msgstr "Shape field: a baked copy of a presser's real shape, stored on the mesh asset (Bake Shape Field).\nA mesh with one presses Softbody surfaces with its real shape, and on a Softbody character it also gives self contact."

#. Key:	SoftbodyColliderField:BakedVoxelSize
#. SourceLocation:	/Script/Softbody.SoftbodyColliderField:BakedVoxelSize [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderField:BakedVoxelSize [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderField:BakedVoxelSize"
msgid "Cell size used for the bake (mesh local units, for display)."
msgstr "Cell size used for the bake (mesh local units, for display)."

#. Key:	SoftbodyColliderField:FindOnAsset
#. SourceLocation:	/Script/Softbody.SoftbodyColliderField:FindOnAsset [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderField:FindOnAsset [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderField:FindOnAsset"
msgid "Returns the usable shape field stored on a static or skeletal mesh asset, or None if it has none or it is out of date."
msgstr "Returns the usable shape field stored on a static or skeletal mesh asset, or None if it has none or it is out of date."

#. Key:	SoftbodyColliderField:MaterialSlots
#. SourceLocation:	/Script/Softbody.SoftbodyColliderField:MaterialSlots [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderField:MaterialSlots [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderField:MaterialSlots"
msgid "The material slots the shape was baked from (Shape Field Slots). Empty = the whole mesh."
msgstr "The material slots the shape was baked from (Shape Field Slots). Empty = the whole mesh."

#. Key:	SoftbodyColliderField:Parts
#. SourceLocation:	/Script/Softbody.SoftbodyColliderField:Parts [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderField:Parts [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderField:Parts"
msgid "The baked parts: one per bone on a skeletal mesh, one for the whole mesh on a static mesh."
msgstr "The baked parts: one per bone on a skeletal mesh, one for the whole mesh on a static mesh."

#. Key:	SoftbodyColliderField:Version
#. SourceLocation:	/Script/Softbody.SoftbodyColliderField:Version [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderField:Version [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderField:Version"
msgid "Format of the bake. A shape field from an older format is not used: bake it again."
msgstr "Format of the bake. A shape field from an older format is not used: bake it again."

#. Key:	SoftbodyColliderField:Voxels
#. SourceLocation:	/Script/Softbody.SoftbodyColliderField:Voxels [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderField:Voxels [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderField:Voxels"
msgid "Baked distance to the surface for every cell of every part (negative inside)."
msgstr "Baked distance to the surface for every cell of every part (negative inside)."

#. Key:	SoftbodyColliderFieldPart
#. SourceLocation:	/Script/Softbody.SoftbodyColliderFieldPart [ScriptStruct ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderFieldPart [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderFieldPart"
msgid "One part of a shape field. On a skeletal mesh there is one part per bone, and it moves rigidly with that bone while playing.\nOn a static mesh the whole mesh is one part."
msgstr "One part of a shape field. On a skeletal mesh there is one part per bone, and it moves rigidly with that bone while playing.\nOn a static mesh the whole mesh is one part."

#. Key:	SoftbodyColliderFieldPart:Bone
#. SourceLocation:	/Script/Softbody.SoftbodyColliderFieldPart:Bone [NameProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderFieldPart:Bone [NameProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderFieldPart:Bone"
msgid "The bone that moves this part. None on a static mesh."
msgstr "The bone that moves this part. None on a static mesh."

#. Key:	SoftbodyColliderFieldPart:bPressesSelf
#. SourceLocation:	/Script/Softbody.SoftbodyColliderFieldPart:bPressesSelf [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderFieldPart:bPressesSelf [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderFieldPart:bPressesSelf"
msgid "Whether this part also presses the character's own flesh (Self Contact Bones). Every part presses other Softbody meshes."
msgstr "Whether this part also presses the character's own flesh (Self Contact Bones). Every part presses other Softbody meshes."

#. Key:	SoftbodyColliderFieldPart:Dims
#. SourceLocation:	/Script/Softbody.SoftbodyColliderFieldPart:Dims [StructProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderFieldPart:Dims [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderFieldPart:Dims"
msgid "Number of grid cells along each axis (at least 2)."
msgstr "Number of grid cells along each axis (at least 2)."

#. Key:	SoftbodyColliderFieldPart:FirstVoxel
#. SourceLocation:	/Script/Softbody.SoftbodyColliderFieldPart:FirstVoxel [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderFieldPart:FirstVoxel [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderFieldPart:FirstVoxel"
msgid "Index of this part's first cell in the shape field's cell list."
msgstr "Index of this part's first cell in the shape field's cell list."

#. Key:	SoftbodyColliderFieldPart:Origin
#. SourceLocation:	/Script/Softbody.SoftbodyColliderFieldPart:Origin [StructProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderFieldPart:Origin [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderFieldPart:Origin"
msgid "Center of the first grid cell (mesh local)."
msgstr "Center of the first grid cell (mesh local)."

#. Key:	SoftbodyColliderFieldPart:VoxelSize
#. SourceLocation:	/Script/Softbody.SoftbodyColliderFieldPart:VoxelSize [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyColliderFieldPart:VoxelSize [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyColliderFieldPart:VoxelSize"
msgid "Size of one grid cell (mesh local units)."
msgstr "Size of one grid cell (mesh local units)."

#. Key:	SoftbodyComponent
#. SourceLocation:	/Script/Softbody.SoftbodyComponent [Class ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent"
msgid "Makes a mesh soft: it dents, bulges and drags where hands and objects press it, and jiggles when it moves.\nAdd one per mesh and set Mesh Data to the Baked Data of that mesh's Softbody Authoring Data."
msgstr "Makes a mesh soft: it dents, bulges and drags where hands and objects press it, and jiggles when it moves.\nAdd one per mesh and set Mesh Data to the Baked Data of that mesh's Softbody Authoring Data."

#. Key:	SoftbodyComponent:AccelerationDtGuard
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:AccelerationDtGuard [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:AccelerationDtGuard [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:AccelerationDtGuard"
msgid "A frame longer than this (seconds) counts as a hitch: its acceleration is ignored so a frame drop does not jolt the flesh. The\nwobble itself stays smooth at any frame rate."
msgstr "A frame longer than this (seconds) counts as a hitch: its acceleration is ignored so a frame drop does not jolt the flesh. The\nwobble itself stays smooth at any frame rate."

#. Key:	SoftbodyComponent:AnimationInertiaWeight
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:AnimationInertiaWeight [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:AnimationInertiaWeight [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:AnimationInertiaWeight"
msgid "How much the skeletal animation moving the bones makes the flesh jiggle (1 = the real acceleration). Raise it for a bigger jiggle\nat the same speed."
msgstr "How much the skeletal animation moving the bones makes the flesh jiggle (1 = the real acceleration). Raise it for a bigger jiggle\nat the same speed."

#. Key:	SoftbodyComponent:bAutoDiscoverPressure
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:bAutoDiscoverPressure [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:bAutoDiscoverPressure [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:bAutoDiscoverPressure"
msgid "Every frame, finds overlapping colliders and lets them press the mesh. Off = outside colliders are ignored (Self Contact still works).\nIt skips the owning actor, anything tagged SoftbodyIgnore and collision with queries disabled."
msgstr "Every frame, finds overlapping colliders and lets them press the mesh. Off = outside colliders are ignored (Self Contact still works).\nIt skips the owning actor, anything tagged SoftbodyIgnore and collision with queries disabled."

#. Key:	SoftbodyComponent:bContactOnlyValidation
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:bContactOnlyValidation [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:bContactOnlyValidation [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:bContactOnlyValidation"
msgid "Debug: turns every jiggle off to look at contact alone. Not meant for shipping."
msgstr "Debug: turns every jiggle off to look at contact alone. Not meant for shipping."

#. Key:	SoftbodyComponent:bDebugVis
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:bDebugVis [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:bDebugVis [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:bDebugVis"
msgid "Shows debug colors (Debug View Mode) instead of the normal shading, on materials that use MF_SoftbodyDebugVis."
msgstr "Shows debug colors (Debug View Mode) instead of the normal shading, on materials that use MF_SoftbodyDebugVis."

#. Key:	SoftbodyComponent:bEnableContact
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:bEnableContact [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:bEnableContact [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:bEnableContact"
msgid "Lets hands and objects dent, bulge and drag the surface. Off = all contact cost goes away and only the jiggle remains.\nLumps are no longer pushed either. Nanite tessellation is a mesh setting and is not affected."
msgstr "Lets hands and objects dent, bulge and drag the surface. Off = all contact cost goes away and only the jiggle remains.\nLumps are no longer pushed either. Nanite tessellation is a mesh setting and is not affected."

#. Key:	SoftbodyComponent:bEnableInertia
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:bEnableInertia [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:bEnableInertia [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:bEnableInertia"
msgid "Jiggle: the flesh lags behind and wobbles back when the body or mesh speeds up, turns, stops or tilts."
msgstr "Jiggle: the flesh lags behind and wobbles back when the body or mesh speeds up, turns, stops or tilts."

#. Key:	SoftbodyComponent:bSelfContact
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:bSelfContact [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:bSelfContact [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:bSelfContact"
msgid "Skeletal meshes only: the character's own hands dent its belly, chest or thighs as an outside hand would.\nNeeds a shape field (Softbody Authoring Data: Bake Shape Field). Only Self Contact Bones such as hand_l and hand_r press the body."
msgstr "Skeletal meshes only: the character's own hands dent its belly, chest or thighs as an outside hand would.\nNeeds a shape field (Softbody Authoring Data: Bake Shape Field). Only Self Contact Bones such as hand_l and hand_r press the body."

#. Key:	SoftbodyComponent:bUseColliderFields
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:bUseColliderFields [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:bUseColliderFields [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:bUseColliderFields"
msgid "Meshes with a baked shape field press with their real shape (between the fingers, into the palm) instead of their simple collision.\nOff = simple collision, for comparison. To bake one, right-click the mesh and pick Softbody: Bake Shape Field."
msgstr "Meshes with a baked shape field press with their real shape (between the fingers, into the palm) instead of their simple collision.\nOff = simple collision, for comparison. To bake one, right-click the mesh and pick Softbody: Bake Shape Field."

#. Key:	SoftbodyComponent:ComponentInertiaWeight
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:ComponentInertiaWeight [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:ComponentInertiaWeight [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:ComponentInertiaWeight"
msgid "How much the actor moving or turning makes the flesh jiggle (1 = the real acceleration). Raise it for a bigger jiggle at the same\nspeed. Tilting under gravity is not scaled."
msgstr "How much the actor moving or turning makes the flesh jiggle (1 = the real acceleration). Raise it for a bigger jiggle at the same\nspeed. Tilting under gravity is not scaled."

#. Key:	SoftbodyComponent:ContactDetail
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:ContactDetail [EnumProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:ContactDetail [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:ContactDetail"
msgid "Which contact effects run. Basic runs only dents and pushed lumps to save GPU time on meshes not seen up close.\nFull adds bulges, skin drag (with a pressing hand's Lump Grip), Edge Smoothing and Flex paint."
msgstr "Which contact effects run. Basic runs only dents and pushed lumps to save GPU time on meshes not seen up close.\nFull adds bulges, skin drag (with a pressing hand's Lump Grip), Edge Smoothing and Flex paint."

#. Key:	SoftbodyComponent:ContactTexture
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:ContactTexture [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:ContactTexture [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:ContactTexture"
msgid "관성 브릿지 (BridgeWidth×BridgeRows PF_FloatRGBA) — 배치는 BridgeWidth 주석 참조"
msgstr "관성 브릿지 (BridgeWidth×BridgeRows PF_FloatRGBA) — 배치는 BridgeWidth 주석 참조"

#. Key:	SoftbodyComponent:DebugVisMode
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:DebugVisMode [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:DebugVisMode [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:DebugVisMode"
msgid "What the debug colors show, with the same colors as the Last Bake views in the Softbody Authoring Data Preview.\n0 = Flesh Fit. 1 = Core Connection. 2 = Contact Map Seams. 3 = Distance to Outer Surface. 4 = Jiggle Size. 5 = Dents Between Vertices."
msgstr "What the debug colors show, with the same colors as the Last Bake views in the Softbody Authoring Data Preview.\n0 = Flesh Fit. 1 = Core Connection. 2 = Contact Map Seams. 3 = Distance to Outer Surface. 4 = Jiggle Size. 5 = Dents Between Vertices."

#. Key:	SoftbodyComponent:FlexOffset
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:FlexOffset [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:FlexOffset [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:FlexOffset"
msgid "For trying while playing how stiff the skin painted in Flex is. Not finished yet and can be unstable, so use it with care.\nAdds to the Flex paint: -1 turns painted pieces into rigid plates, +1 makes everything bare skin. Needs Contact Detail Full."
msgstr "For trying while playing how stiff the skin painted in Flex is. Not finished yet and can be unstable, so use it with care.\nAdds to the Flex paint: -1 turns painted pieces into rigid plates, +1 makes everything bare skin. Needs Contact Detail Full."

#. Key:	SoftbodyComponent:GetInertiaGroupBoneNames
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:GetInertiaGroupBoneNames [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:GetInertiaGroupBoneNames [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:GetInertiaGroupBoneNames"
msgid "InertiaGroupOverrides 키 드롭다운 = 베이크의 관성 그룹 본 이름."
msgstr "InertiaGroupOverrides 키 드롭다운 = 베이크의 관성 그룹 본 이름."

#. Key:	SoftbodyComponent:InertiaAmount
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:InertiaAmount [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:InertiaAmount [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:InertiaAmount"
msgid "How soft the flesh is: how far thick flesh painted white in Jiggle sags under 1 g, in cm. Firmer and thinner parts move less.\nEach part wobbles at the speed of its own sag: the more it sags, the slower it wobbles."
msgstr "How soft the flesh is: how far thick flesh painted white in Jiggle sags under 1 g, in cm. Firmer and thinner parts move less.\nEach part wobbles at the speed of its own sag: the more it sags, the slower it wobbles."

#. Key:	SoftbodyComponent:InertiaDamping
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:InertiaDamping [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:InertiaDamping [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:InertiaDamping"
msgid "For how springy the flesh is: how many times a wobble swings past before it stops. 0.25 to 0.4 gives one or two bounces: 0.25\nabout two and 0.4 about one. Near 0.1 it keeps swinging about seven times. It does not change the wobble speed."
msgstr "For how springy the flesh is: how many times a wobble swings past before it stops. 0.25 to 0.4 gives one or two bounces: 0.25\nabout two and 0.4 about one. Near 0.1 it keeps swinging about seven times. It does not change the wobble speed."

#. Key:	SoftbodyComponent:InertiaDirectionScale
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:InertiaDirectionScale [StructProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:InertiaDirectionScale [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:InertiaDirectionScale"
msgid "Scales the jiggle along each axis of the mesh as modeled (Z is up), for example more bounce up and down when landing and less\nsideways sway when turning. Turning motion is not scaled."
msgstr "Scales the jiggle along each axis of the mesh as modeled (Z is up), for example more bounce up and down when landing and less\nsideways sway when turning. Turning motion is not scaled."

#. Key:	SoftbodyComponent:InertiaGravityScale
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:InertiaGravityScale [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:InertiaGravityScale [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:InertiaGravityScale"
msgid "How strongly gravity pulls lumps and static meshes (1 = real gravity, 0 = off). At 1 they sag only when leaning or lying down.\nAbove 1 they also hang lower while upright. Parts on the skeleton sag only with a Gravity Scale in Inertia Group Overrides."
msgstr "How strongly gravity pulls lumps and static meshes (1 = real gravity, 0 = off). At 1 they sag only when leaning or lying down.\nAbove 1 they also hang lower while upright. Parts on the skeleton sag only with a Gravity Scale in Inertia Group Overrides."

#. Key:	SoftbodyComponent:InertiaGroupOverrides
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:InertiaGroupOverrides [MapProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:InertiaGroupOverrides [MapProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:InertiaGroupOverrides"
msgid "Different jiggle per body part: amount, damping and gravity for one inertia group (a bone). Pick the bone from the dropdown, which\nlists the inertia groups found by the bake. Parts not listed, and settings not ticked, use the values above."
msgstr "Different jiggle per body part: amount, damping and gravity for one inertia group (a bone). Pick the bone from the dropdown, which\nlists the inertia groups found by the bake. Parts not listed, and settings not ticked, use the values above."

#. Key:	SoftbodyComponent:InertiaMaxOffset
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:InertiaMaxOffset [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:InertiaMaxOffset [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:InertiaMaxOffset"
msgid "Safety limit for how far jiggle can move a vertex, in cm, for each inertia group (the whole mesh for a static mesh).\nMovement is unchanged up to 70% of it, then eases in, so reaching it flattens the peak without a pop."
msgstr "Safety limit for how far jiggle can move a vertex, in cm, for each inertia group (the whole mesh for a static mesh).\nMovement is unchanged up to 70% of it, then eases in, so reaching it flattens the peak without a pop."

#. Key:	SoftbodyComponent:InertiaSaturation
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:InertiaSaturation [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:InertiaSaturation [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:InertiaSaturation"
msgid "For flesh that firms up in big movements, such as a body that runs and stops. 0 = off (the wobble grows with the motion).\nAt 1 a push as strong as gravity halves the wobble, and it never exceeds Inertia Amount divided by this value (cm)."
msgstr "For flesh that firms up in big movements, such as a body that runs and stops. 0 = off (the wobble grows with the motion).\nAt 1 a push as strong as gravity halves the wobble, and it never exceeds Inertia Amount divided by this value (cm)."

#. Key:	SoftbodyComponent:JiggleSpeed
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:JiggleSpeed [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:JiggleSpeed [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:JiggleSpeed"
msgid "Changes the rhythm of the jiggle without changing its size: 2 wobbles twice as fast and settles in half the time.\nThe bounce after a landing and the sag when the body tilts stay the same."
msgstr "Changes the rhythm of the jiggle without changing its size: 2 wobbles twice as fast and settles in half the time.\nThe bounce after a landing and the sag when the body tilts stay the same."

#. Key:	SoftbodyComponent:LumpGrip
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:LumpGrip [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:LumpGrip [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:LumpGrip"
msgid "How firmly holding a lump's skin carries the whole lump: 1 = as firmly as the flesh resists pressing, 0 = only the skin stretches.\nA pressing hand pulls it only with Contact Detail Full and Drag Friction above 0. Needs Lump Yield above 0 and Enable Inertia."
msgstr "How firmly holding a lump's skin carries the whole lump: 1 = as firmly as the flesh resists pressing, 0 = only the skin stretches.\nA pressing hand pulls it only with Contact Detail Full and Drag Friction above 0. Needs Lump Yield above 0 and Enable Inertia."

#. Key:	SoftbodyComponent:LumpStiffen
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:LumpStiffen [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:LumpStiffen [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:LumpStiffen"
msgid "How much harder the flesh pushes back when squeezed deep, like real flesh firming up near the bone. 0 = in proportion to depth.\nShallow presses are hardly affected. It acts only on pushed lumps and on skin drag (Contact Detail Full, Drag Friction above 0)."
msgstr "How much harder the flesh pushes back when squeezed deep, like real flesh firming up near the bone. 0 = in proportion to depth.\nShallow presses are hardly affected. It acts only on pushed lumps and on skin drag (Contact Detail Full, Drag Friction above 0)."

#. Key:	SoftbodyComponent:LumpYield
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:LumpYield [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:LumpYield [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:LumpYield"
msgid "How far pressing a lump (flesh skinned to a Lump bone, such as a breast) moves the whole lump aside, not only the dent.\n0 = dent only, 1 = as far as the baked flesh allows. Needs Enable Contact, Enable Inertia and Inertia Amount above 0."
msgstr "How far pressing a lump (flesh skinned to a Lump bone, such as a breast) moves the whole lump aside, not only the dent.\n0 = dent only, 1 = as far as the baked flesh allows. Needs Enable Contact, Enable Inertia and Inertia Amount above 0."

#. Key:	SoftbodyComponent:MaxContactDepth
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:MaxContactDepth [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:MaxContactDepth [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:MaxContactDepth"
msgid "How deep a collider can push the surface, in cm. Pushes up to this depth are exact, and deeper ones ease out and stop at 1.3 times it.\nFor collision that sits inside the visible surface, such as a body capsule under the skin, set it to that gap."
msgstr "How deep a collider can push the surface, in cm. Pushes up to this depth are exact, and deeper ones ease out and stop at 1.3 times it.\nFor collision that sits inside the visible surface, such as a body capsule under the skin, set it to that gap."

#. Key:	SoftbodyComponent:MaxDisplacement
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:MaxDisplacement [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:MaxDisplacement [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:MaxDisplacement"
msgid "The farthest any vertex may move from where it was modeled, in cm, with dents and jiggle added together.\nMovement is unchanged up to 70% of this limit, then eases into it."
msgstr "The farthest any vertex may move from where it was modeled, in cm, with dents and jiggle added together.\nMovement is unchanged up to 70% of this limit, then eases into it."

#. Key:	SoftbodyComponent:MeshData
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:MeshData [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:MeshData [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:MeshData"
msgid "The baked data for the target mesh: the Baked Data of its Softbody Authoring Data asset."
msgstr "The baked data for the target mesh: the Baked Data of its Softbody Authoring Data asset."

#. Key:	SoftbodyComponent:OnSoftbodyUpdated
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:OnSoftbodyUpdated [MulticastInlineDelegateProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:OnSoftbodyUpdated [MulticastInlineDelegateProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:OnSoftbodyUpdated"
msgid "Called once per frame after the dents and jiggle have been updated and sent to the material."
msgstr "Called once per frame after the dents and jiggle have been updated and sent to the material."

#. Key:	SoftbodyComponent:PressureChannel
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:PressureChannel [ByteProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:PressureChannel [ByteProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:PressureChannel"
msgid "The collision channel used to find colliders. Anything whose collision blocks this channel presses the flesh."
msgstr "The collision channel used to find colliders. Anything whose collision blocks this channel presses the flesh."

#. Key:	SoftbodyComponent:PreviousContactTexture
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:PreviousContactTexture [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:PreviousContactTexture [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:PreviousContactTexture"
msgid "지난 프레임의 관성 브릿지(모션 벡터용). 머티리얼이 지난 프레임 흔들림 변위를 구해 속도 버퍼에 쓴다 — 없으면\n흔들리는 살이 속도 0으로 잡혀 TSR 잔상이 남는다."
msgstr "지난 프레임의 관성 브릿지(모션 벡터용). 머티리얼이 지난 프레임 흔들림 변위를 구해 속도 버퍼에 쓴다 — 없으면\n흔들리는 살이 속도 0으로 잡혀 TSR 잔상이 남는다."

#. Key:	SoftbodyComponent:SkinTension
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:SkinTension [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:SkinTension [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:SkinTension"
msgid "Strength of a tight skin over the flesh, such as leather. 0 = bare flesh or jelly.\nA tighter skin makes dents rounder and wider and blurs what presses. It covers the whole mesh; Flex paint is for part of it."
msgstr "Strength of a tight skin over the flesh, such as leather. 0 = bare flesh or jelly.\nA tighter skin makes dents rounder and wider and blurs what presses. It covers the whole mesh; Flex paint is for part of it."

#. Key:	SoftbodyComponent:SurfaceDragRatio
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:SurfaceDragRatio [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:SurfaceDragRatio [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:SurfaceDragRatio"
msgid "Friction between a moving collider and the skin, as a multiple of how hard it presses. 0 = off. Needs Contact Detail Full.\nThe skin moves with the collider until the flesh pulls back harder, then slips. It also limits how hard a pressing hand pulls a lump."
msgstr "Friction between a moving collider and the skin, as a multiple of how hard it presses. 0 = off. Needs Contact Detail Full.\nThe skin moves with the collider until the flesh pulls back harder, then slips. It also limits how hard a pressing hand pulls a lump."

#. Key:	SoftbodyComponent:SurfaceEdgeTrim
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:SurfaceEdgeTrim [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:SurfaceEdgeTrim [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:SurfaceEdgeTrim"
msgid "Smooths the steep dent wall along a collider's edge, in contact map cells. Flat and light presses keep their full depth.\nObjects thinner than twice this width press less deeply. 0 = off. Needs Contact Detail Full."
msgstr "Smooths the steep dent wall along a collider's edge, in contact map cells. Flat and light presses keep their full depth.\nObjects thinner than twice this width press less deeply. 0 = off. Needs Contact Detail Full."

#. Key:	SoftbodyComponent:SurfaceField
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:SurfaceField [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:SurfaceField [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:SurfaceField"
msgid "표면 장(v5) GPU 상태. 캐리어가 있을 때만 존재한다."
msgstr "표면 장(v5) GPU 상태. 캐리어가 있을 때만 존재한다."

#. Key:	SoftbodyComponent:SurfaceMemoryFadeTime
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:SurfaceMemoryFadeTime [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:SurfaceMemoryFadeTime [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:SurfaceMemoryFadeTime"
msgid "How quickly lasting marks fade: a mark halves every this many seconds, even while the flesh is still pressed.\nSo when it is shorter than Memory Time, a long press leaves only a shallow mark."
msgstr "How quickly lasting marks fade: a mark halves every this many seconds, even while the flesh is still pressed.\nSo when it is shorter than Memory Time, a long press leaves only a shallow mark."

#. Key:	SoftbodyComponent:SurfaceMemoryTime
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:SurfaceMemoryTime [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:SurfaceMemoryTime [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:SurfaceMemoryTime"
msgid "Lets flesh pressed for a long time keep a mark, like memory foam. 0 = no marks.\nWhile pressed, the flesh closes half its gap to the pressed shape every this many seconds. Marks fade by Memory Fade Time."
msgstr "Lets flesh pressed for a long time keep a mark, like memory foam. 0 = no marks.\nWhile pressed, the flesh closes half its gap to the pressed shape every this many seconds. Marks fade by Memory Fade Time."

#. Key:	SoftbodyComponent:SurfaceMinScreenSize
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:SurfaceMinScreenSize [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:SurfaceMinScreenSize [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:SurfaceMinScreenSize"
msgid "Saves GPU time on meshes seen from far away: dents stop while the whole mesh looks smaller than this (LOD Screen Size).\nThe dents ease back as if released, then GPU work stops until it looks larger again. 0 = never stop by size. Jiggle is not affected."
msgstr "Saves GPU time on meshes seen from far away: dents stop while the whole mesh looks smaller than this (LOD Screen Size).\nThe dents ease back as if released, then GPU work stops until it looks larger again. 0 = never stop by size. Jiggle is not affected."

#. Key:	SoftbodyComponent:SurfaceOcclusionStrength
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:SurfaceOcclusionStrength [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:SurfaceOcclusionStrength [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:SurfaceOcclusionStrength"
msgid "How dark deep, narrow dents get (0 to 1), such as fingertip marks and the gaps between fingers.\nNeeds a material that multiplies its base color by the Occlusion output of MF_SoftbodyContactNormal (the example material does)."
msgstr "How dark deep, narrow dents get (0 to 1), such as fingertip marks and the gaps between fingers.\nNeeds a material that multiplies its base color by the Occlusion output of MF_SoftbodyContactNormal (the example material does)."

#. Key:	SoftbodyComponent:SurfaceRecoveryRate
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:SurfaceRecoveryRate [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:SurfaceRecoveryRate [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:SurfaceRecoveryRate"
msgid "How quickly a dent and dragged skin spring back after the collider leaves (per second), the same for every dent size.\nLower values fill in slowly, so a fast hand leaves a trail. It does not change how wide the dent is."
msgstr "How quickly a dent and dragged skin spring back after the collider leaves (per second), the same for every dent size.\nLower values fill in slowly, so a fast hand leaves a trail. It does not change how wide the dent is."

#. Key:	SoftbodyComponent:TargetMeshComponent
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:TargetMeshComponent [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:TargetMeshComponent [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:TargetMeshComponent"
msgid "The mesh this component deforms. Empty = the mesh on this actor that Mesh Data was baked from."
msgstr "The mesh this component deforms. Empty = the mesh on this actor that Mesh Data was baked from."

#. Key:	SoftbodyComponent:TeleportDistance
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:TeleportDistance [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:TeleportDistance [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:TeleportDistance"
msgid "A move this much farther (cm) than the current speed allows in one frame counts as a teleport and does not jiggle the flesh.\nThis covers SetActorLocation without the teleport flag, respawns and animation cuts. 0 = only moves flagged as teleports count."
msgstr "A move this much farther (cm) than the current speed allows in one frame counts as a teleport and does not jiggle the flesh.\nThis covers SetActorLocation without the teleport flag, respawns and animation cuts. 0 = only moves flagged as teleports count."

#. Key:	SoftbodyComponent:ValidateSetup
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:ValidateSetup [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:ValidateSetup [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:ValidateSetup"
msgid "Checks the setup and writes any problem to the Output Log (LogSoftbodyRuntime). Returns true when nothing needs fixing.\nIt checks Mesh Data, the Softbody material functions and the jiggle data, and names settings that do nothing on this mesh."
msgstr "Checks the setup and writes any problem to the Output Log (LogSoftbodyRuntime). Returns true when nothing needs fixing.\nIt checks Mesh Data, the Softbody material functions and the jiggle data, and names settings that do nothing on this mesh."

#. Key:	SoftbodyComponent:ValidateSetupButton
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:ValidateSetupButton [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:ValidateSetupButton [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:ValidateSetupButton"
msgid "Checks the setup and writes any problem to the Output Log (category LogSoftbodyRuntime): the target mesh matches Mesh Data, the\nmesh's materials contain the Softbody material functions, and the bake has jiggle data. It also names settings that do nothing on this mesh."
msgstr "Checks the setup and writes any problem to the Output Log (category LogSoftbodyRuntime): the target mesh matches Mesh Data, the\nmesh's materials contain the Softbody material functions, and the bake has jiggle data. It also names settings that do nothing on this mesh."

#. Key:	SoftbodyComponent:VolumeOffset
#. SourceLocation:	/Script/Softbody.SoftbodyComponent:VolumeOffset [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyComponent:VolumeOffset [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyComponent:VolumeOffset"
msgid "For trying while playing how much flesh rises around a dent. It adds to the Volume of every area: -1 = all foam, +1 = all flesh.\nA whole pushed lump still spreads by the baked value."
msgstr "For trying while playing how much flesh rises around a dent. It adds to the Volume of every area: -1 = all foam, +1 = all flesh.\nA whole pushed lump still spreads by the baked value."

#. Key:	SoftbodyContactMapEntry
#. SourceLocation:	/Script/Softbody.SoftbodyContactMapEntry [ScriptStruct ToolTip meta-data]
#: /Script/Softbody.SoftbodyContactMapEntry [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyContactMapEntry"
msgid "월드 묶음이 쥔 접촉 지도 하나(Mesh Data 하나의 캐리어·거리표 텍스처, 일지 222·235). 쓰는 표면 장이 있는 동안과, 마지막 장이 놓은 뒤\nsoftbody.Surface.ReleaseDelay초 동안 쥔다 — 그 안에 다시 켜면 다시 읽지 않는다."
msgstr "월드 묶음이 쥔 접촉 지도 하나(Mesh Data 하나의 캐리어·거리표 텍스처, 일지 222·235). 쓰는 표면 장이 있는 동안과, 마지막 장이 놓은 뒤\nsoftbody.Surface.ReleaseDelay초 동안 쥔다 — 그 안에 다시 켜면 다시 읽지 않는다."

#. Key:	SoftbodyContactMapEntry:Loaded
#. SourceLocation:	/Script/Softbody.SoftbodyContactMapEntry:Loaded [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyContactMapEntry:Loaded [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyContactMapEntry:Loaded"
msgid "다 올라온 텍스처(경로 순서와 상관없이 올라온 것부터)."
msgstr "다 올라온 텍스처(경로 순서와 상관없이 올라온 것부터)."

#. Key:	SoftbodyGrabberComponent
#. SourceLocation:	/Script/Softbody.SoftbodyGrabberComponent [Class ToolTip meta-data]
#: /Script/Softbody.SoftbodyGrabberComponent [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyGrabberComponent"
msgid "Holds a patch of skin on a Softbody mesh and pulls it while this component moves, like pinching a cheek. One Grabber holds one patch.\nThe patch follows up to its limit (Get Stretch) and a lump under it moves by Lump Grip. Released, the skin returns at Recovery Rate."
msgstr "Holds a patch of skin on a Softbody mesh and pulls it while this component moves, like pinching a cheek. One Grabber holds one patch.\nThe patch follows up to its limit (Get Stretch) and a lump under it moves by Lump Grip. Released, the skin returns at Recovery Rate."

#. Key:	SoftbodyGrabberComponent:GetGrabbedSoftbody
#. SourceLocation:	/Script/Softbody.SoftbodyGrabberComponent:GetGrabbedSoftbody [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyGrabberComponent:GetGrabbedSoftbody [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyGrabberComponent:GetGrabbedSoftbody"
msgid "The Softbody being held, or none."
msgstr "The Softbody being held, or none."

#. Key:	SoftbodyGrabberComponent:GetStretch
#. SourceLocation:	/Script/Softbody.SoftbodyGrabberComponent:GetStretch [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyGrabberComponent:GetStretch [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyGrabberComponent:GetStretch"
msgid "How far the held patch has moved since the grab and the most it moves at this spot, in cm (a lump under it counts in both).\nThe patch stays at the most, so a hand that goes farther leaves a gap. False until the skin is found; values are 1 to 3 frames late."
msgstr "How far the held patch has moved since the grab and the most it moves at this spot, in cm (a lump under it counts in both).\nThe patch stays at the most, so a hand that goes farther leaves a gap. False until the skin is found; values are 1 to 3 frames late."

#. Key:	SoftbodyGrabberComponent:GrabAtHit
#. SourceLocation:	/Script/Softbody.SoftbodyGrabberComponent:GrabAtHit [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyGrabberComponent:GrabAtHit [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyGrabberComponent:GrabAtHit"
msgid "Grabs the skin where a trace hit (Impact Point), on the side the trace came from. Uses the Softbody of the hit mesh, or the\nnearest one. Same results as Grab At Location."
msgstr "Grabs the skin where a trace hit (Impact Point), on the side the trace came from. Uses the Softbody of the hit mesh, or the\nnearest one. Same results as Grab At Location."

#. Key:	SoftbodyGrabberComponent:GrabAtLocation
#. SourceLocation:	/Script/Softbody.SoftbodyGrabberComponent:GrabAtLocation [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyGrabberComponent:GrabAtLocation [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyGrabberComponent:GrabAtLocation"
msgid "Grabs the skin nearest to Location (world) until Release, on Target or else the nearest Softbody. It releases an earlier grab first.\nFalse if no Softbody is near, contact is off or not ready, or 4 grabs are held. On Grab Ended reports Missed if no skin is within 5 cm."
msgstr "Grabs the skin nearest to Location (world) until Release, on Target or else the nearest Softbody. It releases an earlier grab first.\nFalse if no Softbody is near, contact is off or not ready, or 4 grabs are held. On Grab Ended reports Missed if no skin is within 5 cm."

#. Key:	SoftbodyGrabberComponent:GrabRadius
#. SourceLocation:	/Script/Softbody.SoftbodyGrabberComponent:GrabRadius [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyGrabberComponent:GrabRadius [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyGrabberComponent:GrabRadius"
msgid "Radius of the held patch, in world cm. A wider patch makes a wider, rounder pull.\nThe patch moves at most 1.3 times the smaller of this radius and the flesh thickness, and so does a lump under it."
msgstr "Radius of the held patch, in world cm. A wider patch makes a wider, rounder pull.\nThe patch moves at most 1.3 times the smaller of this radius and the flesh thickness, and so does a lump under it."

#. Key:	SoftbodyGrabberComponent:IsGrabbing
#. SourceLocation:	/Script/Softbody.SoftbodyGrabberComponent:IsGrabbing [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyGrabberComponent:IsGrabbing [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyGrabberComponent:IsGrabbing"
msgid "True from a successful grab until it ends (Release, Missed or TargetLost)."
msgstr "True from a successful grab until it ends (Release, Missed or TargetLost)."

#. Key:	SoftbodyGrabberComponent:OnGrabEnded
#. SourceLocation:	/Script/Softbody.SoftbodyGrabberComponent:OnGrabEnded [MulticastInlineDelegateProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyGrabberComponent:OnGrabEnded [MulticastInlineDelegateProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyGrabberComponent:OnGrabEnded"
msgid "Called when this Grabber stops holding: Released, Missed (no skin to hold near the grab point) or TargetLost (the Softbody was\nturned off or destroyed). Missed arrives 1 to 3 frames after the grab."
msgstr "Called when this Grabber stops holding: Released, Missed (no skin to hold near the grab point) or TargetLost (the Softbody was\nturned off or destroyed). Missed arrives 1 to 3 frames after the grab."

#. Key:	SoftbodyGrabberComponent:Release
#. SourceLocation:	/Script/Softbody.SoftbodyGrabberComponent:Release [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyGrabberComponent:Release [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyGrabberComponent:Release"
msgid "Lets go. The pulled skin returns at the mesh's Recovery Rate and a lump wobbles back. On Grab Ended reports Released."
msgstr "Lets go. The pulled skin returns at the mesh's Recovery Rate and a lump wobbles back. On Grab Ended reports Released."

#. Key:	SoftbodyHardPiece
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece [ScriptStruct ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece"
msgid "One area painted below white in Flex. Black ones move as rigid plates and gray ones bend with the skin. Filled by the contact map bake."
msgstr "One area painted below white in Flex. Black ones move as rigid plates and gray ones bend with the skin. Filled by the contact map bake."

#. Key:	SoftbodyHardPiece:AxisU
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:AxisU [StructProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:AxisU [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:AxisU"
msgid "First in-plane axis of the piece."
msgstr "First in-plane axis of the piece."

#. Key:	SoftbodyHardPiece:AxisV
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:AxisV [StructProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:AxisV [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:AxisV"
msgid "Second in-plane axis of the piece."
msgstr "Second in-plane axis of the piece."

#. Key:	SoftbodyHardPiece:bFloating
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:bFloating [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:bFloating [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:bFloating"
msgid "True for a piece sitting on another surface (a gem on clothing); false for a piece that is part of the surface (a die pip)."
msgstr "True for a piece sitting on another surface (a gem on clothing); false for a piece that is part of the surface (a die pip)."

#. Key:	SoftbodyHardPiece:Center
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:Center [StructProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:Center [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:Center"
msgid "Center of the surface the piece rests on (mesh local, reference pose)."
msgstr "Center of the surface the piece rests on (mesh local, reference pose)."

#. Key:	SoftbodyHardPiece:FirstCell
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:FirstCell [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:FirstCell [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:FirstCell"
msgid "Start of this plate's cells in the baked plate tables (count in Num Cells)."
msgstr "Start of this plate's cells in the baked plate tables (count in Num Cells)."

#. Key:	SoftbodyHardPiece:FirstMode
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:FirstMode [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:FirstMode [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:FirstMode"
msgid "Start of this plate's bending shapes in the baked plate tables (count in Num Modes)."
msgstr "Start of this plate's bending shapes in the baked plate tables (count in Num Modes)."

#. Key:	SoftbodyHardPiece:FirstNode
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:FirstNode [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:FirstNode [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:FirstNode"
msgid "Start of this plate's points in the baked plate tables (count in Num Nodes)."
msgstr "Start of this plate's points in the baked plate tables (count in Num Nodes)."

#. Key:	SoftbodyHardPiece:FirstTile
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:FirstTile [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:FirstTile [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:FirstTile"
msgid "Start of this plate's contact map tiles in the baked plate tables (count in Num Tiles)."
msgstr "Start of this plate's contact map tiles in the baked plate tables (count in Num Tiles)."

#. Key:	SoftbodyHardPiece:Freedom
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:Freedom [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:Freedom [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:Freedom"
msgid "How the piece can move: 1 = sinks only, 2 = sinks and tilts about one axis, 3 = sinks and tilts freely."
msgstr "How the piece can move: 1 = sinks only, 2 = sinks and tilts about one axis, 3 = sinks and tilts freely."

#. Key:	SoftbodyHardPiece:MaxSoftness
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:MaxSoftness [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:MaxSoftness [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:MaxSoftness"
msgid "The piece's largest Flex paint, read away from its rim. The piece moves as one rigid plate when this paint is stiff enough for the piece's size (always at black)."
msgstr "The piece's largest Flex paint, read away from its rim. The piece moves as one rigid plate when this paint is stiff enough for the piece's size (always at black)."

#. Key:	SoftbodyHardPiece:NodeBoxMin
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:NodeBoxMin [StructProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:NodeBoxMin [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:NodeBoxMin"
msgid "Corner of the box around this plate's points in the baked plate tables (size in Node Box Size)."
msgstr "Corner of the box around this plate's points in the baked plate tables (size in Node Box Size)."

#. Key:	SoftbodyHardPiece:Radius
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:Radius [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:Radius [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:Radius"
msgid "Distance from the center to the farthest cell under the piece (mesh local)."
msgstr "Distance from the center to the farthest cell under the piece (mesh local)."

#. Key:	SoftbodyHardPiece:Softness
#. SourceLocation:	/Script/Softbody.SoftbodyHardPiece:Softness [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyHardPiece:Softness [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHardPiece:Softness"
msgid "The plate's Flex paint (the median over its cells). Flex Offset on the Softbody component shifts it while playing."
msgstr "The plate's Flex paint (the median over its cells). Flex Offset on the Softbody component shifts it while playing."

#. Key:	SoftbodyHitchTestSubsystem
#. SourceLocation:	/Script/Softbody.SoftbodyHitchTestSubsystem [Class ToolTip meta-data]
#: /Script/Softbody.SoftbodyHitchTestSubsystem [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyHitchTestSubsystem"
msgid "Testing tool: Softbody.HitchTest switches the level's Softbody components on and off and spawns copies while recording frame times.\nResults go to the log and Saved/Profiling/SoftbodyHitch. Use it only for testing. Exists only in game and PIE worlds."
msgstr "Testing tool: Softbody.HitchTest switches the level's Softbody components on and off and spawns copies while recording frame times.\nResults go to the log and Saved/Profiling/SoftbodyHitch. Use it only for testing. Exists only in game and PIE worlds."

#. Key:	SoftbodyInertiaGroupOverride
#. SourceLocation:	/Script/Softbody.SoftbodyInertiaGroupOverride [ScriptStruct ToolTip meta-data]
#: /Script/Softbody.SoftbodyInertiaGroupOverride [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyInertiaGroupOverride"
msgid "Jiggle settings for one body part (inertia group), for example a slow chest and a quick belly on the same character. Settings\nthat are not ticked use the component's values."
msgstr "Jiggle settings for one body part (inertia group), for example a slow chest and a quick belly on the same character. Settings\nthat are not ticked use the component's values."

#. Key:	SoftbodyInertiaGroupOverride:AmountScale
#. SourceLocation:	/Script/Softbody.SoftbodyInertiaGroupOverride:AmountScale [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyInertiaGroupOverride:AmountScale [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyInertiaGroupOverride:AmountScale"
msgid "Multiplies Inertia Amount for this part. It also changes the wobble speed: a part that moves more wobbles more slowly. 0 = this part does not jiggle."
msgstr "Multiplies Inertia Amount for this part. It also changes the wobble speed: a part that moves more wobbles more slowly. 0 = this part does not jiggle."

#. Key:	SoftbodyInertiaGroupOverride:Damping
#. SourceLocation:	/Script/Softbody.SoftbodyInertiaGroupOverride:Damping [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyInertiaGroupOverride:Damping [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyInertiaGroupOverride:Damping"
msgid "For how springy this part is: how many times its wobble swings past before it stops. 0.25 to 0.4 gives one or two bounces.\nNear 0.1 it keeps swinging about seven times."
msgstr "For how springy this part is: how many times its wobble swings past before it stops. 0.25 to 0.4 gives one or two bounces.\nNear 0.1 it keeps swinging about seven times."

#. Key:	SoftbodyInertiaGroupOverride:GravityScale
#. SourceLocation:	/Script/Softbody.SoftbodyInertiaGroupOverride:GravityScale [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyInertiaGroupOverride:GravityScale [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyInertiaGroupOverride:GravityScale"
msgid "How strongly gravity pulls this part (1 = real gravity, 0 = none). Above 1 it also hangs lower while upright. Replaces Gravity\nScale for this part. Parts on the skeleton such as the torso sag only when they are given a value here."
msgstr "How strongly gravity pulls this part (1 = real gravity, 0 = none). Above 1 it also hangs lower while upright. Replaces Gravity\nScale for this part. Parts on the skeleton such as the torso sag only when they are given a value here."

#. Key:	SoftbodyInertiaLump
#. SourceLocation:	/Script/Softbody.SoftbodyInertiaLump [ScriptStruct ToolTip meta-data]
#: /Script/Softbody.SoftbodyInertiaLump [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyInertiaLump"
msgid "One lump: flesh hanging from a Lump bone (not part of the rigid core), such as a breast.\nWhen pressed, it moves aside as one piece along with the dent."
msgstr "One lump: flesh hanging from a Lump bone (not part of the rigid core), such as a breast.\nWhen pressed, it moves aside as one piece along with the dent."

#. Key:	SoftbodyInertiaLump:Group
#. SourceLocation:	/Script/Softbody.SoftbodyInertiaLump:Group [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyInertiaLump:Group [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyInertiaLump:Group"
msgid "Inertia group of this lump (the group of its Lump bone)."
msgstr "Inertia group of this lump (the group of its Lump bone)."

#. Key:	SoftbodyInertiaLump:MeanShapeX
#. SourceLocation:	/Script/Softbody.SoftbodyInertiaLump:MeanShapeX [StructProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyInertiaLump:MeanShapeX [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyInertiaLump:MeanShapeX"
msgid "Average direction and amount the lump's flesh moves when the flesh is pulled along +X (softest point = 1, reference pose\naxes). Y and Z below are the same for +Y and +Z."
msgstr "Average direction and amount the lump's flesh moves when the flesh is pulled along +X (softest point = 1, reference pose\naxes). Y and Z below are the same for +Y and +Z."

#. Key:	SoftbodyInertiaLump:RegionStiffness
#. SourceLocation:	/Script/Softbody.SoftbodyInertiaLump:RegionStiffness [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyInertiaLump:RegionStiffness [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyInertiaLump:RegionStiffness"
msgid "Stiffness of each local shape the lump can take around a press. Empty on lumps that need none."
msgstr "Stiffness of each local shape the lump can take around a press. Empty on lumps that need none."

#. Key:	SoftbodyInertiaLump:Volume
#. SourceLocation:	/Script/Softbody.SoftbodyInertiaLump:Volume [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyInertiaLump:Volume [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyInertiaLump:Volume"
msgid "Flesh volume of the lump (mesh local units cubed)."
msgstr "Flesh volume of the lump (mesh local units cubed)."

#. Key:	SoftbodyLayerLink
#. SourceLocation:	/Script/Softbody.SoftbodyLayerLink [ScriptStruct ToolTip meta-data]
#: /Script/Softbody.SoftbodyLayerLink [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyLayerLink"
msgid "One layered clothing link: a cloth vertex lying over skin (such as underwear) takes the blended values of the skin vertices below\nit, so both layers dent and jiggle together."
msgstr "One layered clothing link: a cloth vertex lying over skin (such as underwear) takes the blended values of the skin vertices below\nit, so both layers dent and jiggle together."

#. Key:	SoftbodyLumpDiscBake
#. SourceLocation:	/Script/Softbody.SoftbodyLumpDiscBake [ScriptStruct ToolTip meta-data]
#: /Script/Softbody.SoftbodyLumpDiscBake [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyLumpDiscBake"
msgid "Raw local press responses of one lump, solved by the measure bake. Only used while baking."
msgstr "Raw local press responses of one lump, solved by the measure bake. Only used while baking."

#. Key:	SoftbodyLumpDiscBake:Centers
#. SourceLocation:	/Script/Softbody.SoftbodyLumpDiscBake:Centers [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyLumpDiscBake:Centers [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyLumpDiscBake:Centers"
msgid "원판 가운데(메시 로컬) — 로그와 검사용."
msgstr "원판 가운데(메시 로컬) — 로그와 검사용."

#. Key:	SoftbodyLumpDiscBake:Group
#. SourceLocation:	/Script/Softbody.SoftbodyLumpDiscBake:Group [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyLumpDiscBake:Group [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyLumpDiscBake:Group"
msgid "덩어리 묶음(관성 그룹 번호, 스태틱은 0)."
msgstr "덩어리 묶음(관성 그룹 번호, 스태틱은 0)."

#. Key:	SoftbodyLumpDiscBake:LoadOffsets
#. SourceLocation:	/Script/Softbody.SoftbodyLumpDiscBake:LoadOffsets [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyLumpDiscBake:LoadOffsets [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyLumpDiscBake:LoadOffsets"
msgid "원판 j의 힘은 LoadOffsets[j] ~ LoadOffsets[j + 1] 구간의 (LoadVertices, LoadForces): 정점마다 안쪽 노멀 쪽 힘, 원판마다 크기 합 1."
msgstr "원판 j의 힘은 LoadOffsets[j] ~ LoadOffsets[j + 1] 구간의 (LoadVertices, LoadForces): 정점마다 안쪽 노멀 쪽 힘, 원판마다 크기 합 1."

#. Key:	SoftbodyLumpDiscBake:Radius
#. SourceLocation:	/Script/Softbody.SoftbodyLumpDiscBake:Radius [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyLumpDiscBake:Radius [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyLumpDiscBake:Radius"
msgid "원판 반지름(메시 로컬)."
msgstr "원판 반지름(메시 로컬)."

#. Key:	SoftbodyLumpDiscBake:Responses
#. SourceLocation:	/Script/Softbody.SoftbodyLumpDiscBake:Responses [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyLumpDiscBake:Responses [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyLumpDiscBake:Responses"
msgid "[원판 j × Vertices.Num() + i]: 원판 j를 힘 합 1로 고르게 눌렀을 때 정점 Vertices[i]가 밀린 양(메시 로컬, 살 단단함 1 — 무름 굽기의 원시 단위)."
msgstr "[원판 j × Vertices.Num() + i]: 원판 j를 힘 합 1로 고르게 눌렀을 때 정점 Vertices[i]가 밀린 양(메시 로컬, 살 단단함 1 — 무름 굽기의 원시 단위)."

#. Key:	SoftbodyLumpDiscBake:Vertices
#. SourceLocation:	/Script/Softbody.SoftbodyLumpDiscBake:Vertices [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyLumpDiscBake:Vertices [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyLumpDiscBake:Vertices"
msgid "응답을 적은 정점(굽기 정점 순서 — VertexPositions·VertexInertiaResponseShapes와 같다): 이 덩어리 무게가 0보다 큰 정점."
msgstr "응답을 적은 정점(굽기 정점 순서 — VertexPositions·VertexInertiaResponseShapes와 같다): 이 덩어리 무게가 0보다 큰 정점."

#. Key:	SoftbodyMeshData
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData [Class ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData"
msgid "Baked Softbody data for one mesh, filled by Run Bake on a Softbody Authoring Data asset: per-vertex values, how soft the flesh is\n(for jiggle) and the contact map. Put it in the Softbody component's Mesh Data."
msgstr "Baked Softbody data for one mesh, filled by Run Bake on a Softbody Authoring Data asset: per-vertex values, how soft the flesh is\n(for jiggle) and the contact map. Put it in the Softbody component's Mesh Data."

#. Key:	SoftbodyMeshData:AttributeTex2
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:AttributeTex2 [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:AttributeTex2 [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:AttributeTex2"
msgid "Per-vertex inertia groups (skeletal meshes only): the up to three bone groups whose motion makes each vertex jiggle, and how\nmuch each one counts. Summed from the full skin weights."
msgstr "Per-vertex inertia groups (skeletal meshes only): the up to three bone groups whose motion makes each vertex jiggle, and how\nmuch each one counts. Summed from the full skin weights."

#. Key:	SoftbodyMeshData:AttributeTexDebug
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:AttributeTexDebug [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:AttributeTexDebug [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:AttributeTexDebug"
msgid "Per-vertex check values shown by the Debug View modes: how soft the flesh is, whether the vertex lies inside the measured\nflesh, and whether it connects to the rigid core."
msgstr "Per-vertex check values shown by the Debug View modes: how soft the flesh is, whether the vertex lies inside the measured\nflesh, and whether it connects to the rigid core."

#. Key:	SoftbodyMeshData:BakeDiagnosticsVersion
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:BakeDiagnosticsVersion [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:BakeDiagnosticsVersion [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:BakeDiagnosticsVersion"
msgid "Format version of the per-vertex bake diagnostics. 0 = none recorded."
msgstr "Format version of the per-vertex bake diagnostics. 0 = none recorded."

#. Key:	SoftbodyMeshData:bPaintVolume
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:bPaintVolume [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:bPaintVolume [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:bPaintVolume"
msgid "On when a slot mask paints Volume Preservation. When off, all flesh fully preserves its volume."
msgstr "On when a slot mask paints Volume Preservation. When off, all flesh fully preserves its volume."

#. Key:	SoftbodyMeshData:BulgeCellBlock
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:BulgeCellBlock [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:BulgeCellBlock [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:BulgeCellBlock"
msgid "Contact map cells per side of one bulge cell (the bulge spreads on this coarser grid)."
msgstr "Contact map cells per side of one bulge cell (the bulge spreads on this coarser grid)."

#. Key:	SoftbodyMeshData:BulgeCellCount
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:BulgeCellCount [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:BulgeCellCount [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:BulgeCellCount"
msgid "Number of bulge cells with flesh (rows of the distance table)."
msgstr "Number of bulge cells with flesh (rows of the distance table)."

#. Key:	SoftbodyMeshData:BulgeLandmarkCount
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:BulgeLandmarkCount [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:BulgeLandmarkCount [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:BulgeLandmarkCount"
msgid "Number of surface landmarks the bulge distances are measured to (0 = older bake without the table)."
msgstr "Number of surface landmarks the bulge distances are measured to (0 = older bake without the table)."

#. Key:	SoftbodyMeshData:BulgeTableVersion
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:BulgeTableVersion [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:BulgeTableVersion [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:BulgeTableVersion"
msgid "Layout version of the bulge distance table. Below 4 = no usable table, so the bulge and the drag stay off until Rebake Contact Map.\n4 and 5 still work, but Rebake Contact Map to get the current version, 6."
msgstr "Layout version of the bulge distance table. Below 4 = no usable table, so the bulge and the drag stay off until Rebake Contact Map.\n4 and 5 still work, but Rebake Contact Map to get the current version, 6."

#. Key:	SoftbodyMeshData:CarrierBulgeDistanceTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierBulgeDistanceTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierBulgeDistanceTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierBulgeDistanceTex"
msgid "Surface distances that spread a dent's pushed-aside flesh and dragged skin along the surface around seams and bone bands.\nMissing = the bulge and the drag stay off until Rebake Contact Map."
msgstr "Surface distances that spread a dent's pushed-aside flesh and dragged skin along the surface around seams and bone bands.\nMissing = the bulge and the drag stay off until Rebake Contact Map."

#. Key:	SoftbodyMeshData:CarrierCharts
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierCharts [EnumProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierCharts [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierCharts"
msgid "How the contact map is cut into pieces. Dents are slightly less accurate along the seams (the red bands in Debug View Mode 5).\nMesh UV0 Islands reuses the UV0 seams the artist already hid. Rebake the contact map after changing it."
msgstr "How the contact map is cut into pieces. Dents are slightly less accurate along the seams (the red bands in Debug View Mode 5).\nMesh UV0 Islands reuses the UV0 seams the artist already hid. Rebake the contact map after changing it."

#. Key:	SoftbodyMeshData:CarrierColumnTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierColumnTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierColumnTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierColumnTex"
msgid "How deep each cell's own flesh goes (0 to 1). A collider buried in the flesh only presses cells within this depth.\nComputed from the mesh shape; there is no setting for it."
msgstr "How deep each cell's own flesh goes (0 to 1). A collider buried in the flesh only presses cells within this depth.\nComputed from the mesh shape; there is no setting for it."

#. Key:	SoftbodyMeshData:CarrierEnvelopeSlots
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierEnvelopeSlots [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierEnvelopeSlots [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierEnvelopeSlots"
msgid "Material slots that can be pressed. Only these get space in the contact map. Empty = the Softbody slots, or the whole mesh if none.\nRebake Contact Map after changing it."
msgstr "Material slots that can be pressed. Only these get space in the contact map. Empty = the Softbody slots, or the whole mesh if none.\nRebake Contact Map after changing it."

#. Key:	SoftbodyMeshData:CarrierFlexMin
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierFlexMin [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierFlexMin [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierFlexMin"
msgid "Darkest Flex paint over the cells (gems lying on the surface left out), for the play-start notes on Flex Offset."
msgstr "Darkest Flex paint over the cells (gems lying on the surface left out), for the play-start notes on Flex Offset."

#. Key:	SoftbodyMeshData:CarrierLiftScale
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierLiftScale [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierLiftScale [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierLiftScale"
msgid "Height (mesh local) that the largest value of Carrier Lift Tex stands for."
msgstr "Height (mesh local) that the largest value of Carrier Lift Tex stands for."

#. Key:	SoftbodyMeshData:CarrierLiftTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierLiftTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierLiftTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierLiftTex"
msgid "Per cell under a floating rigid piece: how far the piece's top is above the cell. Empty when no piece floats."
msgstr "Per cell under a floating rigid piece: how far the piece's top is above the cell. Empty when no piece floats."

#. Key:	SoftbodyMeshData:CarrierLumpRegionIndexTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierLumpRegionIndexTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierLumpRegionIndexTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierLumpRegionIndexTex"
msgid "Per bulge cell of a lump: which entry of the lump shape table it uses. With it, a lump pressed near its base gives way locally\naround the press instead of swinging as a whole. Built by the contact map bake from the measure bake's presses."
msgstr "Per bulge cell of a lump: which entry of the lump shape table it uses. With it, a lump pressed near its base gives way locally\naround the press instead of swinging as a whole. Built by the contact map bake from the measure bake's presses."

#. Key:	SoftbodyMeshData:CarrierLumpRegionTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierLumpRegionTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierLumpRegionTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierLumpRegionTex"
msgid "The lump shape table: per bulge cell, how far each local shape moves that spot (see Carrier Lump Region Index Tex)."
msgstr "The lump shape table: per bulge cell, how far each local shape moves that spot (see Carrier Lump Region Index Tex)."

#. Key:	SoftbodyMeshData:CarrierLumpSideATex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierLumpSideATex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierLumpSideATex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierLumpSideATex"
msgid "Per cell: how much the cell moves sideways with its lump. Keeps a dent under the collider instead of letting it slide along\nwith the lump."
msgstr "Per cell: how much the cell moves sideways with its lump. Keeps a dent under the collider instead of letting it slide along\nwith the lump."

#. Key:	SoftbodyMeshData:CarrierLumpTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierLumpTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierLumpTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierLumpTex"
msgid "Per cell: which lump the cell belongs to and how much it moves with the lump. Without it, lumps do not move aside when pressed.\nRebake Contact Map after changing the paint."
msgstr "Per cell: which lump the cell belongs to and how much it moves with the lump. Without it, lumps do not move aside when pressed.\nRebake Contact Map after changing the paint."

#. Key:	SoftbodyMeshData:CarrierNormalTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierNormalTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierNormalTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierNormalTex"
msgid "Per cell: the direction the flesh is pushed in, and the flesh thickness down to the rigid core."
msgstr "Per cell: the direction the flesh is pushed in, and the flesh thickness down to the rigid core."

#. Key:	SoftbodyMeshData:CarrierPieceTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierPieceTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierPieceTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierPieceTex"
msgid "Per cell: which plate (Flex paint) the cell belongs to. Empty when no plate is painted."
msgstr "Per cell: which plate (Flex paint) the cell belongs to. Empty when no plate is painted."

#. Key:	SoftbodyMeshData:CarrierPositionTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierPositionTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierPositionTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierPositionTex"
msgid "Rest position of each contact map cell on the surface."
msgstr "Rest position of each contact map cell on the surface."

#. Key:	SoftbodyMeshData:CarrierRedirectTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierRedirectTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierRedirectTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierRedirectTex"
msgid "Per cell: links that let dents cross the seams between contact map pieces, plus the local triangle size and surface normal."
msgstr "Per cell: links that let dents cross the seams between contact map pieces, plus the local triangle size and surface normal."

#. Key:	SoftbodyMeshData:CarrierResolution
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierResolution [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierResolution [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierResolution"
msgid "Contact map size in texels per side. The textures used while playing have the same size."
msgstr "Contact map size in texels per side. The textures used while playing have the same size."

#. Key:	SoftbodyMeshData:CarrierSeparationTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierSeparationTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierSeparationTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierSeparationTex"
msgid "Per cell: how much of it belongs to each side of the Separated Pairs (bone weights). Built from the authoring asset's Separated\nPairs when the contact map is baked. Empty = no Separated Pairs."
msgstr "Per cell: how much of it belongs to each side of the Separated Pairs (bone weights). Built from the authoring asset's Separated\nPairs when the contact map is baked. Empty = no Separated Pairs."

#. Key:	SoftbodyMeshData:CarrierSkinIndexTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierSkinIndexTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierSkinIndexTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierSkinIndexTex"
msgid "Skeletal meshes only: the four bones that move each contact map cell."
msgstr "Skeletal meshes only: the four bones that move each contact map cell."

#. Key:	SoftbodyMeshData:CarrierSkinWeightTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierSkinWeightTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierSkinWeightTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierSkinWeightTex"
msgid "Skeletal meshes only: the weights of those four bones (they add up to 1)."
msgstr "Skeletal meshes only: the weights of those four bones (they add up to 1)."

#. Key:	SoftbodyMeshData:CarrierSoftnessCoverage
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierSoftnessCoverage [ByteProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierSoftnessCoverage [ByteProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierSoftnessCoverage"
msgid "1 = Carrier Softness Tex holds the Flex paint of every cell.\n0 = it holds it only under plates, so gray paint elsewhere is bare skin until Reapply Paint."
msgstr "1 = Carrier Softness Tex holds the Flex paint of every cell.\n0 = it holds it only under plates, so gray paint elsewhere is bare skin until Reapply Paint."

#. Key:	SoftbodyMeshData:CarrierSoftnessTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierSoftnessTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierSoftnessTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierSoftnessTex"
msgid "Per cell: its Flex paint (how stiff the skin bends there). Empty when nothing is painted below white."
msgstr "Per cell: its Flex paint (how stiff the skin bends there). Empty when nothing is painted below white."

#. Key:	SoftbodyMeshData:CarrierTexelSize
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierTexelSize [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierTexelSize [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierTexelSize"
msgid "Average surface length covered by one contact map cell (mesh local units). Smaller cells give finer dents."
msgstr "Average surface length covered by one contact map cell (mesh local units). Smaller cells give finer dents."

#. Key:	SoftbodyMeshData:CarrierThicknessFloor
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierThicknessFloor [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierThicknessFloor [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierThicknessFloor"
msgid "Thinnest flesh the contact map bake can measure (mesh local units). Cells where the rigid core touches the skin get this thickness.\nCells at or below it count as skin held by the bone, so bulges fade out before reaching them."
msgstr "Thinnest flesh the contact map bake can measure (mesh local units). Cells where the rigid core touches the skin get this thickness.\nCells at or below it count as skin held by the bone, so bulges fade out before reaching them."

#. Key:	SoftbodyMeshData:CarrierThicknessHigh
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierThicknessHigh [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierThicknessHigh [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierThicknessHigh"
msgid "Flesh thickness of the thicker contact map cells (90th percentile of the cells with flesh, mesh local units).\nThe contact update sizes its widest dent and drag from it."
msgstr "Flesh thickness of the thicker contact map cells (90th percentile of the cells with flesh, mesh local units).\nThe contact update sizes its widest dent and drag from it."

#. Key:	SoftbodyMeshData:CarrierThicknessMedian
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierThicknessMedian [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierThicknessMedian [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierThicknessMedian"
msgid "Median flesh thickness of the contact map cells with flesh (mesh local units)."
msgstr "Median flesh thickness of the contact map cells with flesh (mesh local units)."

#. Key:	SoftbodyMeshData:CarrierUVChannel
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierUVChannel [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierUVChannel [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierUVChannel"
msgid "Mesh UV channel holding the contact map UVs per vertex (-1 = none). The Softbody material's CarrierUV input reads this channel."
msgstr "Mesh UV channel holding the contact map UVs per vertex (-1 = none). The Softbody material's CarrierUV input reads this channel."

#. Key:	SoftbodyMeshData:CarrierUVTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierUVTex [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierUVTex [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierUVTex"
msgid "Per-vertex lookup into the contact map: where each vertex reads its dent, and its distance to the outer surface."
msgstr "Per-vertex lookup into the contact map: where each vertex reads its dent, and its distance to the outer surface."

#. Key:	SoftbodyMeshData:CarrierVersion
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierVersion [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierVersion [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierVersion"
msgid "Contact map format version. 0 = no contact map, and 1 = baked with an older plugin. Either way the mesh cannot be pressed until\nyou press Rebake Contact Map."
msgstr "Contact map format version. 0 = no contact map, and 1 = baked with an older plugin. Either way the mesh cannot be pressed until\nyou press Rebake Contact Map."

#. Key:	SoftbodyMeshData:CarrierVolumeTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierVolumeTex [SoftObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierVolumeTex [SoftObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierVolumeTex"
msgid "Volume paint per contact map cell (0 to 1). 1 (flesh, gel): the pushed-in volume bulges up around a tight dent. 0 (foam): no bulge.\nApplied with Reapply Paint."
msgstr "Volume paint per contact map cell (0 to 1). 1 (flesh, gel): the pushed-in volume bulges up around a tight dent. 0 (foam): no bulge.\nApplied with Reapply Paint."

#. Key:	SoftbodyMeshData:CarrierWakeBounds
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierWakeBounds [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierWakeBounds [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierWakeBounds"
msgid "Sleeping: per bone, the box (reference pose, mesh local) where that bone's flesh can be pressed. When no collider or hand can\nreach any box, contact sleeps and costs no GPU time."
msgstr "Sleeping: per bone, the box (reference pose, mesh local) where that bone's flesh can be pressed. When no collider or hand can\nreach any box, contact sleeps and costs no GPU time."

#. Key:	SoftbodyMeshData:CarrierWakeSelfBounds
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierWakeSelfBounds [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierWakeSelfBounds [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierWakeSelfBounds"
msgid "Sleeping: for each self contact part and bone, the box of cells that part can press. Flesh the part always touches (the forearm\nnext to the wrist) is left out, so a resting hand does not keep the whole body awake."
msgstr "Sleeping: for each self contact part and bone, the box of cells that part can press. Flesh the part always touches (the forearm\nnext to the wrist) is left out, so a resting hand does not keep the whole body awake."

#. Key:	SoftbodyMeshData:CarrierWakeSelfParts
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:CarrierWakeSelfParts [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:CarrierWakeSelfParts [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:CarrierWakeSelfParts"
msgid "Sleeping: bone names of the self contact parts (the shape field parts that press the mesh itself), in shape field order. If they\nno longer match the shape field, self contact never sleeps until the contact map or the shape field is baked again."
msgstr "Sleeping: bone names of the self contact parts (the shape field parts that press the mesh itself), in shape field order. If they\nno longer match the shape field, self contact never sleeps until the contact map or the shape field is baked again."

#. Key:	SoftbodyMeshData:HardCellGradRange
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardCellGradRange [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardCellGradRange [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardCellGradRange"
msgid "발자국 칸마다 국소 판 기울기 항 구간 (첫 자리, 수) → HardGradEntries. 항 = (asfloat(이웃 f — 조각 안 번호), Gx 무게, Gy 무게, 0), 제 칸 몫도\n한 항이다. 그 칸 판 기울기(로컬 길이당) = Σ 항 (Gx, Gy) × w_g. 3 × 3 이웃 발자국 칸의 넓이 무게 최소 제곱(모자라면 5 × 5, 7 × 7)."
msgstr "발자국 칸마다 국소 판 기울기 항 구간 (첫 자리, 수) → HardGradEntries. 항 = (asfloat(이웃 f — 조각 안 번호), Gx 무게, Gy 무게, 0), 제 칸 몫도\n한 항이다. 그 칸 판 기울기(로컬 길이당) = Σ 항 (Gx, Gy) × w_g. 3 × 3 이웃 발자국 칸의 넓이 무게 최소 제곱(모자라면 5 × 5, 7 × 7)."

#. Key:	SoftbodyMeshData:HardCellPlate
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardCellPlate [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardCellPlate [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardCellPlate"
msgid "휘는 판(ADR-0038 §4, 판 2) — 모두 메시 로컬 단위, 판 좌표 = ((x − Center)·AxisU, (x − Center)·AxisV). 식은 Tools/contact_response/\nreplica_plate.py PlateBake(ghost='plane').\n발자국 칸마다(HardPieceCells와 같은 차례, 전역 번호 = FirstCell + f): (x_F, y_F, A_F, 0) — 그 거친 칸 판 가는 칸 정지 자리의 판 좌표 평균과\n넓이(가는 칸 수 × CarrierTexelSize²). 압력 풀이의 발자국 줄이 이 자리에서 판을 잰다."
msgstr "휘는 판(ADR-0038 §4, 판 2) — 모두 메시 로컬 단위, 판 좌표 = ((x − Center)·AxisU, (x − Center)·AxisV). 식은 Tools/contact_response/\nreplica_plate.py PlateBake(ghost='plane').\n발자국 칸마다(HardPieceCells와 같은 차례, 전역 번호 = FirstCell + f): (x_F, y_F, A_F, 0) — 그 거친 칸 판 가는 칸 정지 자리의 판 좌표 평균과\n넓이(가는 칸 수 × CarrierTexelSize²). 압력 풀이의 발자국 줄이 이 자리에서 판을 잰다."

#. Key:	SoftbodyMeshData:HardMaskMeasuredHash
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardMaskMeasuredHash [UInt32Property ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardMaskMeasuredHash [UInt32Property ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardMaskMeasuredHash"
msgid "측정 굽기가 뺀 떠 있는 조각의 칠 지문(칠 단계와 다르면 Run Bake를 알린다 — Reapply Paint는 측정을 다시 하지 않는다)."
msgstr "측정 굽기가 뺀 떠 있는 조각의 칠 지문(칠 단계와 다르면 Run Bake를 알린다 — Reapply Paint는 측정을 다시 하지 않는다)."

#. Key:	SoftbodyMeshData:HardModes
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardModes [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardModes [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardModes"
msgid "판 모드마다 (β, k). β = 그 모양의 판 굽힘 굳기 ψᵀB_cψ(B_c = 발자국 칸 판 굽힘, D/μ = ℓ_b³ 포함, 로컬 단위 — 실행이 길이 눈금 하나를\n곱한다), 오름차순. k = 모양의 파수(ψᵀLψ의 제곱근, L = 발자국 네 이웃 그래프 라플라시안 ÷ 거친 칸 한 변²) — 모드 줄 앞처리 어림."
msgstr "판 모드마다 (β, k). β = 그 모양의 판 굽힘 굳기 ψᵀB_cψ(B_c = 발자국 칸 판 굽힘, D/μ = ℓ_b³ 포함, 로컬 단위 — 실행이 길이 눈금 하나를\n곱한다), 오름차순. k = 모양의 파수(ψᵀLψ의 제곱근, L = 발자국 네 이웃 그래프 라플라시안 ÷ 거친 칸 한 변²) — 모드 줄 앞처리 어림."

#. Key:	SoftbodyMeshData:HardModeShapes
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardModeShapes [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardModeShapes [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardModeShapes"
msgid "판 모드 모양 ψ(조각마다 n_F × NumModes, F 먼저), 반정밀 비트(FFloat16과 같은 바이트 배치). 모드마다 Σ_F ψ² = 1, 강체 셋(1, x_F, y_F)과 직교."
msgstr "판 모드 모양 ψ(조각마다 n_F × NumModes, F 먼저), 반정밀 비트(FFloat16과 같은 바이트 배치). 모드마다 Σ_F ψ² = 1, 강체 셋(1, x_F, y_F)과 직교."

#. Key:	SoftbodyMeshData:HardNodes
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardNodes [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardNodes [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardNodes"
msgid "판 마디(조각마다 FirstNode부터 NumNodes개): (X, Y, asfloat(HardNodeSrc 첫 자리), asfloat(원천 수)). X·Y = 마디(거친 칸 가운데)의 판 좌표.\n마디 값 = 원천 발자국 칸 국소 판들(w_f + (X − x_f)gx_f + (Y − y_f)gy_f)의 평균. 가는 칸 판 깊이는 둘레 4 × 4 마디에서 Catmull-Rom으로 읽는다\n(거친 연속 좌표 q = (가는 칸 + 0.5)/BulgeCellBlock − 0.5, 마디는 거친 칸 정수 자리 — 판 가는 칸마다 4 × 4가 다 있게 굽는다)."
msgstr "판 마디(조각마다 FirstNode부터 NumNodes개): (X, Y, asfloat(HardNodeSrc 첫 자리), asfloat(원천 수)). X·Y = 마디(거친 칸 가운데)의 판 좌표.\n마디 값 = 원천 발자국 칸 국소 판들(w_f + (X − x_f)gx_f + (Y − y_f)gy_f)의 평균. 가는 칸 판 깊이는 둘레 4 × 4 마디에서 Catmull-Rom으로 읽는다\n(거친 연속 좌표 q = (가는 칸 + 0.5)/BulgeCellBlock − 0.5, 마디는 거친 칸 정수 자리 — 판 가는 칸마다 4 × 4가 다 있게 굽는다)."

#. Key:	SoftbodyMeshData:HardNodeSlots
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardNodeSlots [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardNodeSlots [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardNodeSlots"
msgid "조각마다 마디 상자(FSoftbodyHardPiece::NodeBoxMin·NodeBoxSize) 칸마다 조각 안 마디 번호, 없으면 −1."
msgstr "조각마다 마디 상자(FSoftbodyHardPiece::NodeBoxMin·NodeBoxSize) 칸마다 조각 안 마디 번호, 없으면 −1."

#. Key:	SoftbodyMeshData:HardNodeSrc
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardNodeSrc [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardNodeSrc [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardNodeSrc"
msgid "마디 원천 = 조각 안 발자국 번호 f: 마디가 발자국 칸이면 그 칸 하나, 아니면 3 × 3(없으면 5 × 5) 안 발자국 칸들."
msgstr "마디 원천 = 조각 안 발자국 번호 f: 마디가 발자국 칸이면 그 칸 하나, 아니면 3 × 3(없으면 5 × 5) 안 발자국 칸들."

#. Key:	SoftbodyMeshData:HardPieceCells
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardPieceCells [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardPieceCells [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardPieceCells"
msgid "조각마다 발자국 거친 칸(x | y << 16, 솟음 거친 격자)과 함몰 묶음(x | y << 16, 16 × 16 칸) 목록 — FSoftbodyHardPiece의 First·Num 구간."
msgstr "조각마다 발자국 거친 칸(x | y << 16, 솟음 거친 격자)과 함몰 묶음(x | y << 16, 16 × 16 칸) 목록 — FSoftbodyHardPiece의 First·Num 구간."

#. Key:	SoftbodyMeshData:HardPieceResults
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardPieceResults [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardPieceResults [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardPieceResults"
msgid "저작 에셋 미리보기 Hard Surface Pieces 보기 전용 기록: 칠 단계 조각(HardTrianglePieces 번호 − 1 자리)마다 접촉 지도 굽기의 결과 —\n1부터 = 남은 판 번호(HardPieces 자리 + 1), 음수 = 살로 남은 까닭(SoftbodyBakeShared::HardDropped*). HardPieceResultsHash = 그 굽기가 읽은\n칠 지문(HardMaskPaintHash와 다르면 그 뒤에 칠이 바뀌었다). 실행 중에는 읽지 않는다."
msgstr "저작 에셋 미리보기 Hard Surface Pieces 보기 전용 기록: 칠 단계 조각(HardTrianglePieces 번호 − 1 자리)마다 접촉 지도 굽기의 결과 —\n1부터 = 남은 판 번호(HardPieces 자리 + 1), 음수 = 살로 남은 까닭(SoftbodyBakeShared::HardDropped*). HardPieceResultsHash = 그 굽기가 읽은\n칠 지문(HardMaskPaintHash와 다르면 그 뒤에 칠이 바뀌었다). 실행 중에는 읽지 않는다."

#. Key:	SoftbodyMeshData:HardPieces
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardPieces [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardPieces [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardPieces"
msgid "Plates painted dark in Flex. Filled by the contact map bake."
msgstr "Plates painted dark in Flex. Filled by the contact map bake."

#. Key:	SoftbodyMeshData:HardPieceVersion
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardPieceVersion [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardPieceVersion [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardPieceVersion"
msgid "Layout version of the plate table. With 0 or an older version, painted plates press like flesh until you press Run Bake."
msgstr "Layout version of the plate table. With 0 or an older version, painted plates press like flesh until you press Run Bake."

#. Key:	SoftbodyMeshData:HardTrianglePieces
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardTrianglePieces [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardTrianglePieces [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardTrianglePieces"
msgid "하드 서피스 칠 → 접촉 지도 굽기 다리(SoftbodyHardSurface). 칠 단계(Reapply Paint·Run Bake)가 슬롯 마스크에서 조각을 찾아 적고 접촉 지도\n굽기가 읽는다 — 접촉 지도 굽기는 슬롯 마스크를 모른다. 메시 설명 삼각형 자리(FTriangleID 값)마다 조각 번호(0 = 단단하지 않음, 1부터),\n조각마다 떠 있는가(단단하지 않은 삼각형과 용접한 정점을 나누지 않는 조각 — 다른 겉면 위에 놓인 장식). 쿡에서 빠진다."
msgstr "하드 서피스 칠 → 접촉 지도 굽기 다리(SoftbodyHardSurface). 칠 단계(Reapply Paint·Run Bake)가 슬롯 마스크에서 조각을 찾아 적고 접촉 지도\n굽기가 읽는다 — 접촉 지도 굽기는 슬롯 마스크를 모른다. 메시 설명 삼각형 자리(FTriangleID 값)마다 조각 번호(0 = 단단하지 않음, 1부터),\n조각마다 떠 있는가(단단하지 않은 삼각형과 용접한 정점을 나누지 않는 조각 — 다른 겉면 위에 놓인 장식). 쿡에서 빠진다."

#. Key:	SoftbodyMeshData:HardTriangleSoftness
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:HardTriangleSoftness [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:HardTriangleSoftness [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:HardTriangleSoftness"
msgid "삼각형 코너마다 Flex 칠(메시 설명 삼각형 자리 × 3 + 코너). HardTriangleSoftnessLayout 1 = 모든 삼각형(연속 굽힘 — Flex를 읽지 않는 슬롯은 1),\n0 = 옛 칠 단계(판 삼각형만, 나머지 1). 접촉 지도 굽기가 칸마다 Flex(CarrierSoftnessTex)와 판 굽힘을 여기서 낸다. 쿡에서 빠진다."
msgstr "삼각형 코너마다 Flex 칠(메시 설명 삼각형 자리 × 3 + 코너). HardTriangleSoftnessLayout 1 = 모든 삼각형(연속 굽힘 — Flex를 읽지 않는 슬롯은 1),\n0 = 옛 칠 단계(판 삼각형만, 나머지 1). 접촉 지도 굽기가 칸마다 Flex(CarrierSoftnessTex)와 판 굽힘을 여기서 낸다. 쿡에서 빠진다."

#. Key:	SoftbodyMeshData:InertiaAnchorLocal
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaAnchorLocal [StructProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaAnchorLocal [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaAnchorLocal"
msgid "Center of the rigid core used by the bake (mesh local). A static mesh swings around this point."
msgstr "Center of the rigid core used by the bake (mesh local). A static mesh swings around this point."

#. Key:	SoftbodyMeshData:InertiaAnchorReach
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaAnchorReach [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaAnchorReach [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaAnchorReach"
msgid "Distance from that center to the farthest surface vertex (mesh local). Limits rotational jiggle on a static mesh."
msgstr "Distance from that center to the farthest surface vertex (mesh local). Limits rotational jiggle on a static mesh."

#. Key:	SoftbodyMeshData:InertiaGroupBones
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaGroupBones [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaGroupBones [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaGroupBones"
msgid "The bone that drives each inertia group (up to 16). Each group jiggles with its bone's acceleration, rotation and change in\ngravity direction."
msgstr "The bone that drives each inertia group (up to 16). Each group jiggles with its bone's acceleration, rotation and change in\ngravity direction."

#. Key:	SoftbodyMeshData:InertiaGroupLump
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaGroupLump [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaGroupLump [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaGroupLump"
msgid "Whether each inertia group is a lump: flesh led by a Lump bone (breasts, buttocks) that moves aside as one piece when pressed.\nGroups inside the rigid core, such as the torso, do not move aside."
msgstr "Whether each inertia group is a lump: flesh led by a Lump bone (breasts, buttocks) that moves aside as one piece when pressed.\nGroups inside the rigid core, such as the torso, do not move aside."

#. Key:	SoftbodyMeshData:InertiaGroupReach
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaGroupReach [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaGroupReach [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaGroupReach"
msgid "Farthest distance from each group's bone (reference pose) to a vertex it moves (mesh local). Limits rotational jiggle."
msgstr "Farthest distance from each group's bone (reference pose) to a vertex it moves (mesh local). Limits rotational jiggle."

#. Key:	SoftbodyMeshData:InertiaGroupSag
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaGroupSag [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaGroupSag [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaGroupSag"
msgid "How far each inertia group's flesh sags under 1 g compared with the reference flesh (most of its vertices)."
msgstr "How far each inertia group's flesh sags under 1 g compared with the reference flesh (most of its vertices)."

#. Key:	SoftbodyMeshData:InertiaGroupSagMax
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaGroupSagMax [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaGroupSagMax [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaGroupSagMax"
msgid "The most any vertex of each inertia group sags under 1 g compared with the reference flesh. Max Inertia Offset uses it."
msgstr "The most any vertex of each inertia group sags under 1 g compared with the reference flesh. Max Inertia Offset uses it."

#. Key:	SoftbodyMeshData:InertiaLumps
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaLumps [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaLumps [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaLumps"
msgid "Volume and average softness of each lump (bones set to Lump on a skeletal mesh). Filled by the contact map bake."
msgstr "Volume and average softness of each lump (bones set to Lump on a skeletal mesh). Filled by the contact map bake."

#. Key:	SoftbodyMeshData:InertiaPaintScale
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaPaintScale [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaPaintScale [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaPaintScale"
msgid "How much the jiggle paint was scaled so that the reference flesh (thick flesh painted white in Jiggle) sags Inertia Amount at 1 g.\nLumps use the same reference."
msgstr "How much the jiggle paint was scaled so that the reference flesh (thick flesh painted white in Jiggle) sags Inertia Amount at 1 g.\nLumps use the same reference."

#. Key:	SoftbodyMeshData:InertiaResponseRows
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaResponseRows [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaResponseRows [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaResponseRows"
msgid "Rows in the baked flesh softness texture. 7 = the shading tilts with the jiggle; 3 or 0 = the shading does not follow the jiggle.\nPress Reapply Paint or Run Bake to update."
msgstr "Rows in the baked flesh softness texture. 7 = the shading tilts with the jiggle; 3 or 0 = the shading does not follow the jiggle.\nPress Reapply Paint or Run Bake to update."

#. Key:	SoftbodyMeshData:InertiaResponseScales
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaResponseScales [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaResponseScales [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaResponseScales"
msgid "Raw largest movement per direction before scaling (for diagnosis). All three directions are scaled by the largest of these."
msgstr "Raw largest movement per direction before scaling (for diagnosis). All three directions are scaled by the largest of these."

#. Key:	SoftbodyMeshData:InertiaResponseTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaResponseTex [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaResponseTex [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaResponseTex"
msgid "Baked flesh softness per vertex: which way and how far each vertex moves when the flesh is pulled along X, Y and Z (softest\npoint = 1). This is what makes the flesh jiggle."
msgstr "Baked flesh softness per vertex: which way and how far each vertex moves when the flesh is pulled along X, Y and Z (softest\npoint = 1). This is what makes the flesh jiggle."

#. Key:	SoftbodyMeshData:InertiaResponseVersion
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:InertiaResponseVersion [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:InertiaResponseVersion [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:InertiaResponseVersion"
msgid "Format version of the baked flesh softness. It must be 2; older bakes do not jiggle until you press Run Bake again."
msgstr "Format version of the baked flesh softness. It must be 2; older bakes do not jiggle until you press Run Bake again."

#. Key:	SoftbodyMeshData:LayerLinks
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:LayerLinks [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:LayerLinks [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:LayerLinks"
msgid "Layered clothing: for each cloth vertex lying over skin (such as underwear), the skin vertices it follows and their weights, so\ncloth and skin move together and the skin does not poke through."
msgstr "Layered clothing: for each cloth vertex lying over skin (such as underwear), the skin vertices it follows and their weights, so\ncloth and skin move together and the skin does not poke through."

#. Key:	SoftbodyMeshData:LayerMaxGap
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:LayerMaxGap [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:LayerMaxGap [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:LayerMaxGap"
msgid "Distance used to find layered clothing (cm, 0 = not searched). Comes from Layer Max Gap on the authoring asset."
msgstr "Distance used to find layered clothing (cm, 0 = not searched). Comes from Layer Max Gap on the authoring asset."

#. Key:	SoftbodyMeshData:LoadContactMap
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:LoadContactMap [Function ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:LoadContactMap [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:LoadContactMap"
msgid "Loads the contact map textures now (they load on their own when a Softbody component that uses them is switched on). For editor\nscripts that read them."
msgstr "Loads the contact map textures now (they load on their own when a Softbody component that uses them is switched on). For editor\nscripts that read them."

#. Key:	SoftbodyMeshData:LumpBaseVertices
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:LumpBaseVertices [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:LumpBaseVertices [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:LumpBaseVertices"
msgid "덩어리 받침 막(ADR-0034, SoftbodyLumpSupport) — 저작 에셋 미리보기의 Lump Base 보기 전용 기록이다. 실행 중에는 읽지 않고 쿡에서 빠진다.\n접촉 지도 굽기가 덩어리 칸의 살 두께를 잴 때 쓴 막을 그대로 남긴다: 메시 공간 정점, 삼각형(정점 번호 셋씩), 정점마다 그 위 둔덕 높이\n(살갗까지 거리, 영역 밖 0), 덩어리마다 한 줄. bLumpBaseRecorded = 이 기록을 남기는 판의 굽기인가(옛 굽기와 가른다)."
msgstr "덩어리 받침 막(ADR-0034, SoftbodyLumpSupport) — 저작 에셋 미리보기의 Lump Base 보기 전용 기록이다. 실행 중에는 읽지 않고 쿡에서 빠진다.\n접촉 지도 굽기가 덩어리 칸의 살 두께를 잴 때 쓴 막을 그대로 남긴다: 메시 공간 정점, 삼각형(정점 번호 셋씩), 정점마다 그 위 둔덕 높이\n(살갗까지 거리, 영역 밖 0), 덩어리마다 한 줄. bLumpBaseRecorded = 이 기록을 남기는 판의 굽기인가(옛 굽기와 가른다)."

#. Key:	SoftbodyMeshData:LumpDiscBakes
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:LumpDiscBakes [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:LumpDiscBakes [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:LumpDiscBakes"
msgid "Raw local press responses per lump, solved by the measure bake and finished by the contact map bake."
msgstr "Raw local press responses per lump, solved by the measure bake and finished by the contact map bake."

#. Key:	SoftbodyMeshData:LumpRegionRecords
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:LumpRegionRecords [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:LumpRegionRecords [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:LumpRegionRecords"
msgid "Number of entries in the lump shape table."
msgstr "Number of entries in the lump shape table."

#. Key:	SoftbodyMeshData:LumpRegionVersion
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:LumpRegionVersion [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:LumpRegionVersion [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:LumpRegionVersion"
msgid "Layout version of the lump shape table (0 = none; lumps give way only as a whole until Run Bake)."
msgstr "Layout version of the lump shape table (0 = none; lumps give way only as a whole until Run Bake)."

#. Key:	SoftbodyMeshData:MeasuredPaintHash
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:MeasuredPaintHash [UInt32Property ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:MeasuredPaintHash [UInt32Property ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:MeasuredPaintHash"
msgid "측정 굽기가 읽은 칠 전부(Depth·Jiggle·Volume·떠 있는 판)의 지문(SoftbodyBakeShared::MeasurePaintHashOf, ADR-0038 §3.6). 저작 에셋의 지금\n칠과 다르면 Reapply Paint가 Run Bake로 돈다 — 캐리어만 다시 구우면 출렁임의 뼈와 접촉의 두께가 어긋난다(원칙 P04)."
msgstr "측정 굽기가 읽은 칠 전부(Depth·Jiggle·Volume·떠 있는 판)의 지문(SoftbodyBakeShared::MeasurePaintHashOf, ADR-0038 §3.6). 저작 에셋의 지금\n칠과 다르면 Reapply Paint가 Run Bake로 돈다 — 캐리어만 다시 구우면 출렁임의 뼈와 접촉의 두께가 어긋난다(원칙 P04)."

#. Key:	SoftbodyMeshData:MeasuredVolumePreservation
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:MeasuredVolumePreservation [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:MeasuredVolumePreservation [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:MeasuredVolumePreservation"
msgid "Volume Preservation that the last Run Bake measured the flesh with. How a whole lump spreads follows this value until the next Run Bake."
msgstr "Volume Preservation that the last Run Bake measured the flesh with. How a whole lump spreads follows this value until the next Run Bake."

#. Key:	SoftbodyMeshData:MedianEdgeLength
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:MedianEdgeLength [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:MedianEdgeLength [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:MedianEdgeLength"
msgid "Median triangle edge length of the LOD0 mesh (mesh local units). The bake check tools use it as a distance reference."
msgstr "Median triangle edge length of the LOD0 mesh (mesh local units). The bake check tools use it as a distance reference."

#. Key:	SoftbodyMeshData:PaintTex
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:PaintTex [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:PaintTex [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:PaintTex"
msgid "Per-vertex paint made by the bake from the slot paint: depth, jiggle amount after the bake's own scaling, and volume. When empty,\neverything counts as fully painted (white)."
msgstr "Per-vertex paint made by the bake from the slot paint: depth, jiggle amount after the bake's own scaling, and volume. When empty,\neverything counts as fully painted (white)."

#. Key:	SoftbodyMeshData:PhysicsDrivenBones
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:PhysicsDrivenBones [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:PhysicsDrivenBones [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:PhysicsDrivenBones"
msgid "Bones moved by simulated physics bodies. Flesh skinned to these bones and their children gets proportionally less inertia jiggle.\nCopied from Physics Driven Bones on the authoring asset when the paint is reapplied."
msgstr "Bones moved by simulated physics bodies. Flesh skinned to these bones and their children gets proportionally less inertia jiggle.\nCopied from Physics Driven Bones on the authoring asset when the paint is reapplied."

#. Key:	SoftbodyMeshData:RigidCoreShrink
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:RigidCoreShrink [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:RigidCoreShrink [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:RigidCoreShrink"
msgid "Default Bone Thickness used by the last Run Bake."
msgstr "Default Bone Thickness used by the last Run Bake."

#. Key:	SoftbodyMeshData:RigidCoreSlots
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:RigidCoreSlots [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:RigidCoreSlots [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:RigidCoreSlots"
msgid "Material slots the rigid core belongs to (slots with a Softbody material). Bones that move only other slots are not part of the core.\nEmpty = every slot."
msgstr "Material slots the rigid core belongs to (slots with a Softbody material). Bones that move only other slots are not part of the core.\nEmpty = every slot."

#. Key:	SoftbodyMeshData:RigidShrinkPerBone
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:RigidShrinkPerBone [MapProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:RigidShrinkPerBone [MapProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:RigidShrinkPerBone"
msgid "Per-bone rigid core settings used by the bake (bone name -> Bone Thickness).\n-1 = that bone and the bones below it are not rigid core, -2 = only that bone."
msgstr "Per-bone rigid core settings used by the bake (bone name -> Bone Thickness).\n-1 = that bone and the bones below it are not rigid core, -2 = only that bone."

#. Key:	SoftbodyMeshData:SourceMesh
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:SourceMesh [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:SourceMesh [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:SourceMesh"
msgid "The static mesh this data was baked from (None for a skeletal mesh bake)."
msgstr "The static mesh this data was baked from (None for a skeletal mesh bake)."

#. Key:	SoftbodyMeshData:SourceSkeletalMesh
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:SourceSkeletalMesh [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:SourceSkeletalMesh [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:SourceSkeletalMesh"
msgid "The skeletal mesh this data was baked from (None for a static mesh bake)."
msgstr "The skeletal mesh this data was baked from (None for a static mesh bake)."

#. Key:	SoftbodyMeshData:TexelUVChannel
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:TexelUVChannel [IntProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:TexelUVChannel [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:TexelUVChannel"
msgid "UV channel the bake added for per-vertex data. The Softbody material reads the values through it (the TexelUV input)."
msgstr "UV channel the bake added for per-vertex data. The Softbody material reads the values through it (the TexelUV input)."

#. Key:	SoftbodyMeshData:VertexAreas
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:VertexAreas [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:VertexAreas [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:VertexAreas"
msgid "Surface area per vertex (a third of the adjacent triangle areas), in the same order as VertexPositions."
msgstr "Surface area per vertex (a third of the adjacent triangle areas), in the same order as VertexPositions."

#. Key:	SoftbodyMeshData:VertexCoreConnection
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:VertexCoreConnection [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:VertexCoreConnection [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:VertexCoreConnection"
msgid "Per vertex: 0 = unknown or failed, 1 = connected to the rigid core, 2 = not connected."
msgstr "Per vertex: 0 = unknown or failed, 1 = connected to the rigid core, 2 = not connected."

#. Key:	SoftbodyMeshData:VertexEmbeddingMinWeight
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:VertexEmbeddingMinWeight [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:VertexEmbeddingMinWeight [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:VertexEmbeddingMinWeight"
msgid "Per vertex: how far inside the measured flesh the vertex sits (-1 = failed)."
msgstr "Per vertex: how far inside the measured flesh the vertex sits (-1 = failed)."

#. Key:	SoftbodyMeshData:VertexEmbeddingStatus
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:VertexEmbeddingStatus [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:VertexEmbeddingStatus [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:VertexEmbeddingStatus"
msgid "Per vertex: 0 = not recorded, 1 = outside the measured flesh (failed), 2 = just outside (extrapolated), 3 = inside."
msgstr "Per vertex: 0 = not recorded, 1 = outside the measured flesh (failed), 2 = just outside (extrapolated), 3 = inside."

#. Key:	SoftbodyMeshData:VertexInertiaResponseRms
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:VertexInertiaResponseRms [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:VertexInertiaResponseRms [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:VertexInertiaResponseRms"
msgid "Per vertex: average size of the baked softness over the three directions."
msgstr "Per vertex: average size of the baked softness over the three directions."

#. Key:	SoftbodyMeshData:VertexInertiaResponseShapes
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:VertexInertiaResponseShapes [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:VertexInertiaResponseShapes [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:VertexInertiaResponseShapes"
msgid "Baked flesh softness per vertex, kept for offline checks."
msgstr "Baked flesh softness per vertex, kept for offline checks."

#. Key:	SoftbodyMeshData:VertexPositions
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:VertexPositions [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:VertexPositions [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:VertexPositions"
msgid "Welded vertex positions of the baked mesh (mesh local), used by the bake check tools."
msgstr "Welded vertex positions of the baked mesh (mesh local), used by the bake check tools."

#. Key:	SoftbodyMeshData:VolumeMesh
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:VolumeMesh [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:VolumeMesh [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:VolumeMesh"
msgid "The closed, filled mesh whose inside the bake treats as flesh. Empty = the source mesh itself.\nFor an open or hollow source mesh. Positions, UVs, skinning and paint still come from the source mesh."
msgstr "The closed, filled mesh whose inside the bake treats as flesh. Empty = the source mesh itself.\nFor an open or hollow source mesh. Positions, UVs, skinning and paint still come from the source mesh."

#. Key:	SoftbodyMeshData:VolumePreservation
#. SourceLocation:	/Script/Softbody.SoftbodyMeshData:VolumePreservation [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodyMeshData:VolumePreservation [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyMeshData:VolumePreservation"
msgid "Volume Preservation of the authoring asset (0 foam ... 1 flesh), for the whole mesh. The painted Volume multiplies it and the\ncomponent's Volume Offset adds to the result. Changing it on the authoring asset updates this at once."
msgstr "Volume Preservation of the authoring asset (0 foam ... 1 flesh), for the whole mesh. The painted Volume multiplies it and the\ncomponent's Volume Offset adds to the result. Changing it on the authoring asset updates this at once."

#. Key:	SoftbodyScenarioSubsystem
#. SourceLocation:	/Script/Softbody.SoftbodyScenarioSubsystem [Class ToolTip meta-data]
#: /Script/Softbody.SoftbodyScenarioSubsystem [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyScenarioSubsystem"
msgid "Profiling tool: Softbody.Scenario <name> keeps only the actors tagged SoftbodyScenario.<name> on, to measure one scene at a time.\nActors without such a tag are left alone. Exists only in game and PIE worlds."
msgstr "Profiling tool: Softbody.Scenario <name> keeps only the actors tagged SoftbodyScenario.<name> on, to measure one scene at a time.\nActors without such a tag are left alone. Exists only in game and PIE worlds."

#. Key:	SoftbodySettings
#. SourceLocation:	/Script/Softbody.SoftbodySettings [Class ToolTip meta-data]
#: /Script/Softbody.SoftbodySettings [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySettings"
msgid "Project-wide performance settings for Softbody, saved in DefaultGame.ini. How the flesh looks and moves is set on each Softbody\ncomponent."
msgstr "Project-wide performance settings for Softbody, saved in DefaultGame.ini. How the flesh looks and moves is set on each Softbody\ncomponent."

#. Key:	SoftbodySettings:bLimitContactUpdateRate
#. SourceLocation:	/Script/Softbody.SoftbodySettings:bLimitContactUpdateRate [BoolProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySettings:bLimitContactUpdateRate [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySettings:bLimitContactUpdateRate"
msgid "Recomputes each touched object's dents at most Contact Updates Per Second times a second, whatever the frame rate.\nBetween updates the dents keep their last shape, so a fast hand can leave its print behind. The first touch always updates at once."
msgstr "Recomputes each touched object's dents at most Contact Updates Per Second times a second, whatever the frame rate.\nBetween updates the dents keep their last shape, so a fast hand can leave its print behind. The first touch always updates at once."

#. Key:	SoftbodySettings:MaxContactUpdateRate
#. SourceLocation:	/Script/Softbody.SoftbodySettings:MaxContactUpdateRate [FloatProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySettings:MaxContactUpdateRate [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySettings:MaxContactUpdateRate"
msgid "How many times a second a touched object recomputes its dents when Limit Contact Update Rate is on."
msgstr "How many times a second a touched object recomputes its dents when Limit Contact Update Rate is on."

#. Key:	SoftbodySurfaceBatch
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceBatch [Class ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceBatch [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceBatch"
msgid "Gathers the contact updates of the Softbody components in this world and runs them together each frame.\nSoftbody components use it on their own. You do not need to call it."
msgstr "Gathers the contact updates of the Softbody components in this world and runs them together each frame.\nSoftbody components use it on their own. You do not need to call it."

#. Key:	SoftbodySurfaceBatch:ContactMaps
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceBatch:ContactMaps [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceBatch:ContactMaps [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceBatch:ContactMaps"
msgid "쥔 접촉 지도들과 지금 올리는 중인 요청(경로마다 하나, 바이트 어림과 함께)."
msgstr "쥔 접촉 지도들과 지금 올리는 중인 요청(경로마다 하나, 바이트 어림과 함께)."

#. Key:	SoftbodySurfaceBatch:Idle
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceBatch:Idle [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceBatch:Idle [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceBatch:Idle"
msgid "텍스처 풀의 쉬는 벌들(모두 0으로 비워져 있다)과 만드는 중인 벌들."
msgstr "텍스처 풀의 쉬는 벌들(모두 0으로 비워져 있다)과 만드는 중인 벌들."

#. Key:	SoftbodySurfaceBatch:PendingClears
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceBatch:PendingClears [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceBatch:PendingClears [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceBatch:PendingClears"
msgid "이 프레임에 돌려받아 0으로 비울 렌더 타깃(Service가 그래프 하나로 비운다)."
msgstr "이 프레임에 돌려받아 0으로 비울 렌더 타깃(Service가 그래프 하나로 비운다)."

#. Key:	SoftbodySurfaceBatch:Retiring
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceBatch:Retiring [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceBatch:Retiring [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceBatch:Retiring"
msgid "놓기로 한 렌더 타깃(프레임 예산만큼 GPU 메모리를 돌려준다)."
msgstr "놓기로 한 렌더 타깃(프레임 예산만큼 GPU 메모리를 돌려준다)."

#. Key:	SoftbodySurfaceCoarseTextures
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceCoarseTextures [ScriptStruct ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceCoarseTextures [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceCoarseTextures"
msgid "거친 격자 텍스처 한 벌(솟음 ADR-0031·끌림 ADR-0033·함몰 거친 해 일지 199가 같이 쓴다, 캐리어 칸 Block × Block이 한 칸). 가는 벌과 같이 처음 닿을 때\n풀에서 잡고 돌려준다(일지 235 — 전에는 표면 장마다 첫 갱신에 만들어 끌 때까지 쥐었다). 끌림·거친 해는 새로 잡은 첫 갱신(장이 모두 0)에 렌더 스레드가\n0으로 비우고, 거친 칸 고정 표(Info·Layer)는 그때 캐리어에서 다시 만든다 — 다른 표면 장이 쓰던 벌이어도 된다. 솟음 둘은 갱신마다 모든 칸을 새로 쓴다."
msgstr "거친 격자 텍스처 한 벌(솟음 ADR-0031·끌림 ADR-0033·함몰 거친 해 일지 199가 같이 쓴다, 캐리어 칸 Block × Block이 한 칸). 가는 벌과 같이 처음 닿을 때\n풀에서 잡고 돌려준다(일지 235 — 전에는 표면 장마다 첫 갱신에 만들어 끌 때까지 쥐었다). 끌림·거친 해는 새로 잡은 첫 갱신(장이 모두 0)에 렌더 스레드가\n0으로 비우고, 거친 칸 고정 표(Info·Layer)는 그때 캐리어에서 다시 만든다 — 다른 표면 장이 쓰던 벌이어도 된다. 솟음 둘은 갱신마다 모든 칸을 새로 쓴다."

#. Key:	SoftbodySurfaceCoarseTextures:ContactBend
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceCoarseTextures:ContactBend [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceCoarseTextures:ContactBend [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceCoarseTextures:ContactBend"
msgid "연속 굽힘의 거친 해 W_c(R32F, 모으기 패스가 쓰고 함몰 창이 읽는다 — 굽는 칸이 없으면 쓰지 않는다)."
msgstr "연속 굽힘의 거친 해 W_c(R32F, 모으기 패스가 쓰고 함몰 창이 읽는다 — 굽는 칸이 없으면 쓰지 않는다)."

#. Key:	SoftbodySurfaceField
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField [Class ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField"
msgid "ADR-0003 표면 캐리어 접촉장의 GPU 상태. 캐리어 아틀라스와 같은 크기의 RT에 함몰(막 평형)을 유지하고\n매 틱 글로벌 컴퓨트 셰이더로 갱신한다. 머티리얼은 렌더 정점의 캐리어 UV로 결과 RT 두 장을 읽는다.\n  GetDisplacementTexture: RGB 프레임 공간 변위(cm, 함몰 − 둘레 솟음 + 끌림), A 콜라이더 가장자리까지 부호 거리 + 2(칸 수, ADR-0029).\n  GetNormalTexture: RGB 노멀 기울기 회전(축 × sin, 프레임), A 함몰 어둡기(0 = 그대로).\n  GetLumpNormalTexture(덩어리가 있을 때): RGB 덩어리 이동이 기울인 노멀 회전, A 덩어리 이동의 노멀 성분(cm, ADR-0018)."
msgstr "ADR-0003 표면 캐리어 접촉장의 GPU 상태. 캐리어 아틀라스와 같은 크기의 RT에 함몰(막 평형)을 유지하고\n매 틱 글로벌 컴퓨트 셰이더로 갱신한다. 머티리얼은 렌더 정점의 캐리어 UV로 결과 RT 두 장을 읽는다.\n  GetDisplacementTexture: RGB 프레임 공간 변위(cm, 함몰 − 둘레 솟음 + 끌림), A 콜라이더 가장자리까지 부호 거리 + 2(칸 수, ADR-0029).\n  GetNormalTexture: RGB 노멀 기울기 회전(축 × sin, 프레임), A 함몰 어둡기(0 = 그대로).\n  GetLumpNormalTexture(덩어리가 있을 때): RGB 덩어리 이동이 기울인 노멀 회전, A 덩어리 이동의 노멀 성분(cm, ADR-0018)."

#. Key:	SoftbodySurfaceField:Accepted
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:Accepted [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:Accepted [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:Accepted"
msgid "살이 받아들인 깊이(cm, ADR-0003 §14). 함몰은 이 깊이까지만 돌아간다. 오래 누를수록 함몰을 따라 깊어지고, 떼면 천천히\n0으로 돌아간다. 이완 패스가 제자리에서 갱신한다."
msgstr "살이 받아들인 깊이(cm, ADR-0003 §14). 함몰은 이 깊이까지만 돌아간다. 오래 누를수록 함몰을 따라 깊어지고, 떼면 천천히\n0으로 돌아간다. 이완 패스가 제자리에서 갱신한다."

#. Key:	SoftbodySurfaceField:CaptureCopies
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:CaptureCopies [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:CaptureCopies [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:CaptureCopies"
msgid "디버그 캡처(Softbody.CaptureField): 요청 뒤 실제로 돈 첫 갱신 끝에 뜬 사본(차례 SoftbodyCapture::ECopy). 접촉 텍스처는 임시라 지난 값이 없고, 나머지\n장도 저장할 때 읽으면 사본을 뜬 뒤 돈 갱신의 값이라 한 폴더에 두 순간이 섞였다. 요청한 동안만 있고 캡처 뒤 지운다."
msgstr "디버그 캡처(Softbody.CaptureField): 요청 뒤 실제로 돈 첫 갱신 끝에 뜬 사본(차례 SoftbodyCapture::ECopy). 접촉 텍스처는 임시라 지난 값이 없고, 나머지\n장도 저장할 때 읽으면 사본을 뜬 뒤 돈 갱신의 값이라 한 폴더에 두 순간이 섞였다. 요청한 동안만 있고 캡처 뒤 지운다."

#. Key:	SoftbodySurfaceField:CoarseInfo
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:CoarseInfo [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:CoarseInfo [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:CoarseInfo"
msgid "솟음 거친 칸의 고정 표(CoarseInitCS가 캐리어에서 한 번 만든다): Info xyz 살 칸 정지 위치 평균(메시 로컬), w 칸 넓이(메시 로컬², 0 =\n살 없는 칸). Layer x 두께 평균, y 렌더 삼각형 변 평균(메시 로컬)."
msgstr "솟음 거친 칸의 고정 표(CoarseInitCS가 캐리어에서 한 번 만든다): Info xyz 살 칸 정지 위치 평균(메시 로컬), w 칸 넓이(메시 로컬², 0 =\n살 없는 칸). Layer x 두께 평균, y 렌더 삼각형 변 평균(메시 로컬)."

#. Key:	SoftbodySurfaceField:ContactBend
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:ContactBend [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:ContactBend [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:ContactBend"
msgid "연속 굽힘의 거친 해 W_c(cm, R32F — 거친 벌에서 ContactLong과 같이 잡는다)."
msgstr "연속 굽힘의 거친 해 W_c(cm, R32F — 거친 벌에서 ContactLong과 같이 잡는다)."

#. Key:	SoftbodySurfaceField:ContactLong
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:ContactLong [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:ContactLong [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:ContactLong"
msgid "접촉 압력(ADR-0037) 거친 격자(캐리어 칸 SpreadBlock × SpreadBlock이 한 칸): 거친 칸마다 (긴 몫 L — 살층 응답이 둘레로 올리는 몫(cm), 거친 압력 p)\nRG32F. 접촉 단계 Full의 갱신마다 모든 칸에 새로 쓴다."
msgstr "접촉 압력(ADR-0037) 거친 격자(캐리어 칸 SpreadBlock × SpreadBlock이 한 칸): 거친 칸마다 (긴 몫 L — 살층 응답이 둘레로 올리는 몫(cm), 거친 압력 p)\nRG32F. 접촉 단계 Full의 갱신마다 모든 칸에 새로 쓴다."

#. Key:	SoftbodySurfaceField:ContactMapRefs
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:ContactMapRefs [ArrayProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:ContactMapRefs [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:ContactMapRefs"
msgid "접촉 지도 텍스처(일지 222): Mesh Data는 캐리어·거리표 텍스처를 약한 참조로 쥐어, 켜진 표면 장이 있을 때만 메모리에 있다. Initialize가 비동기로\n올리고(이미 있으면 바로) 다 올라오면 여기 쥔다 — 이 장이 사라지면(Shutdown·GC) 쥔 것이 없는 텍스처는 다음 GC에 내려간다."
msgstr "접촉 지도 텍스처(일지 222): Mesh Data는 캐리어·거리표 텍스처를 약한 참조로 쥐어, 켜진 표면 장이 있을 때만 메모리에 있다. Initialize가 비동기로\n올리고(이미 있으면 바로) 다 올라오면 여기 쥔다 — 이 장이 사라지면(Shutdown·GC) 쥔 것이 없는 텍스처는 다음 GC에 내려간다."

#. Key:	SoftbodySurfaceField:DentCoarse
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:DentCoarse [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:DentCoarse [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:DentCoarse"
msgid "함몰 거친 해(일지 199): 거친 칸마다 함몰(cm, R32F, 끌림 격자와 같은 크기) — 갱신을 넘어 남는다(렌더 스레드가 처음 0으로 비운다)."
msgstr "함몰 거친 해(일지 199): 거친 칸마다 함몰(cm, R32F, 끌림 격자와 같은 크기) — 갱신을 넘어 남는다(렌더 스레드가 처음 0으로 비운다)."

#. Key:	SoftbodySurfaceField:Displacement
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:Displacement [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:Displacement [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:Displacement"
msgid "머티리얼이 읽는 최종 변위."
msgstr "머티리얼이 읽는 최종 변위."

#. Key:	SoftbodySurfaceField:DragState
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:DragState [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:DragState [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:DragState"
msgid "끌림 거친 격자(일지 161, ADR-0033) = 솟음 거친 격자(캐리어 칸 SpreadBlock × SpreadBlock이 한 칸). State xyz 끌림(프레임 cm), w = 지난 갱신에\n눌렸으면 1 + 덮인 몫, 아니면 0. Hold = 붙든 자리와 끌림의 차(눌린 칸만)와 끄는 힘 Q(원천 칸, 뗀 칸은 줄어드는 기억)를 반정밀도로\n묶은 것(셰이더 SB_DragPackHold, 일지 184 — 일지 183의 Pull을 합쳤다) — 둘 다 갱신을 넘어 남는다(표면 장이 처음 돌 때 0으로 비운다).\n이웃 표(DragLinksCS)는 캐리어로만 정해지는 표라 칸 종류 표처럼 렌더 스레드의 쉬기 상태(RestState)가 쥔다."
msgstr "끌림 거친 격자(일지 161, ADR-0033) = 솟음 거친 격자(캐리어 칸 SpreadBlock × SpreadBlock이 한 칸). State xyz 끌림(프레임 cm), w = 지난 갱신에\n눌렸으면 1 + 덮인 몫, 아니면 0. Hold = 붙든 자리와 끌림의 차(눌린 칸만)와 끄는 힘 Q(원천 칸, 뗀 칸은 줄어드는 기억)를 반정밀도로\n묶은 것(셰이더 SB_DragPackHold, 일지 184 — 일지 183의 Pull을 합쳤다) — 둘 다 갱신을 넘어 남는다(표면 장이 처음 돌 때 0으로 비운다).\n이웃 표(DragLinksCS)는 캐리어로만 정해지는 표라 칸 종류 표처럼 렌더 스레드의 쉬기 상태(RestState)가 쥔다."

#. Key:	SoftbodySurfaceField:Hold
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:Hold [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:Hold [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:Hold"
msgid "누른 자리 기억 F(cm, 한 채널, ADR-0032): 칸마다 max(이번 누른 깊이, 지난 F × e^{−R·Δt}). 함몰은 피부를 max(F, 받아들인 깊이)에 붙든\n살층의 정적 해다. 함몰 둘째 패스가 제자리에서 갱신한다."
msgstr "누른 자리 기억 F(cm, 한 채널, ADR-0032): 칸마다 max(이번 누른 깊이, 지난 F × e^{−R·Δt}). 함몰은 피부를 max(F, 받아들인 깊이)에 붙든\n살층의 정적 해다. 함몰 둘째 패스가 제자리에서 갱신한다."

#. Key:	SoftbodySurfaceField:Labels
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:Labels [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:Labels [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:Labels"
msgid "들어온 면 표지(일지 313·314): 칸마다 콜라이더 둘까지 \"이 콜라이더는 이 면으로, 이 방향으로 들어왔다\". 접촉 패스가 사건(콜라이더가 쉬는 피부 점을\n품거나 한 갱신에 지나 들어감)에서 달고, 그 점이 들어온 방향으로 더는 콜라이더 밑이 아니면 지운다. 다음 갱신의 접촉 패스가 같은 칸에서 제자리로 읽는다."
msgstr "들어온 면 표지(일지 313·314): 칸마다 콜라이더 둘까지 \"이 콜라이더는 이 면으로, 이 방향으로 들어왔다\". 접촉 패스가 사건(콜라이더가 쉬는 피부 점을\n품거나 한 갱신에 지나 들어감)에서 달고, 그 점이 들어온 방향으로 더는 콜라이더 밑이 아니면 지운다. 다음 갱신의 접촉 패스가 같은 칸에서 제자리로 읽는다."

#. Key:	SoftbodySurfaceField:LumpAnchor
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:LumpAnchor [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:LumpAnchor [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:LumpAnchor"
msgid "손 닻(일지 201): 눌린 칸마다 \"덩어리가 안 움직였다면 손이 이 칸의 피부를 끌고 간 자리\"(덩어리 기본 자세 축 접선 두 성분, cm, RG32F — 반정밀도는\n손 움직임을 프레임마다 더해 쌓는 값이라 표류한다). 접촉 패스가 읽고 덩어리 힘 패스 첫 걸음이 마찰 한도 안으로 잘라 쓴다. 덩어리 값이 있는\n캐리어만 만든다(LumpNormal과 같은 벌)."
msgstr "손 닻(일지 201): 눌린 칸마다 \"덩어리가 안 움직였다면 손이 이 칸의 피부를 끌고 간 자리\"(덩어리 기본 자세 축 접선 두 성분, cm, RG32F — 반정밀도는\n손 움직임을 프레임마다 더해 쌓는 값이라 표류한다). 접촉 패스가 읽고 덩어리 힘 패스 첫 걸음이 마찰 한도 안으로 잘라 쓴다. 덩어리 값이 있는\n캐리어만 만든다(LumpNormal과 같은 벌)."

#. Key:	SoftbodySurfaceField:LumpNormal
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:LumpNormal [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:LumpNormal [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:LumpNormal"
msgid "덩어리 노멀(ADR-0018): 접촉 패스가 매 프레임 쓴다. 덩어리 값이 있는 캐리어만 만든다."
msgstr "덩어리 노멀(ADR-0018): 접촉 패스가 매 프레임 쓴다. 덩어리 값이 있는 캐리어만 만든다."

#. Key:	SoftbodySurfaceField:Normal
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:Normal [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:Normal [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:Normal"
msgid "머티리얼이 읽는 노멀 회전과 함몰 어둡기."
msgstr "머티리얼이 읽는 노멀 회전과 함몰 어둡기."

#. Key:	SoftbodySurfaceField:Position
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:Position [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:Position [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:Position"
msgid "접촉 패스 결과: xyz 현재 피부 위치(프레임 cm), w 1 + 누른 것 번호(안 눌리면 1). 이웃 칸 차분용이라 32비트. 다음 갱신의 접촉 패스가\n덮어쓰기 전에 지난 위치와 지난 눌림으로 읽는다(끌림)."
msgstr "접촉 패스 결과: xyz 현재 피부 위치(프레임 cm), w 1 + 누른 것 번호(안 눌리면 1). 이웃 칸 차분용이라 32비트. 다음 갱신의 접촉 패스가\n덮어쓰기 전에 지난 위치와 지난 눌림으로 읽는다(끌림)."

#. Key:	SoftbodySurfaceField:PreviousDisplacement
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:PreviousDisplacement [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:PreviousDisplacement [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:PreviousDisplacement"
msgid "지난 갱신의 최종 변위. 갱신마다 새 변위를 쓰기 전에 복사해 둔다. 머티리얼의 지난 프레임 계산(속도 버퍼)이 읽어서, 눌린\n살이 움직이는 만큼 TSR·모션 블러가 속도를 안다 — 없으면 움직이는 함몰에 잔상이 남는다."
msgstr "지난 갱신의 최종 변위. 갱신마다 새 변위를 쓰기 전에 복사해 둔다. 머티리얼의 지난 프레임 계산(속도 버퍼)이 읽어서, 눌린\n살이 움직이는 만큼 TSR·모션 블러가 속도를 안다 — 없으면 움직이는 함몰에 잔상이 남는다."

#. Key:	SoftbodySurfaceField:StateA
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceField:StateA [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceField:StateA [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceField:StateA"
msgid "함몰 u(cm, 한 채널). 갱신마다 함몰 두 패스가 임시 텍스처에 풀고 끌림 마지막 패스가 A로 옮긴다 — 갱신이 끝나면 늘 A에 있다(다음 갱신의\n출발 값, ADR-0032). 끌림은 거친 격자(DragState)에 있다(일지 161)."
msgstr "함몰 u(cm, 한 채널). 갱신마다 함몰 두 패스가 임시 텍스처에 풀고 끌림 마지막 패스가 A로 옮긴다 — 갱신이 끝나면 늘 A에 있다(다음 갱신의\n출발 값, ADR-0032). 끌림은 거친 격자(DragState)에 있다(일지 161)."

#. Key:	SoftbodySurfaceTextures
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceTextures [ScriptStruct ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceTextures [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceTextures"
msgid "표면 장이 갱신을 넘어 쥐고 있는 텍스처 한 벌(ADR-0022). 처음 닿을 때 월드 풀(USoftbodySurfaceBatch)에서 잡고, 콜라이더 없이\n복원이 끝나면 0으로 비워 돌려준다 — 메모리는 배치한 인스턴스 수가 아니라 닿은 수에 비례한다. 1024² 덩어리 캐릭터 한 벌 약 60 MB(함몰과 누른 자리 기억이 한 채널씩, 일지 161·ADR-0032).\n풀은 한 벌을 프레임 예산만큼 한 장씩 만든다(CreateNextTarget) — 한 프레임에 몰아 만들면 렌더 스레드와 GPU가 멈칫한다(일지 235)."
msgstr "표면 장이 갱신을 넘어 쥐고 있는 텍스처 한 벌(ADR-0022). 처음 닿을 때 월드 풀(USoftbodySurfaceBatch)에서 잡고, 콜라이더 없이\n복원이 끝나면 0으로 비워 돌려준다 — 메모리는 배치한 인스턴스 수가 아니라 닿은 수에 비례한다. 1024² 덩어리 캐릭터 한 벌 약 60 MB(함몰과 누른 자리 기억이 한 채널씩, 일지 161·ADR-0032).\n풀은 한 벌을 프레임 예산만큼 한 장씩 만든다(CreateNextTarget) — 한 프레임에 몰아 만들면 렌더 스레드와 GPU가 멈칫한다(일지 235)."

#. Key:	SoftbodySurfaceTextures:Labels
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceTextures:Labels [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceTextures:Labels [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceTextures:Labels"
msgid "들어온 면 표지(일지 313, R32F). 1024²에서 4 MB."
msgstr "들어온 면 표지(일지 313, R32F). 1024²에서 4 MB."

#. Key:	SoftbodySurfaceTextures:LumpAnchor
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceTextures:LumpAnchor [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceTextures:LumpAnchor [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceTextures:LumpAnchor"
msgid "손 닻(일지 201, RG32F): 덩어리 값이 있는 캐리어만. 1024²에서 8 MB."
msgstr "손 닻(일지 201, RG32F): 덩어리 값이 있는 캐리어만. 1024²에서 8 MB."

#. Key:	SoftbodySurfaceTextures:LumpNormal
#. SourceLocation:	/Script/Softbody.SoftbodySurfaceTextures:LumpNormal [ObjectProperty ToolTip meta-data]
#: /Script/Softbody.SoftbodySurfaceTextures:LumpNormal [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySurfaceTextures:LumpNormal"
msgid "덩어리 값이 있는 캐리어만."
msgstr "덩어리 값이 있는 캐리어만."

#. Key:	AssetDefinition_SoftbodyAuthoringData
#. SourceLocation:	/Script/SoftbodyEditor.AssetDefinition_SoftbodyAuthoringData [Class ToolTip meta-data]
#: /Script/SoftbodyEditor.AssetDefinition_SoftbodyAuthoringData [Class ToolTip meta-data]
msgctxt "UObjectToolTips,AssetDefinition_SoftbodyAuthoringData"
msgid "Registers Softbody Authoring Data with the Content Browser.\n\nThe factory alone is not sufficient in UE 5.8: AssetTools filters new-asset\nfactories whose supported class has no Asset Definition or Asset Type Actions."
msgstr "Registers Softbody Authoring Data with the Content Browser.\n\nThe factory alone is not sufficient in UE 5.8: AssetTools filters new-asset\nfactories whose supported class has no Asset Definition or Asset Type Actions."

#. Key:	ESoftbodyBoneRole
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyBoneRole [Enum ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyBoneRole [Enum ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyBoneRole"
msgid "What a listed bone is in the body."
msgstr "What a listed bone is in the body."

#. Key:	ESoftbodyBoneRole.Accessory
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyBoneRole:Accessory [EnumEntry ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyBoneRole:Accessory [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyBoneRole.Accessory"
msgid "For ribbons, necklaces and belts that lie on the body. It is neither bone nor a lump, and it moves with the flesh it lies on."
msgstr "For ribbons, necklaces and belts that lie on the body. It is neither bone nor a lump, and it moves with the flesh it lies on."

#. Key:	ESoftbodyBoneRole.Bone
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyBoneRole:Bone [EnumEntry ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyBoneRole:Bone [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyBoneRole.Bone"
msgid "For bones inside the flesh, like arms and the spine. There is bone here as thick as Bone Thickness."
msgstr "For bones inside the flesh, like arms and the spine. There is bone here as thick as Bone Thickness."

#. Key:	ESoftbodyBoneRole.Lump
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyBoneRole:Lump [EnumEntry ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyBoneRole:Lump [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyBoneRole.Lump"
msgid "For breast and buttock bones. There is no bone inside, and the flesh it carries moves out of the way as a whole when pressed."
msgstr "For breast and buttock bones. There is no bone inside, and the flesh it carries moves out of the way as a whole when pressed."

#. Key:	ESoftbodyMaskSource
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyMaskSource [Enum ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyMaskSource [Enum ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyMaskSource"
msgid "Where one kind of paint is read from inside the bake."
msgstr "Where one kind of paint is read from inside the bake."

#. Key:	ESoftbodyPaintFill
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyPaintFill [Enum ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyPaintFill [Enum ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyPaintFill"
msgid "How one channel of a slot's paint is filled."
msgstr "How one channel of a slot's paint is filled."

#. Key:	ESoftbodyPaintFill.Texture
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyPaintFill:Texture [EnumEntry ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyPaintFill:Texture [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyPaintFill.Texture"
msgid "Read this channel from the slot's Paint Texture. With no texture it is white (unpainted)."
msgstr "Read this channel from the slot's Paint Texture. With no texture it is white (unpainted)."

#. Key:	ESoftbodyStaticCore
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyStaticCore [Enum ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyStaticCore [Enum ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyStaticCore"
msgid "Which part of a static mesh stays still while the rest dents and jiggles."
msgstr "Which part of a static mesh stays still while the rest dents and jiggles."

#. Key:	ESoftbodyStaticCore.Bottom
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyStaticCore:Bottom [EnumEntry ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyStaticCore:Bottom [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyStaticCore.Bottom"
msgid "Rests on a floor or a seat, like a cushion or a pudding. Only the bottom is held."
msgstr "Rests on a floor or a seat, like a cushion or a pudding. Only the bottom is held."

#. Key:	ESoftbodyStaticCore.Center
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyStaticCore:Center [EnumEntry ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyStaticCore:Center [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyStaticCore.Center"
msgid "Firm in the middle and soft toward the surface, like a ball or a toy. A core like a bone runs through the middle of the shape, as thick as Bone Thickness."
msgstr "Firm in the middle and soft toward the surface, like a ball or a toy. A core like a bone runs through the middle of the shape, as thick as Bone Thickness."

#. Key:	ESoftbodyStaticCore.Custom
#. SourceLocation:	/Script/SoftbodyEditor.ESoftbodyStaticCore:Custom [EnumEntry ToolTip meta-data]
#: /Script/SoftbodyEditor.ESoftbodyStaticCore:Custom [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,ESoftbodyStaticCore.Custom"
msgid "Spheres you place yourself in Rigid Core Spheres."
msgstr "Spheres you place yourself in Rigid Core Spheres."

#. Key:	SoftbodyAuthoringData
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData [Class ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData"
msgid "Everything needed to make one mesh soft. Set Target Mesh and the settings, then press Run Bake. The result is the Baked Data asset\nthat the Softbody component uses. This asset is editor-only and is not packaged."
msgstr "Everything needed to make one mesh soft. Set Target Mesh and the settings, then press Run Bake. The result is the Baked Data asset\nthat the Softbody component uses. This asset is editor-only and is not packaged."

#. Key:	SoftbodyAuthoringData:BakedData
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:BakedData [ObjectProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:BakedData [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:BakedData"
msgid "The baked result. Run Bake fills it in; put this asset in the Softbody component's Mesh Data."
msgstr "The baked result. Run Bake fills it in; put this asset in the Softbody component's Mesh Data."

#. Key:	SoftbodyAuthoringData:bBakeColliderField
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:bBakeColliderField [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:bBakeColliderField [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:bBakeColliderField"
msgid "Bakes this mesh's real shape so it presses other Softbody meshes with that shape instead of its simple collision or physics asset.\nOn a skeletal mesh the Self Contact Bones also press the character's own flesh. The shape field is stored on the Target Mesh."
msgstr "Bakes this mesh's real shape so it presses other Softbody meshes with that shape instead of its simple collision or physics asset.\nOn a skeletal mesh the Self Contact Bones also press the character's own flesh. The shape field is stored on the Target Mesh."

#. Key:	SoftbodyAuthoringData:bBakeSurfaceCarrier
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:bBakeSurfaceCarrier [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:bBakeSurfaceCarrier [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:bBakeSurfaceCarrier"
msgid "Bakes the contact map: the grid on the surface where dents, bulges and drag are worked out. Without it the mesh only jiggles."
msgstr "Bakes the contact map: the grid on the surface where dents, bulges and drag are worked out. Without it the mesh only jiggles."

#. Key:	SoftbodyAuthoringData:bConfigureNaniteTessellation
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:bConfigureNaniteTessellation [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:bConfigureNaniteTessellation [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:bConfigureNaniteTessellation"
msgid "Sets the mesh up to draw with Nanite tessellation, so narrow dents such as fingertips appear between vertices on a low-density mesh.\nIt changes the mesh and all of its slot materials. Fails if a slot is translucent. Nanite ignores morph targets on skeletal meshes."
msgstr "Sets the mesh up to draw with Nanite tessellation, so narrow dents such as fingertips appear between vertices on a low-density mesh.\nIt changes the mesh and all of its slot materials. Fails if a slot is translucent. Nanite ignores morph targets on skeletal meshes."

#. Key:	SoftbodyAuthoringData:bCreateSoftbodyMaterial
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:bCreateSoftbodyMaterial [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:bCreateSoftbodyMaterial [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:bCreateSoftbodyMaterial"
msgid "Run Bake also puts an instance of the plugin's example material on each of the Softbody Material Slots.\nIt copies only the base color, normal and roughness textures. Leave it off if your master material has the Softbody functions."
msgstr "Run Bake also puts an instance of the plugin's example material on each of the Softbody Material Slots.\nIt copies only the base color, normal and roughness textures. Leave it off if your master material has the Softbody functions."

#. Key:	SoftbodyAuthoringData:bLegacyPaintLayout
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:bLegacyPaintLayout [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:bLegacyPaintLayout [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:bLegacyPaintLayout"
msgid "True while the slot paint still uses the layout from before the fixed paint layout."
msgstr "True while the slot paint still uses the layout from before the fixed paint layout."

#. Key:	SoftbodyAuthoringData:bSaveAfterBake
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:bSaveAfterBake [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:bSaveAfterBake [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:bSaveAfterBake"
msgid "Saves what the bake changed as soon as it finishes: the baked assets, the target mesh, the materials it wired and this asset.\nOther assets that already had unsaved changes before the bake are left for you to save."
msgstr "Saves what the bake changed as soon as it finishes: the baked assets, the target mesh, the materials it wired and this asset.\nOther assets that already had unsaved changes before the bake are left for you to save."

#. Key:	SoftbodyAuthoringData:bStaticTarget
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:bStaticTarget [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:bStaticTarget [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:bStaticTarget"
msgid "개발: 디테일 패널에서 스태틱 메시에만 쓰는 값과 스켈레탈에만 쓰는 값을 가르는 표지(저장 안 함, 일지 231). 대상이 바뀌거나 에셋을 읽을 때 정한다."
msgstr "개발: 디테일 패널에서 스태틱 메시에만 쓰는 값과 스켈레탈에만 쓰는 값을 가르는 표지(저장 안 함, 일지 231). 대상이 바뀌거나 에셋을 읽을 때 정한다."

#. Key:	SoftbodyAuthoringData:CarrierCharts
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierCharts [EnumProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierCharts [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:CarrierCharts"
msgid "Where the contact map is split into pieces. Dents are slightly less exact across a split, so by default it follows the UV0 seams\nthe artist already hid on the mesh."
msgstr "Where the contact map is split into pieces. Dents are slightly less exact across a split, so by default it follows the UV0 seams\nthe artist already hid on the mesh."

#. Key:	SoftbodyAuthoringData:CarrierEnvelopeCellSize
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierEnvelopeCellSize [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierEnvelopeCellSize [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:CarrierEnvelopeCellSize"
msgid "Advanced: cell size (cm, mesh space) for finding the mesh's outer surface. 0 = automatic (longest side / 256)."
msgstr "Advanced: cell size (cm, mesh space) for finding the mesh's outer surface. 0 = automatic (longest side / 256)."

#. Key:	SoftbodyAuthoringData:CarrierEnvelopeSlots
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierEnvelopeSlots [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierEnvelopeSlots [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:CarrierEnvelopeSlots"
msgid "The material slots that can be pressed. Empty = the slots that use a Softbody material (or the whole mesh if none do yet). Leaving\nout slots that are never pressed, such as the face or hair, gives the pressable slots more detail."
msgstr "The material slots that can be pressed. Empty = the slots that use a Softbody material (or the whole mesh if none do yet). Leaving\nout slots that are never pressed, such as the face or hair, gives the pressable slots more detail."

#. Key:	SoftbodyAuthoringData:CarrierMaxThickness
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierMaxThickness [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierMaxThickness [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:CarrierMaxThickness"
msgid "Upper limit on flesh thickness (cm, mesh space): deeper than this from the surface counts as solid. 0 = no limit.\nUse it on boxes and cushions whose core sits only at the bottom, so pressing the top does not dent the sides."
msgstr "Upper limit on flesh thickness (cm, mesh space): deeper than this from the surface counts as solid. 0 = no limit.\nUse it on boxes and cushions whose core sits only at the bottom, so pressing the top does not dent the sides."

#. Key:	SoftbodyAuthoringData:CarrierResolution
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierResolution [IntProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierResolution [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:CarrierResolution"
msgid "Cells along one side of the contact map (a power of two, 64 to 2048). Higher = sharper small dents but more GPU time and memory."
msgstr "Cells along one side of the contact map (a power of two, 64 to 2048). Higher = sharper small dents but more GPU time and memory."

#. Key:	SoftbodyAuthoringData:CarrierTargetTriangles
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierTargetTriangles [IntProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:CarrierTargetTriangles [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:CarrierTargetTriangles"
msgid "Advanced: triangle count of the simplified outer surface. Raise it if flesh thickness on large curved areas looks stepped."
msgstr "Advanced: triangle count of the simplified outer surface. Raise it if flesh thickness on large curved areas looks stepped."

#. Key:	SoftbodyAuthoringData:CellSizeFrac
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:CellSizeFrac [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:CellSizeFrac [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:CellSizeFrac"
msgid "How finely the flesh is measured, as a fraction of the mesh's longest side.\nSmaller = more detail in how soft each area is, but a slower bake."
msgstr "How finely the flesh is measured, as a fraction of the mesh's longest side.\nSmaller = more detail in how soft each area is, but a slower bake."

#. Key:	SoftbodyAuthoringData:ColliderFieldPartOverlap
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:ColliderFieldPartOverlap [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:ColliderFieldPartOverlap [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:ColliderFieldPartOverlap"
msgid "Advanced, skeletal meshes: how far (cm) each bone's part of the shape reaches into its neighbor's. 0 = no overlap.\nToo little shows grooves at the finger joints in the dent."
msgstr "Advanced, skeletal meshes: how far (cm) each bone's part of the shape reaches into its neighbor's. 0 = no overlap.\nToo little shows grooves at the finger joints in the dent."

#. Key:	SoftbodyAuthoringData:ColliderFieldVoxelSize
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:ColliderFieldVoxelSize [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:ColliderFieldVoxelSize [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:ColliderFieldVoxelSize"
msgid "Advanced: cell size of the shape field (cm, mesh space). 0 = automatic (fine enough for fingers)."
msgstr "Advanced: cell size of the shape field (cm, mesh space). 0 = automatic (fine enough for fingers)."

#. Key:	SoftbodyAuthoringData:ConvertLegacyPaint
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:ConvertLegacyPaint [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:ConvertLegacyPaint [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:ConvertLegacyPaint"
msgid "Moves slot paint made before the fixed paint layout into that layout (R Depth, G Jiggle, B Volume and A Flex). Returns true if anything moved."
msgstr "Moves slot paint made before the fixed paint layout into that layout (R Depth, G Jiggle, B Volume and A Flex). Returns true if anything moved."

#. Key:	SoftbodyAuthoringData:DefaultRigidShrink
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:DefaultRigidShrink [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:DefaultRigidShrink [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:DefaultRigidShrink"
msgid "Skeletal meshes and Core Placement Center: how thick the bones or the core are, as a fraction of the distance to the skin.\nLarger = thinner flesh that jiggles less and dents narrower. Paint bones the skeleton lacks (ribs, pelvis, skull) dark in Depth."
msgstr "Skeletal meshes and Core Placement Center: how thick the bones or the core are, as a fraction of the distance to the skin.\nLarger = thinner flesh that jiggles less and dents narrower. Paint bones the skeleton lacks (ribs, pelvis, skull) dark in Depth."

#. Key:	SoftbodyAuthoringData:FleshReach
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:FleshReach [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:FleshReach [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:FleshReach"
msgid "Flesh thicker than this (cm) does not jiggle more for being thicker, so areas with the same Jiggle paint jiggle about the same.\n0 = off: the deepest flesh jiggles the most, so a belly with no bone inside jiggles far more than a chest painted the same."
msgstr "Flesh thicker than this (cm) does not jiggle more for being thicker, so areas with the same Jiggle paint jiggle about the same.\n0 = off: the deepest flesh jiggles the most, so a belly with no bone inside jiggles far more than a chest painted the same."

#. Key:	SoftbodyAuthoringData:GetMaterialSlotNameOptions
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:GetMaterialSlotNameOptions [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:GetMaterialSlotNameOptions [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:GetMaterialSlotNameOptions"
msgid "The material slot names of the target mesh, for the slot dropdowns."
msgstr "The material slot names of the target mesh, for the slot dropdowns."

#. Key:	SoftbodyAuthoringData:GetSkeletonBoneNames
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:GetSkeletonBoneNames [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:GetSkeletonBoneNames [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:GetSkeletonBoneNames"
msgid "The bone names of the target mesh's skeleton, for the bone dropdowns."
msgstr "The bone names of the target mesh's skeleton, for the bone dropdowns."

#. Key:	SoftbodyAuthoringData:LastValidationErrors
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:LastValidationErrors [IntProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:LastValidationErrors [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:LastValidationErrors"
msgid "Problems found by the last Validate. 0 = all good. -1 = not checked since the last bake. Details are in the Output Log."
msgstr "Problems found by the last Validate. 0 = all good. -1 = not checked since the last bake. Details are in the Output Log."

#. Key:	SoftbodyAuthoringData:LayerMaxGap
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:LayerMaxGap [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:LayerMaxGap [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:LayerMaxGap"
msgid "For cloth on the skin: a cloth vertex with skin within this distance (cm) under it takes that flesh's Depth, Jiggle and Volume paint.\nIt jiggles with that flesh, and cloth farther than half this distance follows less. 0 = off. Denting with the cloth does not use it."
msgstr "For cloth on the skin: a cloth vertex with skin within this distance (cm) under it takes that flesh's Depth, Jiggle and Volume paint.\nIt jiggles with that flesh, and cloth farther than half this distance follows less. 0 = off. Denting with the cloth does not use it."

#. Key:	SoftbodyAuthoringData:MaxInertiaGroups
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:MaxInertiaGroups [IntProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:MaxInertiaGroups [IntProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:MaxInertiaGroups"
msgid "Skeletal meshes: how many bone groups can jiggle separately (each group gets its own entry in Inertia Group Overrides)."
msgstr "Skeletal meshes: how many bone groups can jiggle separately (each group gets its own entry in Inertia Group Overrides)."

#. Key:	SoftbodyAuthoringData:NaniteDisplacementCenter
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:NaniteDisplacementCenter [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:NaniteDisplacementCenter [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:NaniteDisplacementCenter"
msgid "Where that range sits (0 to 1). 0.75 = three quarters of it inward for dents, one quarter outward for bulges."
msgstr "Where that range sits (0 to 1). 0.75 = three quarters of it inward for dents, one quarter outward for bulges."

#. Key:	SoftbodyAuthoringData:NaniteDisplacementMagnitude
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:NaniteDisplacementMagnitude [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:NaniteDisplacementMagnitude [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:NaniteDisplacementMagnitude"
msgid "The depth range (cm) that tessellation can draw. Dents and bulges beyond it are cut off."
msgstr "The depth range (cm) that tessellation can draw. Dents and bulges beyond it are cut off."

#. Key:	SoftbodyAuthoringData:NaniteMaxWorldPositionOffset
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:NaniteMaxWorldPositionOffset [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:NaniteMaxWorldPositionOffset [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:NaniteMaxWorldPositionOffset"
msgid "How far (cm) Nanite expects vertices to move. Must be more than the largest dent plus jiggle, or the movement is cut off."
msgstr "How far (cm) Nanite expects vertices to move. Must be more than the largest dent plus jiggle, or the movement is cut off."

#. Key:	SoftbodyAuthoringData:OutputFolder
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:OutputFolder [StrProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:OutputFolder [StrProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:OutputFolder"
msgid "Where the baked assets are written. Empty = the folder of this asset."
msgstr "Where the baked assets are written. Empty = the folder of this asset."

#. Key:	SoftbodyAuthoringData:PhysicsDrivenBones
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:PhysicsDrivenBones [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:PhysicsDrivenBones [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:PhysicsDrivenBones"
msgid "Bones already moved by another jiggle system, such as KawaiiPhysics or simulated physics bodies.\nFlesh skinned to them and the bones below gets no Softbody jiggle, or less where only partly weighted. Applied with Reapply Paint."
msgstr "Bones already moved by another jiggle system, such as KawaiiPhysics or simulated physics bodies.\nFlesh skinned to them and the bones below gets no Softbody jiggle, or less where only partly weighted. Applied with Reapply Paint."

#. Key:	SoftbodyAuthoringData:PresserBones
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:PresserBones [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:PresserBones [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:PresserBones"
msgid "Skeletal meshes: the bones (child bones included) that also press the character's own flesh, such as hand_l and hand_r.\nEmpty = every bone presses, for a mesh that only presses, such as a hand mesh. Other Softbody meshes are pressed by the whole body."
msgstr "Skeletal meshes: the bones (child bones included) that also press the character's own flesh, such as hand_l and hand_r.\nEmpty = every bone presses, for a mesh that only presses, such as a hand mesh. Other Softbody meshes are pressed by the whole body."

#. Key:	SoftbodyAuthoringData:PreviewRigidCore
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:PreviewRigidCore [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:PreviewRigidCore [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:PreviewRigidCore"
msgid "The rigid core Run Bake would hold still with the current settings, as spheres in mesh space: xyz is the center and w the radius (cm).\nOut Status describes the core, or what is wrong when Out Problem is true."
msgstr "The rigid core Run Bake would hold still with the current settings, as spheres in mesh space: xyz is the center and w the radius (cm).\nOut Status describes the core, or what is wrong when Out Problem is true."

#. Key:	SoftbodyAuthoringData:RigidBoneOverrides
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:RigidBoneOverrides [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:RigidBoneOverrides [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:RigidBoneOverrides"
msgid "For bones skinned to Softbody slots that differ from the rest: breasts and buttocks (Lump), ribbons (Accessory) or another thickness.\nUnlisted bones are rigid core. Bones that move only other slots (hair, skirt) need no entry. No role takes flesh out of Softbody slots."
msgstr "For bones skinned to Softbody slots that differ from the rest: breasts and buttocks (Lump), ribbons (Accessory) or another thickness.\nUnlisted bones are rigid core. Bones that move only other slots (hair, skirt) need no entry. No role takes flesh out of Softbody slots."

#. Key:	SoftbodyAuthoringData:RunBake
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:RunBake [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:RunBake [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:RunBake"
msgid "Runs every bake stage that is turned on, from measuring the flesh to saving (takes minutes).\nPress it again on a skeletal mesh whose Softbody slots changed."
msgstr "Runs every bake stage that is turned on, from measuring the flesh to saving (takes minutes).\nPress it again on a skeletal mesh whose Softbody slots changed."

#. Key:	SoftbodyAuthoringData:RunColliderField
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:RunColliderField [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:RunColliderField [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:RunColliderField"
msgid "Bakes only the shape field again (tens of seconds). Press it after changing Self Contact Bones or the shape field settings."
msgstr "Bakes only the shape field again (tens of seconds). Press it after changing Self Contact Bones or the shape field settings."

#. Key:	SoftbodyAuthoringData:RunCreateMaterial
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:RunCreateMaterial [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:RunCreateMaterial [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:RunCreateMaterial"
msgid "Creates and assigns the Softbody material again, then rebakes the contact map if there is one. Needs Baked Data."
msgstr "Creates and assigns the Softbody material again, then rebakes the contact map if there is one. Needs Baked Data."

#. Key:	SoftbodyAuthoringData:RunNaniteTessellation
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:RunNaniteTessellation [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:RunNaniteTessellation [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:RunNaniteTessellation"
msgid "Applies the Nanite tessellation settings again (needs Baked Data). Press it after changing the range settings."
msgstr "Applies the Nanite tessellation settings again (needs Baked Data). Press it after changing the range settings."

#. Key:	SoftbodyAuthoringData:RunPaintConvert
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:RunPaintConvert [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:RunPaintConvert [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:RunPaintConvert"
msgid "Converts the slot paint again and rebakes the contact map (seconds to tens of seconds).\nIf the paint changed since the last Run Bake, it runs Run Bake instead."
msgstr "Converts the slot paint again and rebakes the contact map (seconds to tens of seconds).\nIf the paint changed since the last Run Bake, it runs Run Bake instead."

#. Key:	SoftbodyAuthoringData:RunSurfaceCarrier
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:RunSurfaceCarrier [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:RunSurfaceCarrier [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:RunSurfaceCarrier"
msgid "Bakes only the contact map again (tens of seconds), after a change to the Softbody material or a contact map setting.\nOn a skeletal mesh whose Softbody slots changed, press Run Bake instead."
msgstr "Bakes only the contact map again (tens of seconds), after a change to the Softbody material or a contact map setting.\nOn a skeletal mesh whose Softbody slots changed, press Run Bake instead."

#. Key:	SoftbodyAuthoringData:RunValidation
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:RunValidation [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:RunValidation [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:RunValidation"
msgid "Checks the baked data, the mesh, its materials and shape field without baking again. Results go to the Output Log and Last Validation Errors."
msgstr "Checks the baked data, the mesh, its materials and shape field without baking again. Results go to the Output Log and Last Validation Errors."

#. Key:	SoftbodyAuthoringData:SeparatedPairs
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:SeparatedPairs [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:SeparatedPairs [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:SeparatedPairs"
msgid "Skeletal meshes: soft parts that share one surface but not the flesh under it, such as two breasts under a shirt bridging the cleavage.\nPick the top bones of each side. Pressing one side does not raise, dent or drag the other. Applied with Rebake Contact Map."
msgstr "Skeletal meshes: soft parts that share one surface but not the flesh under it, such as two breasts under a shirt bridging the cleavage.\nPick the top bones of each side. Pressing one side does not raise, dent or drag the other. Applied with Rebake Contact Map."

#. Key:	SoftbodyAuthoringData:ShapeFieldSlots
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:ShapeFieldSlots [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:ShapeFieldSlots [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:ShapeFieldSlots"
msgid "The material slots whose shape presses, such as skin and clothing. Empty = the whole mesh. Leave out hair and accessories so they\nnever dent other Softbody meshes."
msgstr "The material slots whose shape presses, such as skin and clothing. Empty = the whole mesh. Leave out hair and accessories so they\nnever dent other Softbody meshes."

#. Key:	SoftbodyAuthoringData:SlotMasks
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:SlotMasks [MapProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:SlotMasks [MapProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:SlotMasks"
msgid "Paint for each material slot: one RGBA texture in the slot's UV0 layout with R Depth, G Jiggle, B Volume and A Flex.\nWhite is unpainted in every channel, and slots not listed are unpainted."
msgstr "Paint for each material slot: one RGBA texture in the slot's UV0 layout with R Depth, G Jiggle, B Volume and A Flex.\nWhite is unpainted in every channel, and slots not listed are unpainted."

#. Key:	SoftbodyAuthoringData:SoftbodyMaterialSlots
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:SoftbodyMaterialSlots [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:SoftbodyMaterialSlots [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:SoftbodyMaterialSlots"
msgid "Slots that get the Softbody material (skin, tight clothing). Only bones skinned to Softbody slots become rigid core and inertia groups.\nBones that only move other slots (hair, skirt) are left out. A removed slot stays a Softbody slot until its original material is back."
msgstr "Slots that get the Softbody material (skin, tight clothing). Only bones skinned to Softbody slots become rigid core and inertia groups.\nBones that only move other slots (hair, skirt) are left out. A removed slot stays a Softbody slot until its original material is back."

#. Key:	SoftbodyAuthoringData:StaticCore
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:StaticCore [EnumProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:StaticCore [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:StaticCore"
msgid "Static meshes: which part stays still while the rest dents and jiggles.\nCenter runs a core through the middle of the shape, Bottom holds only the bottom, and Custom Spheres uses Rigid Core Spheres."
msgstr "Static meshes: which part stays still while the rest dents and jiggles.\nCenter runs a core through the middle of the shape, Bottom holds only the bottom, and Custom Spheres uses Rigid Core Spheres."

#. Key:	SoftbodyAuthoringData:StaticRigidSpheres
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:StaticRigidSpheres [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:StaticRigidSpheres [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:StaticRigidSpheres"
msgid "Core Placement Custom Spheres: spheres (mesh space, cm) for the part that never moves. At least one must sit inside the mesh.\nFlesh far from the spheres jiggles and dents more. A flat base is the top of a very large sphere."
msgstr "Core Placement Custom Spheres: spheres (mesh space, cm) for the part that never moves. At least one must sit inside the mesh.\nFlesh far from the spheres jiggles and dents more. A flat base is the top of a very large sphere."

#. Key:	SoftbodyAuthoringData:TargetMesh
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:TargetMesh [ObjectProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:TargetMesh [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:TargetMesh"
msgid "The skeletal or static mesh to make soft. Baking adds UV channels to this mesh, so use a mesh in your project's Content folder."
msgstr "The skeletal or static mesh to make soft. Baking adds UV channels to this mesh, so use a mesh in your project's Content folder."

#. Key:	SoftbodyAuthoringData:VolumeMesh
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:VolumeMesh [ObjectProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:VolumeMesh [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:VolumeMesh"
msgid "Optional. A closed static mesh that fills the inside of an open or hollow target, such as a trampoline sheet or a hollow can.\nModel it with the same position and pivot as the target (a skeletal target can use its bind pose). The surface dents as a thin skin."
msgstr "Optional. A closed static mesh that fills the inside of an open or hollow target, such as a trampoline sheet or a hollow can.\nModel it with the same position and pivot as the target (a skeletal target can use its bind pose). The surface dents as a thin skin."

#. Key:	SoftbodyAuthoringData:VolumePreservation
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringData:VolumePreservation [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringData:VolumePreservation [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringData:VolumePreservation"
msgid "Volume preservation: 1 for flesh or jelly, 0 for foam or a sponge, and values in between act like a denser foam.\nFlesh bulges around a dent and a pushed lump spreads sideways, while foam sinks in place. The Volume paint multiplies this value."
msgstr "Volume preservation: 1 for flesh or jelly, 0 for foam or a sponge, and values in between act like a denser foam.\nFlesh bulges around a dent and a pushed lump spreads sideways, while foam sinks in place. The Volume paint multiplies this value."

#. Key:	SoftbodyAuthoringDataFactory
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyAuthoringDataFactory [Class ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyAuthoringDataFactory [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyAuthoringDataFactory"
msgid "Creates a new Softbody Authoring Data asset from the Content Browser."
msgstr "Creates a new Softbody Authoring Data asset from the Content Browser."

#. Key:	SoftbodyBakeLibrary
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary [Class ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary"
msgid "Softbody bake steps, callable from Blueprint and Python. The Softbody Authoring Data asset's Run Bake button runs them in order,\nso call these directly only for scripted or partial bakes."
msgstr "Softbody bake steps, callable from Blueprint and Python. The Softbody Authoring Data asset's Run Bake button runs them in order,\nso call these directly only for scripted or partial bakes."

#. Key:	SoftbodyBakeLibrary:BakeBulgeLandmarks
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeBulgeLandmarks [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeBulgeLandmarks [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:BakeBulgeLandmarks"
msgid "Bakes the surface distance table that the bulge (flesh pushed aside around a dent) and the drag spread over. Without it both\nstay off. Contact map bakes call this at the end, so run it only on data baked before the table existed.\n@param Data            Baked data with a contact map.\n@param LandmarkCount   How many reference points on the surface the distances are measured to (16 to 128). More is more\n                       accurate and uses more memory.\n@return False if the data has no contact map or no flesh, its textures cannot be read, or the table is too tall for one texture."
msgstr "Bakes the surface distance table that the bulge (flesh pushed aside around a dent) and the drag spread over. Without it both\nstay off. Contact map bakes call this at the end, so run it only on data baked before the table existed.\n@param Data            Baked data with a contact map.\n@param LandmarkCount   How many reference points on the surface the distances are measured to (16 to 128). More is more\n                       accurate and uses more memory.\n@return False if the data has no contact map or no flesh, its textures cannot be read, or the table is too tall for one texture."

#. Key:	SoftbodyBakeLibrary:BakeColliderField
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeColliderField [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeColliderField [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:BakeColliderField"
msgid "Bakes a shape field: a copy of the mesh's real shape that it presses Softbody flesh with, instead of its simple collision. It is\nstored on the mesh asset. A skeletal mesh gets one part per bone, which follows that bone at runtime; a static mesh is one part.\nEvery part presses other Softbody meshes. Baked on a Softbody character's own mesh, the parts under PresserBones (such as the\nhands) also press its own flesh (self contact).\n@param Mesh          Static or skeletal mesh.\n@param VoxelSize     Cell size (local units). 0 = automatic: fine for thin parts such as fingers, coarser for the torso. If you\n                     set it, about a quarter of the thinnest pressing part (a finger's thickness) is enough.\n@param PresserBones  Skeletal only: bones (with their children) that also press the mesh's own flesh, such as Hand_L and Hand_R\n                     (Self Contact Bones on the authoring asset). On its own body only these press, so soft parts such as elbows\n                     and waist do not push each other. Empty = every part presses the mesh itself (for a mesh that is all\n                     presser, such as a hand).\n@param PartOverlap   Skeletal only: how far (cm) each part reaches into its parent and child bones. The overlap closes grooves\n                     along joints and gaps on the outside of bent joints; side-by-side bones (the next finger) are not included.\n                     0 = no overlap.\n@param VolumeMesh    Optional Volume Mesh: the shape is taken from this filled mesh (for thin, open membranes). Which bone owns\n                     each part still comes from Mesh.\n@return The baked shape field. The caller saves the mesh package. The whole mesh is baked; the authoring asset's Shape Field Slots\n        bake only some material slots."
msgstr "Bakes a shape field: a copy of the mesh's real shape that it presses Softbody flesh with, instead of its simple collision. It is\nstored on the mesh asset. A skeletal mesh gets one part per bone, which follows that bone at runtime; a static mesh is one part.\nEvery part presses other Softbody meshes. Baked on a Softbody character's own mesh, the parts under PresserBones (such as the\nhands) also press its own flesh (self contact).\n@param Mesh          Static or skeletal mesh.\n@param VoxelSize     Cell size (local units). 0 = automatic: fine for thin parts such as fingers, coarser for the torso. If you\n                     set it, about a quarter of the thinnest pressing part (a finger's thickness) is enough.\n@param PresserBones  Skeletal only: bones (with their children) that also press the mesh's own flesh, such as Hand_L and Hand_R\n                     (Self Contact Bones on the authoring asset). On its own body only these press, so soft parts such as elbows\n                     and waist do not push each other. Empty = every part presses the mesh itself (for a mesh that is all\n                     presser, such as a hand).\n@param PartOverlap   Skeletal only: how far (cm) each part reaches into its parent and child bones. The overlap closes grooves\n                     along joints and gaps on the outside of bent joints; side-by-side bones (the next finger) are not included.\n                     0 = no overlap.\n@param VolumeMesh    Optional Volume Mesh: the shape is taken from this filled mesh (for thin, open membranes). Which bone owns\n                     each part still comes from Mesh.\n@return The baked shape field. The caller saves the mesh package. The whole mesh is baked; the authoring asset's Shape Field Slots\n        bake only some material slots."

#. Key:	SoftbodyBakeLibrary:BakeInertiaShading
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeInertiaShading [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeInertiaShading [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:BakeInertiaShading"
msgid "Rebakes only the values that tilt the shading as the flesh jiggles. Bakes and paint updates already do this at the end; call it\nonly to upgrade data baked before jiggle shading existed, without a full rebake (takes a few seconds).\n@param Data  Baked data to update.\n@return False if the data has no baked inertia."
msgstr "Rebakes only the values that tilt the shading as the flesh jiggles. Bakes and paint updates already do this at the end; call it\nonly to upgrade data baked before jiggle shading existed, without a full rebake (takes a few seconds).\n@param Data  Baked data to update.\n@return False if the data has no baked inertia."

#. Key:	SoftbodyBakeLibrary:BakeSeparatedParts
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeSeparatedParts [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeSeparatedParts [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:BakeSeparatedParts"
msgid "Bakes the Separated Pairs into the contact map: for each cell, how much of it belongs to each side (bone weights, child bones\nincluded). The authoring asset calls this after the contact map bake. No usable pair removes the separation.\n@param Data   Baked data with a contact map of a skeletal mesh.\n@param Pairs  The pairs to keep apart.\n@return False if the contact map could not be read."
msgstr "Bakes the Separated Pairs into the contact map: for each cell, how much of it belongs to each side (bone weights, child bones\nincluded). The authoring asset calls this after the contact map bake. No usable pair removes the separation.\n@param Data   Baked data with a contact map of a skeletal mesh.\n@param Pairs  The pairs to keep apart.\n@return False if the contact map could not be read."

#. Key:	SoftbodyBakeLibrary:BakeSkeletalMeshMeasured
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeSkeletalMeshMeasured [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeSkeletalMeshMeasured [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:BakeSkeletalMeshMeasured"
msgid "Measure bake for a skeletal mesh in its reference pose: adds a UV channel to the mesh, bakes how soft the flesh is for inertia,\nand groups the vertices by the bones they jiggle with. The rigid core comes from the skeleton: each skin-weighted bone runs as a\nline to its skin-weighted child, as thick as a share of the distance to the skin. Wide bones with no bone of their own in the\nskeleton (ribs, pelvis, skull) are not found; paint them dark in Depth through the authoring asset instead.\n@param Mesh              Skeletal mesh to bake. It is modified (a UV channel is added).\n@param OutputFolder      Content folder for the baked data asset and its textures.\n@param CellSizeFrac      Measure cell size as a fraction of the mesh's longest side. Smaller is finer and slower.\n@param MaxInertiaGroups  Most bone groups that jiggle separately.\n@param RigidShrink       Bone thickness: the share of the distance from the bone line to the skin that counts as bone. Higher\n                         means thicker bones, thinner flesh and less jiggle.\n@param LayerMaxGap       Layered clothing: how far (cm) a covering surface such as underwear may sit above the flesh and still\n                         follow it. 0 = off.\n@return The baked data asset, or null if the bake failed."
msgstr "Measure bake for a skeletal mesh in its reference pose: adds a UV channel to the mesh, bakes how soft the flesh is for inertia,\nand groups the vertices by the bones they jiggle with. The rigid core comes from the skeleton: each skin-weighted bone runs as a\nline to its skin-weighted child, as thick as a share of the distance to the skin. Wide bones with no bone of their own in the\nskeleton (ribs, pelvis, skull) are not found; paint them dark in Depth through the authoring asset instead.\n@param Mesh              Skeletal mesh to bake. It is modified (a UV channel is added).\n@param OutputFolder      Content folder for the baked data asset and its textures.\n@param CellSizeFrac      Measure cell size as a fraction of the mesh's longest side. Smaller is finer and slower.\n@param MaxInertiaGroups  Most bone groups that jiggle separately.\n@param RigidShrink       Bone thickness: the share of the distance from the bone line to the skin that counts as bone. Higher\n                         means thicker bones, thinner flesh and less jiggle.\n@param LayerMaxGap       Layered clothing: how far (cm) a covering surface such as underwear may sit above the flesh and still\n                         follow it. 0 = off.\n@return The baked data asset, or null if the bake failed."

#. Key:	SoftbodyBakeLibrary:BakeStaticMeshMeasured
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeStaticMeshMeasured [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeStaticMeshMeasured [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:BakeStaticMeshMeasured"
msgid "Measure bake for a static mesh: adds a UV channel to the mesh and bakes how soft the flesh is for inertia, held in place by a\nrigid core made of spheres.\n@param Mesh          Static mesh to bake. It is modified (a UV channel is added).\n@param OutputFolder  Content folder for the baked data asset and its textures.\n@param RigidSpheres  Rigid core spheres (xyz = local center, w = radius). At least one is needed for inertia.\n@param CellSizeFrac  Measure cell size as a fraction of the mesh's longest side. Smaller is finer and slower.\n@param LayerMaxGap   Layered clothing: how far (cm) a covering surface may sit above the flesh and still follow it. 0 = off.\n@return The baked data asset, or null if the bake failed."
msgstr "Measure bake for a static mesh: adds a UV channel to the mesh and bakes how soft the flesh is for inertia, held in place by a\nrigid core made of spheres.\n@param Mesh          Static mesh to bake. It is modified (a UV channel is added).\n@param OutputFolder  Content folder for the baked data asset and its textures.\n@param RigidSpheres  Rigid core spheres (xyz = local center, w = radius). At least one is needed for inertia.\n@param CellSizeFrac  Measure cell size as a fraction of the mesh's longest side. Smaller is finer and slower.\n@param LayerMaxGap   Layered clothing: how far (cm) a covering surface may sit above the flesh and still follow it. 0 = off.\n@return The baked data asset, or null if the bake failed."

#. Key:	SoftbodyBakeLibrary:BakeSurfaceCarrier
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeSurfaceCarrier [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeSurfaceCarrier [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:BakeSurfaceCarrier"
msgid "Bakes the contact map into existing baked data. It wraps the mesh in an outer surface and unfolds it into one texture atlas.\nEach cell stores its rest position, the outward normal and the flesh thickness (skin to rigid core, times Depth paint).\nContact on the Softbody component needs it; without a contact map, contact is off. When the map follows the mesh's UV0 islands\n(Contact Map Seams), it also writes a UV channel into the mesh and connects it in the Softbody material, so save the mesh and\nthe material as well.\n@param Data              Baked data to add the contact map to.\n@param Resolution        Atlas size in texels per side. Higher gives finer dents and uses more memory.\n@param CoreSpheres       Thickness core spheres (xyz = local center, w = radius). Empty: skeletal meshes use the skeleton's bone\n                         lines, static meshes measure half the distance through the mesh.\n@param EnvelopeCellSize  Grid cell size for building the outer surface (local units). 0 = longest side / 256.\n@param TargetTriangles   The outer surface is reduced to this many triangles before unfolding.\n@param CoreShrink        Skeletal meshes with no CoreSpheres: bone thickness as a share of the distance from bone line to skin.\n@param MaxThickness      Cap on flesh thickness (local units). 0 = no cap. Use it on objects whose core does not follow the\n                         surface (a box or cushion with a core only at the bottom): otherwise the sides measure too thick and\n                         dent along with a press on another face.\n@return True on success. The caller saves the packages."
msgstr "Bakes the contact map into existing baked data. It wraps the mesh in an outer surface and unfolds it into one texture atlas.\nEach cell stores its rest position, the outward normal and the flesh thickness (skin to rigid core, times Depth paint).\nContact on the Softbody component needs it; without a contact map, contact is off. When the map follows the mesh's UV0 islands\n(Contact Map Seams), it also writes a UV channel into the mesh and connects it in the Softbody material, so save the mesh and\nthe material as well.\n@param Data              Baked data to add the contact map to.\n@param Resolution        Atlas size in texels per side. Higher gives finer dents and uses more memory.\n@param CoreSpheres       Thickness core spheres (xyz = local center, w = radius). Empty: skeletal meshes use the skeleton's bone\n                         lines, static meshes measure half the distance through the mesh.\n@param EnvelopeCellSize  Grid cell size for building the outer surface (local units). 0 = longest side / 256.\n@param TargetTriangles   The outer surface is reduced to this many triangles before unfolding.\n@param CoreShrink        Skeletal meshes with no CoreSpheres: bone thickness as a share of the distance from bone line to skin.\n@param MaxThickness      Cap on flesh thickness (local units). 0 = no cap. Use it on objects whose core does not follow the\n                         surface (a box or cushion with a core only at the bottom): otherwise the sides measure too thick and\n                         dent along with a press on another face.\n@return True on success. The caller saves the packages."

#. Key:	SoftbodyBakeLibrary:BakeWakeBounds
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeWakeBounds [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:BakeWakeBounds [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:BakeWakeBounds"
msgid "Bakes per-bone wake-up boxes from the contact map, used for sleeping: at runtime, contact does no GPU work while no collider can\nreach these boxes. If the target mesh has a shape field, self-contact boxes are baked too. Contact map bakes call this at the\nend; call it again if you bake a shape field afterwards.\n@param Data  Baked data with a contact map.\n@return False if the data has no contact map."
msgstr "Bakes per-bone wake-up boxes from the contact map, used for sleeping: at runtime, contact does no GPU work while no collider can\nreach these boxes. If the target mesh has a shape field, self-contact boxes are baked too. Contact map bakes call this at the\nend; call it again if you bake a shape field afterwards.\n@param Data  Baked data with a contact map.\n@return False if the data has no contact map."

#. Key:	SoftbodyBakeLibrary:CompileMaterialShadersSync
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:CompileMaterialShadersSync [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:CompileMaterialShadersSync [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:CompileMaterialShadersSync"
msgid "Recompiles the material's shaders (the parent's, for an instance) for the current platform and waits for them to finish.\n@param Material  Material or material instance to compile.\n@return Compile errors; empty on success."
msgstr "Recompiles the material's shaders (the parent's, for an instance) for the current platform and waits for them to finish.\n@param Material  Material or material instance to compile.\n@return Compile errors; empty on success."

#. Key:	SoftbodyBakeLibrary:ConfigureNaniteTessellation
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:ConfigureNaniteTessellation [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:ConfigureNaniteTessellation [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:ConfigureNaniteTessellation"
msgid "Sets the mesh up for Nanite tessellation so dents can be narrower than the spacing between vertices: the original vertices move\nas before, and the points tessellation adds inside each triangle read the contact directly. Turns on Nanite for the mesh, the\nNanite usage flag on every slot material, and tessellation and displacement on the Softbody slots. Fails if any slot is\ntranslucent. Warns about morph targets (Nanite skinning ignores them) and hard-edged normals inside Softbody slots (they open\ngaps).\n@param Data                    Baked data whose mesh to set up. Its baked UV channel must be UV0 to UV3.\n@param Magnitude               Size of the displacement range (cm).\n@param Center                  Where zero sits in that range: displacement runs from Center x Magnitude inward to\n                               (1 - Center) x Magnitude outward. Values beyond are clipped.\n@param MaxWorldPositionOffset  How far (cm) Nanite culling widens the bounds for vertex motion. Motion is also clipped to this\n                               per axis, so keep it above the largest contact and jiggle motion.\n@return True on success. The caller saves the packages."
msgstr "Sets the mesh up for Nanite tessellation so dents can be narrower than the spacing between vertices: the original vertices move\nas before, and the points tessellation adds inside each triangle read the contact directly. Turns on Nanite for the mesh, the\nNanite usage flag on every slot material, and tessellation and displacement on the Softbody slots. Fails if any slot is\ntranslucent. Warns about morph targets (Nanite skinning ignores them) and hard-edged normals inside Softbody slots (they open\ngaps).\n@param Data                    Baked data whose mesh to set up. Its baked UV channel must be UV0 to UV3.\n@param Magnitude               Size of the displacement range (cm).\n@param Center                  Where zero sits in that range: displacement runs from Center x Magnitude inward to\n                               (1 - Center) x Magnitude outward. Values beyond are clipped.\n@param MaxWorldPositionOffset  How far (cm) Nanite culling widens the bounds for vertex motion. Motion is also clipped to this\n                               per axis, so keep it above the largest contact and jiggle motion.\n@return True on success. The caller saves the packages."

#. Key:	SoftbodyBakeLibrary:CreateBonePhysicsAsset
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateBonePhysicsAsset [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateBonePhysicsAsset [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:CreateBonePhysicsAsset"
msgid "For presser meshes such as a hand: creates a physics asset with one body per bone and assigns it to the mesh. Bones with a\nparent (finger joints) get a capsule fitted to their vertices; the root bone (palm) gets a box. Not needed for the mesh you bake\nas Softbody; that bake reads its rigid core from the skeleton.\n@param Mesh         Skeletal mesh.\n@param AssetPath    Where to create the physics asset.\n@param MinVertices  Bones with fewer vertices than this get no body.\n@return The created physics asset, or null on failure."
msgstr "For presser meshes such as a hand: creates a physics asset with one body per bone and assigns it to the mesh. Bones with a\nparent (finger joints) get a capsule fitted to their vertices; the root bone (palm) gets a box. Not needed for the mesh you bake\nas Softbody; that bake reads its rigid core from the skeleton.\n@param Mesh         Skeletal mesh.\n@param AssetPath    Where to create the physics asset.\n@param MinVertices  Bones with fewer vertices than this get no body.\n@return The created physics asset, or null on failure."

#. Key:	SoftbodyBakeLibrary:CreateDumbbellTestMesh
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateDumbbellTestMesh [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateDumbbellTestMesh [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:CreateDumbbellTestMesh"
msgid "Test mesh for inertia checks: two round lobes along local X joined by a smooth narrow waist. A rigid core sphere can be placed in\neither lobe."
msgstr "Test mesh for inertia checks: two round lobes along local X joined by a smooth narrow waist. A rigid core sphere can be placed in\neither lobe."

#. Key:	SoftbodyBakeLibrary:CreateEllipsoidTestMesh
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateEllipsoidTestMesh [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateEllipsoidTestMesh [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:CreateEllipsoidTestMesh"
msgid "Test mesh for inertia checks: a closed ellipsoid with its own radius (cm) along local X, Y and Z. The same radii and Resolution\nalways give the same vertices, so you can move the rigid core spheres between bakes without changing the surface."
msgstr "Test mesh for inertia checks: a closed ellipsoid with its own radius (cm) along local X, Y and Z. The same radii and Resolution\nalways give the same vertices, so you can move the rigid core spheres between bakes without changing the surface."

#. Key:	SoftbodyBakeLibrary:CreateHollowSphereTestMesh
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateHollowSphereTestMesh [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateHollowSphereTestMesh [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:CreateHollowSphereTestMesh"
msgid "Test mesh for inertia checks: a sphere, hollow when InnerRadius > 0 (an inner shell facing inward). The rigid core is not\ngeometry; pass it as RigidSpheres to BakeStaticMeshMeasured.\n@param AssetPath    Where to create the static mesh.\n@param OuterRadius  Outer radius (cm).\n@param InnerRadius  Radius of the hollow inside (cm). 0 = solid.\n@param Resolution   Segments around the sphere.\n@return The created static mesh."
msgstr "Test mesh for inertia checks: a sphere, hollow when InnerRadius > 0 (an inner shell facing inward). The rigid core is not\ngeometry; pass it as RigidSpheres to BakeStaticMeshMeasured.\n@param AssetPath    Where to create the static mesh.\n@param OuterRadius  Outer radius (cm).\n@param InnerRadius  Radius of the hollow inside (cm). 0 = solid.\n@param Resolution   Segments around the sphere.\n@return The created static mesh."

#. Key:	SoftbodyBakeLibrary:CreateLimitsPhysicsAsset
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateLimitsPhysicsAsset [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateLimitsPhysicsAsset [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:CreateLimitsPhysicsAsset"
msgid "Creates body colliders for anim nodes that jiggle hair or breasts (such as KawaiiPhysics' Physics Asset for Limits) at AssetPath.\nIt copies the mesh's physics asset, keeps only the KeepBones bodies (constraints are removed), and for each shape:\n - scales its radius (or box size) by RadiusScale. Below 1 the shape sits inside the flesh, so a light touch only dents the skin\n   and the jiggling bone is pushed only by a deeper press.\n - shrinks it until the ClearBones (jiggling bones) are at least Clearance outside it in the reference pose, so hair does not\n   puff out just from standing. Shapes smaller than 0.5 cm are removed.\nThe amounts shrunk are logged. The caller saves the package.\n@param Mesh         Skeletal mesh whose physics asset to copy.\n@param AssetPath    Where to create the new physics asset.\n@param KeepBones    Bones whose bodies to keep.\n@param ClearBones   Jiggling bones that must stay clear of the shapes.\n@param Clearance    Required distance (cm), about the jiggling bones' collision radius.\n@param RadiusScale  Scale for every shape's radius or box size.\n@return The created physics asset, or null on failure."
msgstr "Creates body colliders for anim nodes that jiggle hair or breasts (such as KawaiiPhysics' Physics Asset for Limits) at AssetPath.\nIt copies the mesh's physics asset, keeps only the KeepBones bodies (constraints are removed), and for each shape:\n - scales its radius (or box size) by RadiusScale. Below 1 the shape sits inside the flesh, so a light touch only dents the skin\n   and the jiggling bone is pushed only by a deeper press.\n - shrinks it until the ClearBones (jiggling bones) are at least Clearance outside it in the reference pose, so hair does not\n   puff out just from standing. Shapes smaller than 0.5 cm are removed.\nThe amounts shrunk are logged. The caller saves the package.\n@param Mesh         Skeletal mesh whose physics asset to copy.\n@param AssetPath    Where to create the new physics asset.\n@param KeepBones    Bones whose bodies to keep.\n@param ClearBones   Jiggling bones that must stay clear of the shapes.\n@param Clearance    Required distance (cm), about the jiggling bones' collision radius.\n@param RadiusScale  Scale for every shape's radius or box size.\n@return The created physics asset, or null on failure."

#. Key:	SoftbodyBakeLibrary:CreatePostProcessAnimBlueprint
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:CreatePostProcessAnimBlueprint [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:CreatePostProcessAnimBlueprint [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:CreatePostProcessAnimBlueprint"
msgid "Creates a post-process Animation Blueprint at AssetPath and assigns it to the mesh. It runs last, whatever animation plays\n(Sequencer, an Animation Blueprint or a single animation). The pose goes input -> NodeClasses[0] -> [1] -> ... -> output.\nThe caller saves the package.\n@param Mesh          Skeletal mesh to assign it to.\n@param AssetPath     Where to create the Animation Blueprint.\n@param NodeClasses   Anim graph node class paths, such as \"/Script/KawaiiPhysicsEd.AnimGraphNode_KawaiiPhysics\".\n@param NodeSettings  Per node, the text for its node struct (property \"Node\"), in the format the editor uses when you copy a\n                     node: \"(RootBone=(BoneName=\\\"Hair\\\"),Gravity=(X=0,Y=0,Z=-980))\". Values left out keep their defaults; an\n                     unknown name fails.\n@return The created Animation Blueprint, or null on failure."
msgstr "Creates a post-process Animation Blueprint at AssetPath and assigns it to the mesh. It runs last, whatever animation plays\n(Sequencer, an Animation Blueprint or a single animation). The pose goes input -> NodeClasses[0] -> [1] -> ... -> output.\nThe caller saves the package.\n@param Mesh          Skeletal mesh to assign it to.\n@param AssetPath     Where to create the Animation Blueprint.\n@param NodeClasses   Anim graph node class paths, such as \"/Script/KawaiiPhysicsEd.AnimGraphNode_KawaiiPhysics\".\n@param NodeSettings  Per node, the text for its node struct (property \"Node\"), in the format the editor uses when you copy a\n                     node: \"(RootBone=(BoneName=\\\"Hair\\\"),Gravity=(X=0,Y=0,Z=-980))\". Values left out keep their defaults; an\n                     unknown name fails.\n@return The created Animation Blueprint, or null on failure."

#. Key:	SoftbodyBakeLibrary:CreateUniformSphereTestMesh
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateUniformSphereTestMesh [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:CreateUniformSphereTestMesh [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:CreateUniformSphereTestMesh"
msgid "Dense test sphere for contact checks: a cube inflated into a sphere, so triangles are even and there are no poles. It has about\n6 x EdgeVertices² vertices. Matching the vertex spacing to the contact map cell size shows dents almost exactly as computed.\n@param AssetPath     Where to create the static mesh.\n@param Radius        Sphere radius (cm).\n@param EdgeVertices  Vertices along one cube edge.\n@return The created static mesh."
msgstr "Dense test sphere for contact checks: a cube inflated into a sphere, so triangles are even and there are no poles. It has about\n6 x EdgeVertices² vertices. Matching the vertex spacing to the contact map cell size shows dents almost exactly as computed.\n@param AssetPath     Where to create the static mesh.\n@param Radius        Sphere radius (cm).\n@param EdgeVertices  Vertices along one cube edge.\n@return The created static mesh."

#. Key:	SoftbodyBakeLibrary:DescribeBulgeTable
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:DescribeBulgeTable [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:DescribeBulgeTable [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:DescribeBulgeTable"
msgid "Logs how the bulge distance table of the data is stored (pixel format, size, number of reference points) and a few of its values.\n@return The same summary as a string; empty if the data has no table."
msgstr "Logs how the bulge distance table of the data is stored (pixel format, size, number of reference points) and a few of its values.\n@return The same summary as a string; empty if the data has no table."

#. Key:	SoftbodyBakeLibrary:DumpBakeCoverageStats
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpBakeCoverageStats [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpBakeCoverageStats [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:DumpBakeCoverageStats"
msgid "Logs bake coverage for the whole mesh and for each render section. It shows how many vertices lie inside the measured flesh\nand how many are connected to the rigid core. It also shows how strongly they respond to inertia and their mean paint. Low\ncoverage is a quality hint, not an error.\n@param Data  Baked data to inspect.\n@return False if the data has no diagnostics (bake it again)."
msgstr "Logs bake coverage for the whole mesh and for each render section. It shows how many vertices lie inside the measured flesh\nand how many are connected to the rigid core. It also shows how strongly they respond to inertia and their mean paint. Low\ncoverage is a quality hint, not an error.\n@param Data  Baked data to inspect.\n@return False if the data has no diagnostics (bake it again)."

#. Key:	SoftbodyBakeLibrary:DumpCarrierTileLinks
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpCarrierTileLinks [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpCarrierTileLinks [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:DumpCarrierTileLinks"
msgid "Diagnostics: splits the contact map into tiles of TileSize cells and counts, per tile, how many other tiles its seam cells read\nfrom. Logs the distribution, the number of tiles over MaxLinks, and how much of the map those tiles and their border cover.\nDoes not change the baked data.\n@param Data      Baked data with a contact map.\n@param TileSize  Tile size in cells.\n@param MaxLinks  Tiles linked to more tiles than this are counted separately.\n@return False on failure."
msgstr "Diagnostics: splits the contact map into tiles of TileSize cells and counts, per tile, how many other tiles its seam cells read\nfrom. Logs the distribution, the number of tiles over MaxLinks, and how much of the map those tiles and their border cover.\nDoes not change the baked data.\n@param Data      Baked data with a contact map.\n@param TileSize  Tile size in cells.\n@param MaxLinks  Tiles linked to more tiles than this are counted separately.\n@return False on failure."

#. Key:	SoftbodyBakeLibrary:DumpInertiaSoftness
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpInertiaSoftness [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpInertiaSoftness [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:DumpInertiaSoftness"
msgid "Logs how much each part was baked to jiggle: per bone (the bone each vertex is most weighted to), the mean and maximum distance\nthe flesh moves under 1 g, relative to the softest point and multiplied by the jiggle paint. Multiply by Inertia Amount for cm.\nStatic meshes get one overall line. A high value where bone should be close (forearm, hand) means there is no rigid core there:\nthe bone has no skin weights, or its line passes outside the mesh (see the \"Rigid core\" line in the bake log).\n@param Data     Baked data to inspect.\n@param CsvPath  Optional file path. If set, writes one line per vertex, plus the triangles to \"<name>_triangles.csv\" and the\n                jiggle shading values to \"<name>_shading.csv\".\n@return False if the data has no baked inertia or the file cannot be written."
msgstr "Logs how much each part was baked to jiggle: per bone (the bone each vertex is most weighted to), the mean and maximum distance\nthe flesh moves under 1 g, relative to the softest point and multiplied by the jiggle paint. Multiply by Inertia Amount for cm.\nStatic meshes get one overall line. A high value where bone should be close (forearm, hand) means there is no rigid core there:\nthe bone has no skin weights, or its line passes outside the mesh (see the \"Rigid core\" line in the bake log).\n@param Data     Baked data to inspect.\n@param CsvPath  Optional file path. If set, writes one line per vertex, plus the triangles to \"<name>_triangles.csv\" and the\n                jiggle shading values to \"<name>_shading.csv\".\n@return False if the data has no baked inertia or the file cannot be written."

#. Key:	SoftbodyBakeLibrary:DumpLayerGap
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpLayerGap [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpLayerGap [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:DumpLayerGap"
msgid "Layered clothing diagnostics; call it in PIE while something is pressing. Pairs each inner-layer vertex (such as skin) with the\nnearest point of the outer layer above it (such as a bra) and logs how differently contact moves the two this frame, including\npairs where the skin pokes through. Assumes the reference pose (no animation playing).\n@param Softbody     Softbody component with contact running.\n@param InnerSlot    Material slot of the inner layer.\n@param OuterSlot    Material slot of the outer layer.\n@param CenterWorld  Center of the area to inspect (world).\n@param Radius       Radius of the area to inspect (cm).\n@param MaxGap       Pairs farther apart than this (cm) are not treated as layered.\n@param CsvPath      Optional file path; writes one line per pair.\n@return False if the component or its data is not ready."
msgstr "Layered clothing diagnostics; call it in PIE while something is pressing. Pairs each inner-layer vertex (such as skin) with the\nnearest point of the outer layer above it (such as a bra) and logs how differently contact moves the two this frame, including\npairs where the skin pokes through. Assumes the reference pose (no animation playing).\n@param Softbody     Softbody component with contact running.\n@param InnerSlot    Material slot of the inner layer.\n@param OuterSlot    Material slot of the outer layer.\n@param CenterWorld  Center of the area to inspect (world).\n@param Radius       Radius of the area to inspect (cm).\n@param MaxGap       Pairs farther apart than this (cm) are not treated as layered.\n@param CsvPath      Optional file path; writes one line per pair.\n@return False if the component or its data is not ready."

#. Key:	SoftbodyBakeLibrary:DumpPaintSectionStats
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpPaintSectionStats [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:DumpPaintSectionStats [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:DumpPaintSectionStats"
msgid "Logs the mean Jiggle, Depth and Volume paint of each render section. It also logs the section's mean jiggle scale and the share\nof the section that jiggles.\n@param Data  Baked data to inspect.\n@return False if the data or its paint texture cannot be read."
msgstr "Logs the mean Jiggle, Depth and Volume paint of each render section. It also logs the section's mean jiggle scale and the share\nof the section that jiggles.\n@param Data  Baked data to inspect.\n@return False if the data or its paint texture cannot be read."

#. Key:	SoftbodyBakeLibrary:GeneratePaintTexture
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:GeneratePaintTexture [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:GeneratePaintTexture [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:GeneratePaintTexture"
msgid "Creates or updates the mesh's paint texture from one paint texture shared by every material slot (R Depth, G Jiggle, B Volume).\nFlex is not read here. This does not measure the flesh again, so the jiggle follows new paint only after Run Bake. Without a\ntexture everything is unpainted (white). The texture is read in UV0, so give its UV islands some padding. For meshes whose slots\nshare UV0 space, use GeneratePaintTextureSlots instead.\n@param Data        Baked data to paint.\n@param SourceMask  Optional paint texture in UV0.\n@return The paint texture, or null on failure."
msgstr "Creates or updates the mesh's paint texture from one paint texture shared by every material slot (R Depth, G Jiggle, B Volume).\nFlex is not read here. This does not measure the flesh again, so the jiggle follows new paint only after Run Bake. Without a\ntexture everything is unpainted (white). The texture is read in UV0, so give its UV islands some padding. For meshes whose slots\nshare UV0 space, use GeneratePaintTextureSlots instead.\n@param Data        Baked data to paint.\n@param SourceMask  Optional paint texture in UV0.\n@return The paint texture, or null on failure."

#. Key:	SoftbodyBakeLibrary:GeneratePaintTextureSlots
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:GeneratePaintTextureSlots [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:GeneratePaintTextureSlots [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:GeneratePaintTextureSlots"
msgid "Creates or updates the paint texture with one paint entry per material slot, for meshes whose slots share UV0 space (most\ncharacters). Slots without an entry stay unpainted (white). So does a paint set to Paint Texture when the slot has no texture.\nFlex is not read here. This does not measure the flesh again, so the jiggle follows new paint only after Run Bake.\n@param Data       Baked data to paint.\n@param SlotMasks  Material slot index -> that slot's Paint Texture and how each channel is filled.\n@return The paint texture, or null on failure."
msgstr "Creates or updates the paint texture with one paint entry per material slot, for meshes whose slots share UV0 space (most\ncharacters). Slots without an entry stay unpainted (white). So does a paint set to Paint Texture when the slot has no texture.\nFlex is not read here. This does not measure the flesh again, so the jiggle follows new paint only after Run Bake.\n@param Data       Baked data to paint.\n@param SlotMasks  Material slot index -> that slot's Paint Texture and how each channel is filled.\n@return The paint texture, or null on failure."

#. Key:	SoftbodyBakeLibrary:MeasureCarrierAtlas
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:MeasureCarrierAtlas [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:MeasureCarrierAtlas [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:MeasureCarrierAtlas"
msgid "Diagnostics: measures how the contact map atlas would be laid out, without changing the baked data. Unfolds the outer surface\nwith the same rules as the bake and logs each atlas piece's area, cells used and main bone, split into the area where contact can\nshow (Softbody material slots with Depth above 0) and the rest.\n@param Data              Baked data of a skeletal mesh, with paint.\n@param Resolution        Atlas size in texels per side.\n@param PruneMargin       If 0 or more, outer-surface triangles farther than this (cm) from any vertex where contact can show are\n                         cut away before unfolding. Negative = no cut.\n@param EnvelopeCellSize  Grid cell size for building the outer surface (local units). 0 = longest side / 256.\n@param TargetTriangles   The outer surface is reduced to this many triangles before unfolding.\n@param bUsePaintMask     If false, ignores Depth paint and decides by material slot only.\n@return False on failure."
msgstr "Diagnostics: measures how the contact map atlas would be laid out, without changing the baked data. Unfolds the outer surface\nwith the same rules as the bake and logs each atlas piece's area, cells used and main bone, split into the area where contact can\nshow (Softbody material slots with Depth above 0) and the rest.\n@param Data              Baked data of a skeletal mesh, with paint.\n@param Resolution        Atlas size in texels per side.\n@param PruneMargin       If 0 or more, outer-surface triangles farther than this (cm) from any vertex where contact can show are\n                         cut away before unfolding. Negative = no cut.\n@param EnvelopeCellSize  Grid cell size for building the outer surface (local units). 0 = longest side / 256.\n@param TargetTriangles   The outer surface is reduced to this many triangles before unfolding.\n@param bUsePaintMask     If false, ignores Depth paint and decides by material slot only.\n@return False on failure."

#. Key:	SoftbodyBakeLibrary:PreviewStaticCore
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:PreviewStaticCore [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:PreviewStaticCore [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:PreviewStaticCore"
msgid "Returns the rigid core spheres that Core Placement Center (bFloor false) or Bottom (bFloor true) would place in a static mesh,\nwithout baking. Each entry is a center in mesh space (cm) with the radius in w."
msgstr "Returns the rigid core spheres that Core Placement Center (bFloor false) or Bottom (bFloor true) would place in a static mesh,\nwithout baking. Each entry is a center in mesh space (cm) with the radius in w."

#. Key:	SoftbodyBakeLibrary:VerifyBakeIntegrity
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:VerifyBakeIntegrity [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:VerifyBakeIntegrity [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:VerifyBakeIntegrity"
msgid "Quick check of the baked outputs for any mesh type: required textures, per-vertex arrays, the source mesh and the baked UV\nchannel. It does not judge quality.\n@param Data  Baked data to check.\n@return Number of failed checks (0 = passed, -1 = no data)."
msgstr "Quick check of the baked outputs for any mesh type: required textures, per-vertex arrays, the source mesh and the baked UV\nchannel. It does not judge quality.\n@param Data  Baked data to check.\n@return Number of failed checks (0 = passed, -1 = no data)."

#. Key:	SoftbodyBakeLibrary:VerifyInertiaResponseBake
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:VerifyInertiaResponseBake [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:VerifyInertiaResponseBake [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:VerifyInertiaResponseBake"
msgid "Checks the baked flesh softness for inertia: array and texture sizes, solver accuracy and how well the rigid core holds. It also\nchecks that the flesh moves the way it is pulled.\n@param Data  Baked data to check.\n@return Number of failed checks (0 = passed, -1 = no data)."
msgstr "Checks the baked flesh softness for inertia: array and texture sizes, solver accuracy and how well the rigid core holds. It also\nchecks that the flesh moves the way it is pulled.\n@param Data  Baked data to check.\n@return Number of failed checks (0 = passed, -1 = no data)."

#. Key:	SoftbodyBakeLibrary:VerifySkeletalBake
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyBakeLibrary:VerifySkeletalBake [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyBakeLibrary:VerifySkeletalBake [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyBakeLibrary:VerifySkeletalBake"
msgid "Checks a skeletal bake: every render vertex must point at a baked vertex, and that vertex's inertia groups and weights must be\nvalid.\n@param Mesh  The baked skeletal mesh.\n@param Data  Its baked data.\n@return Number of mismatches (0 = OK), or -1 if an input is missing."
msgstr "Checks a skeletal bake: every render vertex must point at a baked vertex, and that vertex's inertia groups and weights must be\nvalid.\n@param Mesh  The baked skeletal mesh.\n@param Data  Its baked data.\n@return Number of mismatches (0 = OK), or -1 if an input is missing."

#. Key:	SoftbodyPaintSlotMask
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyPaintSlotMask [ScriptStruct ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyPaintSlotMask [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyPaintSlotMask"
msgid "Paint for one material slot: one RGBA texture in the slot's UV0 layout. White means unpainted in every channel.\nR Depth: flesh depth before bone. G Jiggle: how soft it is. B Volume: whether it keeps its volume. A Flex: how the surface bends."
msgstr "Paint for one material slot: one RGBA texture in the slot's UV0 layout. White means unpainted in every channel.\nR Depth: flesh depth before bone. G Jiggle: how soft it is. B Volume: whether it keeps its volume. A Flex: how the surface bends."

#. Key:	SoftbodyPaintSlotMask:DepthFill
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyPaintSlotMask:DepthFill [EnumProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyPaintSlotMask:DepthFill [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyPaintSlotMask:DepthFill"
msgid "For bone closer under the skin than the skeleton's bones, such as ribs, shins and the head. White = flesh down to the rigid core.\nGray = bone that much closer, so dents are narrower and the flesh jiggles less. Black = bone right under the skin: no dent, no jiggle."
msgstr "For bone closer under the skin than the skeleton's bones, such as ribs, shins and the head. White = flesh down to the rigid core.\nGray = bone that much closer, so dents are narrower and the flesh jiggles less. Black = bone right under the skin: no dent, no jiggle."

#. Key:	SoftbodyPaintSlotMask:JiggleFill
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyPaintSlotMask:JiggleFill [EnumProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyPaintSlotMask:JiggleFill [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyPaintSlotMask:JiggleFill"
msgid "For flesh firmer in some places than others, such as a belly over muscle next to a breast. White = soft flesh, gray = firmer flesh.\nBlack = flesh as firm as bone that does not jiggle but still dents. Paint bone in Depth instead."
msgstr "For flesh firmer in some places than others, such as a belly over muscle next to a breast. White = soft flesh, gray = firmer flesh.\nBlack = flesh as firm as bone that does not jiggle but still dents. Paint bone in Depth instead."

#. Key:	SoftbodyPaintSlotMask:NormalGain
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyPaintSlotMask:NormalGain [EnumProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyPaintSlotMask:NormalGain [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyPaintSlotMask:NormalGain"
msgid "Old paint layout, kept only to convert assets saved before the fixed RGBA layout. The bake does not read it."
msgstr "Old paint layout, kept only to convert assets saved before the fixed RGBA layout. The bake does not read it."

#. Key:	SoftbodyPaintSlotMask:SoftnessFill
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyPaintSlotMask:SoftnessFill [EnumProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyPaintSlotMask:SoftnessFill [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyPaintSlotMask:SoftnessFill"
msgid "For skin that bends stiffer than bare flesh, such as leather or the pips of a soft die. White = bare skin, darker gray = stiffer.\nBlack = a rigid plate: each connected black area sinks and tilts as one piece. Needs Contact Detail Full."
msgstr "For skin that bends stiffer than bare flesh, such as leather or the pips of a soft die. White = bare skin, darker gray = stiffer.\nBlack = a rigid plate: each connected black area sinks and tilts as one piece. Needs Contact Detail Full."

#. Key:	SoftbodyPaintSlotMask:Texture
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyPaintSlotMask:Texture [ObjectProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyPaintSlotMask:Texture [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyPaintSlotMask:Texture"
msgid "One texture holds all four paints in the slot's UV0 layout. R is Depth, G Jiggle, B Volume and A Flex. Turn off sRGB. A texture without alpha reads as bare skin."
msgstr "One texture holds all four paints in the slot's UV0 layout. R is Depth, G Jiggle, B Volume and A Flex. Turn off sRGB. A texture without alpha reads as bare skin."

#. Key:	SoftbodyPaintSlotMask:VolumeFill
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyPaintSlotMask:VolumeFill [EnumProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyPaintSlotMask:VolumeFill [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyPaintSlotMask:VolumeFill"
msgid "For parts made of a different material, such as a foam base under a jelly toy.\nWhite = flesh that keeps its volume, so skin around a dent rises. Black = foam that sinks in place. It multiplies Volume Preservation."
msgstr "For parts made of a different material, such as a foam base under a jelly toy.\nWhite = flesh that keeps its volume, so skin around a dent rises. Black = foam that sinks in place. It multiplies Volume Preservation."

#. Key:	SoftbodyRigidBoneOverride
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyRigidBoneOverride [ScriptStruct ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyRigidBoneOverride [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyRigidBoneOverride"
msgid "What one bone is (rigid core, lump or accessory), and how thick it is when it is rigid core."
msgstr "What one bone is (rigid core, lump or accessory), and how thick it is when it is rigid core."

#. Key:	SoftbodyRigidBoneOverride:bExclude
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyRigidBoneOverride:bExclude [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyRigidBoneOverride:bExclude [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyRigidBoneOverride:bExclude"
msgid "The old Exclude (Make Lump) check box, read only to move older assets to Role Lump."
msgstr "The old Exclude (Make Lump) check box, read only to move older assets to Role Lump."

#. Key:	SoftbodyRigidBoneOverride:bIncludeChildren
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyRigidBoneOverride:bIncludeChildren [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyRigidBoneOverride:bIncludeChildren [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyRigidBoneOverride:bIncludeChildren"
msgid "Lets one entry cover a whole chain or limb from its top bone. The bones below take this entry unless they have one of their own.\nTurn it off to change this bone only."
msgstr "Lets one entry cover a whole chain or limb from its top bone. The bones below take this entry unless they have one of their own.\nTurn it off to change this bone only."

#. Key:	SoftbodyRigidBoneOverride:BoneName
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyRigidBoneOverride:BoneName [NameProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyRigidBoneOverride:BoneName [NameProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyRigidBoneOverride:BoneName"
msgid "A bone of the target mesh's skeleton."
msgstr "A bone of the target mesh's skeleton."

#. Key:	SoftbodyRigidBoneOverride:Role
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyRigidBoneOverride:Role [EnumProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyRigidBoneOverride:Role [EnumProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyRigidBoneOverride:Role"
msgid "Pick by what the bone carries. Rigid Core: flesh with bone inside, like an arm. Lump: a breast or buttock with no bone inside, whose\nflesh moves out of the way as a whole. Accessory: a ribbon or necklace lying on the body, which moves with the flesh under it."
msgstr "Pick by what the bone carries. Rigid Core: flesh with bone inside, like an arm. Lump: a breast or buttock with no bone inside, whose\nflesh moves out of the way as a whole. Accessory: a ribbon or necklace lying on the body, which moves with the flesh under it."

#. Key:	SoftbodyRigidBoneOverride:Shrink
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyRigidBoneOverride:Shrink [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyRigidBoneOverride:Shrink [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyRigidBoneOverride:Shrink"
msgid "How thick this bone is, as a fraction of the distance from the bone to the skin. Larger = thinner flesh here: it jiggles less and\nits dents are narrower."
msgstr "How thick this bone is, as a fraction of the distance from the bone to the skin. Larger = thinner flesh here: it jiggles less and\nits dents are narrower."

#. Key:	SoftbodySeparatedPair
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySeparatedPair [ScriptStruct ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySeparatedPair [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySeparatedPair"
msgid "Two sides to keep apart. Each side lists bones, and their child bones are included."
msgstr "Two sides to keep apart. Each side lists bones, and their child bones are included."

#. Key:	SoftbodySeparatedPair:SideA
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySeparatedPair:SideA [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySeparatedPair:SideA [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySeparatedPair:SideA"
msgid "The top bones of one side, such as the left breast. Rigs that split one breast into several bone chains need each chain's top bone."
msgstr "The top bones of one side, such as the left breast. Rigs that split one breast into several bone chains need each chain's top bone."

#. Key:	SoftbodySeparatedPair:SideB
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySeparatedPair:SideB [ArrayProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySeparatedPair:SideB [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySeparatedPair:SideB"
msgid "The top bones of the other side, such as the right breast."
msgstr "The top bones of the other side, such as the right breast."

#. Key:	SoftbodySimulationPreviewSettings
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySimulationPreviewSettings [Class ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySimulationPreviewSettings [Class ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySimulationPreviewSettings"
msgid "Preview tools of the Simulation tab: the animation, the pressing finger and the grab circle. They last until the window closes\nand are not saved."
msgstr "Preview tools of the Simulation tab: the animation, the pressing finger and the grab circle. They last until the window closes\nand are not saved."

#. Key:	SoftbodySimulationPreviewSettings:Animation
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:Animation [ObjectProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:Animation [ObjectProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySimulationPreviewSettings:Animation"
msgid "Plays on the skeletal mesh in a loop, so you can see the jiggle it makes. Only animations for this mesh's skeleton are listed."
msgstr "Plays on the skeletal mesh in a loop, so you can see the jiggle it makes. Only animations for this mesh's skeleton are listed."

#. Key:	SoftbodySimulationPreviewSettings:bSkeletal
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:bSkeletal [BoolProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:bSkeletal [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySimulationPreviewSettings:bSkeletal"
msgid "True when the simulated mesh is skeletal, which shows the Animation row."
msgstr "True when the simulated mesh is skeletal, which shows the Animation row."

#. Key:	SoftbodySimulationPreviewSettings:GrabRadius
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:GrabRadius [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:GrabRadius [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySimulationPreviewSettings:GrabRadius"
msgid "The radius of the skin patch that Ctrl + right drag holds. Ctrl + mouse wheel over the mesh, or [ and ], changes it.\nThe patch and any lump under it move at most 1.3 times the smaller of this radius and the flesh thickness, then stay there."
msgstr "The radius of the skin patch that Ctrl + right drag holds. Ctrl + mouse wheel over the mesh, or [ and ], changes it.\nThe patch and any lump under it move at most 1.3 times the smaller of this radius and the flesh thickness, then stay there."

#. Key:	SoftbodySimulationPreviewSettings:PressDepth
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:PressDepth [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:PressDepth [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySimulationPreviewSettings:PressDepth"
msgid "How deep the tip pushes into the surface under the cursor. It stops before the far side, and the mouse wheel changes it while you press."
msgstr "How deep the tip pushes into the surface under the cursor. It stops before the far side, and the mouse wheel changes it while you press."

#. Key:	SoftbodySimulationPreviewSettings:PressRadius
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:PressRadius [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:PressRadius [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySimulationPreviewSettings:PressRadius"
msgid "The radius of the round fingertip that Ctrl + left drag presses with."
msgstr "The radius of the round fingertip that Ctrl + left drag presses with."

#. Key:	SoftbodySimulationPreviewSettings:ShouldHideAnimation
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:ShouldHideAnimation [Function ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodySimulationPreviewSettings:ShouldHideAnimation [Function ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodySimulationPreviewSettings:ShouldHideAnimation"
msgid "Hides animations that do not match this mesh's skeleton from the Animation picker."
msgstr "Hides animations that do not match this mesh's skeleton from the Animation picker."

#. Key:	SoftbodyStaticRigidSphere
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyStaticRigidSphere [ScriptStruct ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyStaticRigidSphere [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyStaticRigidSphere"
msgid "A sphere in the mesh's own space (cm) that marks a part that never moves, like a bone inside the flesh."
msgstr "A sphere in the mesh's own space (cm) that marks a part that never moves, like a bone inside the flesh."

#. Key:	SoftbodyStaticRigidSphere:Center
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyStaticRigidSphere:Center [StructProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyStaticRigidSphere:Center [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyStaticRigidSphere:Center"
msgid "Center of the sphere, in the mesh's own space (cm, as in the static mesh editor)."
msgstr "Center of the sphere, in the mesh's own space (cm, as in the static mesh editor)."

#. Key:	SoftbodyStaticRigidSphere:Radius
#. SourceLocation:	/Script/SoftbodyEditor.SoftbodyStaticRigidSphere:Radius [FloatProperty ToolTip meta-data]
#: /Script/SoftbodyEditor.SoftbodyStaticRigidSphere:Radius [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,SoftbodyStaticRigidSphere:Radius"
msgid "Radius of the sphere (cm)."
msgstr "Radius of the sphere (cm)."

